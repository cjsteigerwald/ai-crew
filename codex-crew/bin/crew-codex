import os, re, subprocess, sys

self_pid = int(os.environ.get("REAP_SELF_PID", "0"))
# argv[0] of a real broker is node's process.execPath: `node` for every
# official build, nvm and Homebrew; `nodejs` on older Debian/Ubuntu packages;
# a version suffix (`node18`, `node-22`) on distros that ship several side by
# side. Nothing else — python3, bash, perl — can be the broker.
NODE_ARGV0 = re.compile(r"^node(js)?(-?[0-9]+(\.[0-9]+)*)?$")
# ⚠️ /proc is Linux-only. On darwin every open() below failed, every broker
# read as "vanished", and the sweep reported zero candidates — silently. /proc
# stays the primary source where it exists; elsewhere ppid comes from ps and
# argv from sysctl KERN_PROCARGS2, which is NUL-separated like /proc cmdline.
HAVE_PROC = os.path.isdir("/proc/self")


def ppid_of(pid):
    if not HAVE_PROC:
        try:
            out = subprocess.run(["ps", "-o", "ppid=", "-p", str(pid)],
                                 capture_output=True, text=True, timeout=10).stdout
            return int(out.strip())
        except Exception:
            return None
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("PPid:"):
                    return int(line.split()[1])
    except Exception:
        return None
    return None


def procargs_darwin(pid):
    # NOT `ps -o command=`: that is space-joined, the same lossy form as the
    # pgrep line, and a --cwd containing a space would be truncated into a path
    # that does not exist — a false candidate. KERN_PROCARGS2 is
    # [int32 argc][exec path\0][\0 padding][argv0\0 ... argvN\0][env...].
    import ctypes, ctypes.util, struct
    libc = ctypes.CDLL(ctypes.util.find_library("c"), use_errno=True)
    mib = (ctypes.c_int * 3)(1, 49, pid)  # CTL_KERN, KERN_PROCARGS2
    size = ctypes.c_size_t(0)
    if libc.sysctl(mib, 3, None, ctypes.byref(size), None, 0) != 0 or size.value < 4:
        return None
    buf = ctypes.create_string_buffer(size.value)
    if libc.sysctl(mib, 3, buf, ctypes.byref(size), None, 0) != 0:
        return None
    raw = buf.raw[:size.value]
    argc = struct.unpack_from("i", raw, 0)[0]
    rest = raw[4:]
    end = rest.find(b"\0")  # skip the exec path
    if end < 0:
        return None
    rest = rest[end:].lstrip(b"\0")
    # KERN_PROCARGS2 cannot tell the padding after the exec path from an empty
    # argv[0], so an empty argv[0] is lost here. Acceptable: it can only come
    # from a deliberate spoof, and the reaper prints advisory lines, never kills.
    parts = rest.split(b"\0")
    if argc <= 0 or len(parts) < argc:
        return None
    return parts[:argc]


# Our own ancestry is never a candidate. pgrep matched on the full command
# line, so the shell running this reap (and whatever spawned it) can match the
# pattern themselves; reporting an ancestor as reapable would invite a human to
# kill the sweep's own session.
ancestors = set()
walker = self_pid
while walker and walker > 1 and walker not in ancestors:
    ancestors.add(walker)
    walker = ppid_of(walker)


def cmdline(pid):
    # /proc/<pid>/cmdline is NUL-separated and authoritative. The pgrep line is
    # space-joined and cannot be re-split safely once a path contains a space.
    if not HAVE_PROC:
        try:
            raw_args = procargs_darwin(pid) if sys.platform == "darwin" else None
        except Exception:
            raw_args = None
        if not raw_args:
            return None
        return [a.decode("utf-8", "replace") for a in raw_args]
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
    except Exception:
        return None
    # ⚠️ Empty elements are argv, not noise: dropping them turned
    # ["node", "", script, "serve", …] into the accepted shape. Only the one
    # empty tail produced by the terminal NUL is removed.
    parts = raw.split(b"\0")
    if raw.endswith(b"\0"):
        parts = parts[:-1]
    return [a.decode("utf-8", "replace") for a in parts]


for arg in sys.argv[1:]:
    try:
        pid = int(arg)
    except ValueError:
        continue
    if pid <= 1 or pid in ancestors:
        print(f"SKIP\t{pid}\tthis reap or one of its ancestors")
        continue
    args = cmdline(pid)
    if not args:
        print(f"SKIP\t{pid}\tprocess vanished before inspection")
        continue
    # ⚠️ Identity first: pgrep matched a SUBSTRING of the joined command line,
    # so `bash app-server-broker-check.sh serve --cwd /gone` — and then
    # `python3 -c '…' app-server-broker.mjs serve --cwd /gone`, which carries
    # the script name as a mere positional argument — were handed out with a
    # paste-ready kill command. Only the vendor's EXACT invocation shape is ever
    # classified. codex 1.0.6 scripts/lib/broker-lifecycle.mjs spawns
    #   spawn(process.execPath, [scriptPath, "serve", "--endpoint", …])
    # so argv[0] is the node binary (no node flags precede the script), argv[1]
    # is the script, argv[2] is `serve`. Everything else is skipped, everywhere.
    # Positions are checked on the RAW argv with empty elements preserved, and
    # fullmatch, not match: `$` would let a basename ending in "\n" through.
    if not (len(args) >= 3 and NODE_ARGV0.fullmatch(os.path.basename(args[0]))
            and os.path.basename(args[1]) == "app-server-broker.mjs"
            and args[2] == "serve"):
        print(f"SKIP\t{pid}\tnot the codex broker script")
        continue
    cwd = None
    for i, a in enumerate(args):
        if a == "--cwd" and i + 1 < len(args):
            cwd = args[i + 1]
        elif a.startswith("--cwd="):
            cwd = a[len("--cwd="):]
    if not cwd:
        print(f"SKIP\t{pid}\tno --cwd argument")
        continue
    # ⚠️ NOT os.path.isdir(cwd). isdir returns False for permission-denied and
    # for an untraversable parent, which reported a workspace we merely cannot
    # SEE as one that is GONE — the fail-open that made the old kill unsafe.
    # lstat and classify: only a proven-absent cwd is a candidate, and a
    # symlinked workspace root is reported LIVE because lstat does not follow
    # it (the link itself still exists, so the workspace is not provably gone).
    try:
        os.lstat(cwd)
    except (FileNotFoundError, NotADirectoryError):
        print(f"REAP\t{pid}\t{cwd}")
    except OSError as exc:
        print(f"UNKNOWN\t{pid}\tcwd {cwd} is unreadable: {exc.__class__.__name__}")
    else:
        print(f"LIVE\t{pid}\t{cwd}")
