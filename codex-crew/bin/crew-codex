#!/usr/bin/env bash
# crew-codex — forward to the official codex plugin's companion runtime.
# Resolves the runtime through installed_plugins.json so version bumps of
# codex@openai-codex never break the crew agents.
set -euo pipefail

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
INSTALLED_JSON="$CLAUDE_DIR/plugins/installed_plugins.json"
CODEX_PLUGIN_ID="codex@openai-codex"
# Our own code, shipped beside this script — currently just the effort driver.
CREW_LIB_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/lib"

# ---- usage guards: a help request must never become a dispatch -------------
# codex-companion has NO per-subcommand help handler, and its review parser
# knows only --base/--scope/--model/--cwd (plus --json/--wait/--background);
# EVERY other argument becomes a positional and is joined into the review's
# focus text. So `crew-codex adversarial-review --help` used to run a FULL
# review against the default base `main` — ~10 minutes of wall clock, burned
# twice on 2026-08-22 — and `--effort high` was swallowed into the prompt
# while the turn still ran at whatever effort the codex config carried.
# Both are intercepted here, before the companion is even resolved: printing
# usage must not depend on the codex plugin being installed. `--effort` on
# `adversarial-review` is no longer an error — it is now a routing decision
# (see the effort-routing block further down) — but it is still parsed here so
# an invalid value is rejected before anything is dispatched.
crew_usage() {
  cat <<'USAGE'
crew-codex <subcommand> [args...]

Subcommands crew-codex handles itself:
  --resolve                     print the resolved codex-companion.mjs path
  await <job-id> [--for <s>]    block until the job leaves running — exit 0
                                completed, 1 failed/cancelled, 2 not found,
                                3 stale, 4 hung, 10 still running (call again)
  sanitize-archive [--dir <path>] [--dry-run]
                                re-run the archive scrubber over jobs archived
                                by an earlier crew-codex, which kept focus text
                                and prompt-derived summaries in the clear.
                                Rewrites in place only where the bytes differ;
                                deletes nothing; never touches .log files.
  reap [--dry-run] [--brokers] [--state]
                                mark stuck job records failed; --brokers and
                                --state are REPORT ONLY — they kill no process
                                and delete no directory, they print the command
                                for you to run. Exit: 0 the sweep classified
                                everything, 2 usage error, 3 the sweep was
                                INCOMPLETE (entries blocked, unresolved or
                                skipped — read the lines, do not treat as clean)
  --help | -h | help            this text

Everything else (task, review, adversarial-review, status, result, cancel,
setup, transfer) is forwarded verbatim to the codex plugin's companion
runtime — with ONE exception: `adversarial-review --effort <e>` runs on
crew-codex's own driver, because the companion cannot set reasoning effort on
a review. Run `crew-codex adversarial-review --help` for that path's flags.
USAGE
}

review_usage() {
  local sub="$1"
  cat <<USAGE
crew-codex $sub [flags] [focus text]

Flags codex-companion actually parses on the review path:
  --base <ref>                  diff base (default: main)
  --scope <auto|working-tree|branch>
  --model <model>               model override for this review
  --cwd <path>                  workspace root
  --json                        machine-readable output
  --wait | --background         run inline, or detach and return a job id
USAGE

  if [[ "$sub" == "adversarial-review" ]]; then
    cat <<USAGE
  [focus text]                  every remaining word becomes the review focus

Flag crew-codex adds on top of the companion:
  --effort <none|minimal|low|medium|high|xhigh>
                                per-dispatch reasoning effort. codex-companion
                                still does not parse this — crew-codex routes
                                the dispatch to its own driver
                                (lib/review-with-effort.mjs), which composes the
                                codex plugin's exported modules and threads the
                                effort into the turn the companion leaves null.
                                The driver also detaches properly under
                                --background and stamps effort + model into the
                                job record, which vendor review records lack.

Validator ceiling is xhigh — the registry's max/ultra tiers are refused here.
Practical FLOOR on the gpt-5.6 family (sol/terra/luna) is low: 5.6 models
return a 400 on reasoning.effort for 'none' and 'minimal', so those two are
accepted (other model families may take them) but warned about, and the job
fails at the API rather than in the wrapper.

WITHOUT --effort this is a verbatim codex-companion passthrough and the turn
runs at model_reasoning_effort from ${CODEX_HOME:-$HOME/.codex}/config.toml.
USAGE
  else
    cat <<USAGE
  [focus text]                  every remaining word becomes the review focus

The native review path accepts NO --effort flag. It runs through the
companion's built-in reviewer (runAppServerReview), a different code path that
crew-codex's effort driver does not model, and unknown arguments there are not
rejected — they are folded into the review request — so an --effort flag would
change the request and never the reasoning effort. Use
'crew-codex adversarial-review --effort <e>' for per-dispatch effort, or set
model_reasoning_effort in ${CODEX_HOME:-$HOME/.codex}/config.toml.
USAGE
  fi
}

task_usage() {
  cat <<USAGE
crew-codex task [flags] [prompt]

Flags codex-companion parses on the task path:
  --background                  detach and return a job id
  --write                       allow file writes (default: read-only)
  --resume-last | --resume | --fresh
  --model <model|spark>         model override
  --effort <none|minimal|low|medium|high|xhigh>
  --cwd <path>                  workspace root
  --prompt-file <path>          read the prompt from a file
  [prompt]                      every remaining word becomes the prompt

Unlike the native review path, task DOES accept --effort — codex-companion
parses it here itself. The other dispatch mode with per-job effort control is
'crew-codex adversarial-review --effort <e>', which crew-codex drives itself
because the companion cannot set effort on a review.
USAGE
}

if [[ $# -eq 0 || "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
  crew_usage
  exit 0
fi

# Set by the review guard below and read by the effort-routing block after the
# companion is resolved. Declared here because `set -u` is on and the guard
# only runs for the two review subcommands.
REVIEW_EFFORT=""
REVIEW_EFFORT_SEEN=0

if [[ "$1" == "review" || "$1" == "adversarial-review" ]]; then
  # EXACT matches only, and only for these two subcommands. Focus text is free
  # prose that may legitimately contain the word "help" or a --flag-shaped
  # token, and rejecting unknown flags wholesale would break dispatches the
  # companion accepts. Two passes so --help wins over the --effort error no
  # matter which comes first.
  #
  # ⚠️ SCOPE DIFFERS BY SPELLING, deliberately:
  #   --help  — scanned at EVERY position. Nobody passes a literal "--help"
  #             token as review focus prose.
  #   help/-h — accepted ONLY as the first argument after the subcommand.
  #             Focus text is passed as unquoted positionals that the companion
  #             joins, so scanning every position would make
  #             `adversarial-review improve the help wording` print usage and
  #             exit 0 WITHOUT dispatching — silently swallowing a real review
  #             and reporting success to the caller. Refusing to review is a
  #             worse failure than printing usage one position later.
  case "${2:-}" in
    -h|help) review_usage "$1"; exit 0 ;;
  esac
  # Stop at `--`: the vendor parser treats every token after the sentinel as
  # positional focus text, so `adversarial-review -- --help` is a review whose
  # literal focus is "--help". Scanning past it would intercept a valid dispatch.
  for arg in "$@"; do
    [[ "$arg" == "--" ]] && break
    case "$arg" in
      --help) review_usage "$1"; exit 0 ;;
    esac
  done
  # Collect --effort in BOTH spellings, last occurrence wins — the same rule
  # the companion's own parser applies, so what we validate and route on is
  # what would actually take effect.
  effort_pending=0
  for arg in "$@"; do
    # Same sentinel rule as the help scan: after `--` everything is focus text,
    # so `adversarial-review -- --effort high` must stay a no-effort vendor
    # dispatch whose focus is the literal string "--effort high". Routing it to
    # the driver would both break the byte-identical-passthrough guarantee and
    # fail, since the driver would find no parsed effort either.
    [[ "$arg" == "--" ]] && break
    if [[ $effort_pending -eq 1 ]]; then
      REVIEW_EFFORT="$arg"
      effort_pending=0
      continue
    fi
    case "$arg" in
      --effort) effort_pending=1; REVIEW_EFFORT_SEEN=1 ;;
      --effort=*) REVIEW_EFFORT="${arg#--effort=}"; REVIEW_EFFORT_SEEN=1 ;;
    esac
  done
  if [[ $effort_pending -eq 1 ]]; then
    echo "crew-codex: --effort was given without a value." >&2
    exit 2
  fi

  # The native reviewer is a DIFFERENT companion code path (runAppServerReview,
  # companion:1002) that takes a review target rather than a prompt+turn, so
  # crew-codex's effort driver does not model it. Refuse rather than pretend.
  if [[ $REVIEW_EFFORT_SEEN -eq 1 && "$1" == "review" ]]; then
    echo "crew-codex: review does not accept --effort. The native reviewer runs through codex-companion's runAppServerReview path, which takes no reasoning effort, and unknown arguments there are folded into the review request instead of rejected — so '--effort $REVIEW_EFFORT' would change the request and the turn would still run at the config's effort. Silently wrong, not an error." >&2
    echo "crew-codex: --effort IS supported on 'crew-codex adversarial-review --effort <e>' (crew-codex drives that turn itself). Otherwise set model_reasoning_effort in ${CODEX_HOME:-$HOME/.codex}/config.toml, or use 'crew-codex task --effort <e>'." >&2
    exit 2
  fi

  # Validated here, before the companion is resolved and long before anything
  # is dispatched, so a typo costs nothing. The driver re-validates against the
  # same list; this copy exists so `--effort bogus` never reaches node at all.
  # Ceiling is xhigh on purpose — the registry's max/ultra tiers are untested
  # through this path and the driver bypasses the vendor's own validator.
  if [[ $REVIEW_EFFORT_SEEN -eq 1 ]]; then
    case "$REVIEW_EFFORT" in
      none|minimal|low|medium|high|xhigh) ;;
      *)
        echo "crew-codex: invalid --effort '$REVIEW_EFFORT'. Valid values: none|minimal|low|medium|high|xhigh." >&2
        echo "crew-codex: xhigh is the ceiling through this plugin — the registry's max/ultra tiers are not accepted here." >&2
        exit 2
        ;;
    esac
  fi
fi

if [[ "$1" == "task" ]]; then
  # Same class of bug as the review path: codex-companion has no help handler
  # for `task` either, so `crew-codex task --help` dispatches a real Codex job
  # whose PROMPT is the literal string "--help". Cheaper than an accidental
  # review, but still a wasted job and a wasted rate window.
  #
  # Only --help/-h, NOT a bare `help`: a task's prompt is a positional, so
  # `crew-codex task help` is a plausible (if terse) real prompt in a way that
  # `review help` is not. Intercepting it would break a legitimate dispatch.
  for arg in "$@"; do
    case "$arg" in
      --help|-h) task_usage; exit 0 ;;
    esac
  done
fi

if ! command -v node >/dev/null 2>&1; then
  echo "crew-codex: node is required (the codex companion runtime is a Node script)" >&2
  exit 1
fi

if [[ ! -f "$INSTALLED_JSON" ]]; then
  echo "crew-codex: $INSTALLED_JSON not found — install the official Codex plugin first: /plugin install $CODEX_PLUGIN_ID" >&2
  exit 1
fi

if ! COMPANION_ROOT="$(node -e '
  const fs = require("fs");
  const data = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  const entries = (data.plugins || {})[process.argv[2]];
  if (!Array.isArray(entries) || entries.length === 0 || !entries[0].installPath) process.exit(2);
  process.stdout.write(entries[0].installPath);
' "$INSTALLED_JSON" "$CODEX_PLUGIN_ID")"; then
  echo "crew-codex: $CODEX_PLUGIN_ID is not installed — run: /plugin install $CODEX_PLUGIN_ID" >&2
  exit 1
fi

COMPANION="$COMPANION_ROOT/scripts/codex-companion.mjs"
if [[ ! -f "$COMPANION" ]]; then
  echo "crew-codex: companion script missing at $COMPANION — the codex plugin layout changed; update codex-crew's resolver" >&2
  exit 1
fi

# Job state must land in the codex plugin's data dir so /codex:status,
# /codex:result and its SessionEnd cleanup see crew-launched jobs too.
export CLAUDE_PLUGIN_DATA="${CLAUDE_PLUGIN_DATA:-$CLAUDE_DIR/plugins/data/codex-openai-codex}"

# Our own archive — the companion prunes at 50 jobs (deleting logs) and drops
# a session's jobs at SessionEnd, so results are copied somewhere it can't reap.
CREW_ARCHIVE_DIR="${CREW_CODEX_ARCHIVE_DIR:-$CLAUDE_DIR/plugins/data/codex-crew/jobs}"

# ---- the archive sanitizer, shared by `await` and `sanitize-archive` ------
# ONE copy on purpose. When this lived inline in the await path only, the
# migration sweep would have needed a second implementation, and the two
# would have drifted into disagreeing about what is safe to keep.
# Contract: reads a `result --json` payload on stdin; writes a sanitized
# $CREW_META_OUT; if $CREW_RESULT_OUT is set, sanitizes $CREW_RESULT_IN into
# it. Idempotent — re-running it over an already-clean archive is a no-op.
read -r -d '' CREW_SANITIZER_PY <<'CREW_SANITIZER_EOF' || true
import json, os, re, sys

JOB_ID = os.environ.get("CREW_META_JOB_ID", "")
# A TASK summary is shorten(prompt) — prompt text wearing a routing-looking
# name. A REVIEW summary is the model finding summary: output, not input, and
# worth keeping. The job-id prefix is the discriminator crew-codex already has.
DROP_SUMMARY = JOB_ID.startswith("task-")


def norm(key):
    return "".join(c for c in str(key).lower() if c.isalnum())


# Everything a REQUEST carries that is routing rather than content. This is an
# ALLOWLIST and it is the primary defence, because the denylist below cannot
# survive a vendor rename: input, userInput, reviewFocus or a free-text list all
# walk straight past it. Inside a request boundary the rule is inverted — a key
# nobody here recognizes is redacted, so a NEW vendor field fails CLOSED until
# somebody adds it deliberately.
ALLOWED_REQUEST_KEYS = {
    "cwd", "base", "model", "effort", "effortrequested",
    "efforteffective", "pluginroot", "pluginversion", "kind", "jobclass",
    "resumelast", "sandbox", "approval", "background", "json",
    "wait", "promptfile", "threadid", "turnid", "sessionid", "dispatchedby",
    "workspaceroot",
}
# Deliberately NOT allowlisted, though the vendor sends them: `scope` and
# `title`. Both are unconstrained strings whose contents this script cannot
# predict, and neither is worth an archive leak — the job id and kind already
# say what the job was.

# Subtrees that hold MODEL OUTPUT. That is the reason the archive exists, it is
# arbitrarily long by nature, and it is the one place the length guard below
# must not fire.
OUTPUT_KEYS = {"result", "rendered", "rawoutput", "stdout", "output", "codex",
               "progresspreview", "findings"}

# Defence in depth for the case the allowlist cannot see: a relocated free-text
# field OUTSIDE any request, under a name no rule here knows. Prompts, focus
# text and pasted logs are long; routing metadata is not. A metadata string
# past this bound is not something this script can vouch for, so it goes.
MAX_METADATA_CHARS = 512


def is_free_text(key):
    k = norm(key)
    if k.endswith("prompt") or k.endswith("prompttext"):
        return True
    if k.endswith("focustext") or k == "focus":
        return True
    if k.endswith("instructions"):
        return True
    return DROP_SUMMARY and k == "summary"


# ⚠️ ANCHORED, and it must stay anchored. A prefix test here is a REDACTION
# BYPASS: prompt and focus text are user-controlled, so a prompt that merely
# BEGINS with "<redacted" would be mistaken for a marker this script had
# already written and archived verbatim. Only the exact canonical forms below
# — the complete set marker() itself emits — count as already-sanitized. A
# value that is genuinely one of those strings carries no content to lose.
MARKER_RE = re.compile(r"^<redacted(: \d+ (chars|item\(s\)|key\(s\)))?>$")


def marker(value):
    # Shape only, never content — the same contract the .dispatch.json argv
    # redaction uses, so the two sidecars cannot disagree about what is safe.
    if value is None:
        return None
    if isinstance(value, str) and MARKER_RE.match(value):
        # Already a marker. Re-markering would rewrite the recorded length to
        # the length of the marker itself, so re-running this over an archive
        # that has already been sanitized has to be a no-op.
        return value
    if isinstance(value, str):
        return "<redacted: %d chars>" % len(value)
    if isinstance(value, list):
        return "<redacted: %d item(s)>" % len(value)
    if isinstance(value, dict):
        return "<redacted: %d key(s)>" % len(value)
    return "<redacted>"


def allow_request(value):
    # A request that is not a mapping is not a shape this can reason about, so
    # it goes whole. Allowed values still recurse through scrub(), which
    # reapplies this boundary, the denylist and the length guard to anything
    # nested inside them — an allowlisted NAME does not mean unbounded content.
    if not isinstance(value, dict):
        return marker(value)
    return dict((k, scrub(v) if norm(k) in ALLOWED_REQUEST_KEYS else marker(v))
                for k, v in value.items())


def scrub(value, in_output=False):
    if isinstance(value, dict):
        out = {}
        for k, v in value.items():
            nk = norm(k)
            if nk == "request":
                # Anywhere the key appears, NOT just storedJob.request: a real
                # archived payload carries the same request under BOTH
                # job.request and storedJob.request, so a path rule anchored on
                # one of them leaves the other fully readable.
                out[k] = allow_request(v)
            elif is_free_text(k):
                out[k] = marker(v)
            else:
                out[k] = scrub(v, in_output or nk in OUTPUT_KEYS)
        return out
    if isinstance(value, list):
        return [scrub(v, in_output) for v in value]
    if isinstance(value, str) and not in_output and len(value) > MAX_METADATA_CHARS:
        return marker(value)
    return value


raw = sys.stdin.read()
try:
    payload = json.loads(raw)
except ValueError:
    payload = None
if payload is None:
    record = {
        "jobId": JOB_ID,
        "crewArchive": "withheld",
        "reason": "companion result --json was empty or unparseable; the raw payload is NOT archived because it can carry unredacted prompt text",
    }
else:
    record = scrub(payload)
def write_atomic(path, text):
    tmp_path = path + ".tmp"
    with open(tmp_path, "w", encoding="utf-8") as handle:
        handle.write(text)
    os.replace(tmp_path, path)


out = os.environ["CREW_META_OUT"]
tmp = out + ".tmp"
with open(tmp, "w", encoding="utf-8") as handle:
    json.dump(record, handle, indent=2)
os.replace(tmp, out)

# ---- .result.txt: the SAME leak, in the file nobody was looking at ----------
# renderStoredJobResult falls back to printing "Summary: <job.summary>" when a
# job stored no output at all (render.mjs:390), and a TASK summary is
# shorten(prompt, 96) (companion:552). So a cancelled or failed task archived
# the first 96 characters of its prompt in plain text, directly beside the
# .meta.json this script had just carefully cleaned of exactly that string.
# A REVIEW summary is the model finding summary — output, not input — and
# survives, the same discriminator DROP_SUMMARY already uses above.
result_in = os.environ.get("CREW_RESULT_IN", "")
result_out = os.environ.get("CREW_RESULT_OUT", "")
if result_out:
    try:
        with open(result_in, "r", encoding="utf-8", errors="replace") as handle:
            text = handle.read()
    except OSError:
        text = None
    if text is None:
        write_atomic(result_out, "crew-codex: result withheld — the rendered result could not be read for sanitization.\n")
    else:
        if DROP_SUMMARY:
            # Exact substring first. It holds whichever branch emitted the
            # summary, so a vendor moving the field does not reopen this, and
            # it cannot over-redact model output that merely happens to begin a
            # line with "Summary: ".
            for holder in ("job", "storedJob"):
                node = (payload or {}).get(holder)
                if isinstance(node, dict):
                    summary = node.get("summary")
                    if isinstance(summary, str) and summary.strip():
                        text = text.replace(summary, "<redacted: %d chars>" % len(summary))
            # Skeleton rule, for the case the payload was unparseable and the
            # exact string is therefore unknowable. Scoped to the vendor
            # fallback render so a model answer is never touched.
            lines = text.split("\n")
            if (len(lines) >= 4 and lines[0].startswith("# ") and lines[1] == ""
                    and lines[2].startswith("Job: ") and lines[3].startswith("Status: ")):
                for i, line in enumerate(lines):
                    if line.startswith("Summary: "):
                        lines[i] = "Summary: <redacted: %d chars>" % len(line[9:])
                text = "\n".join(lines)
        write_atomic(result_out, text)
CREW_SANITIZER_EOF

if [[ "${1:-}" == "--resolve" ]]; then
  echo "$COMPANION"
  exit 0
fi

# ---- await: poll a detached job toward terminal state, token-free ----------
# Claude Code's Bash tool caps a single call at 600s, but codex jobs run for
# hours. Each await call blocks up to --for seconds (default 540, safely under
# that cap) and prints exactly ONE line; the caller loops until it stops
# reporting RUNNING. Polling happens in-shell, so a multi-hour job costs no
# model tokens while it runs. Exit: 0 completed, 1 failed/cancelled,
# 2 job not found, 3 stale (process died silently), 4 hung (process alive but
# the job log has not moved for CREW_CODEX_HUNG_SECS — a lost model turn),
# 10 still running (call again).
if [[ "${1:-}" == "await" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: await needs a job id — usage: crew-codex await <job-id> [--for <seconds>]" >&2
    exit 2
  fi
  shift

  FOR_SECS=540
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --for) FOR_SECS="${2:-540}"; shift 2 ;;
      *) shift ;;
    esac
  done
  POLL_SECS="${CREW_CODEX_POLL_SECS:-5}"
  # A live pid whose job log stops moving is a hung model turn, not progress
  # (observed 2026-08-06: app-server lost the thread mid-turn — "thread not
  # found" on cancel — while the pid idled forever, log frozen 27 min). BUT
  # legitimate xhigh turns go silent for minutes mid-reasoning (>=188s observed
  # in a healthy run), so the threshold must sit far above normal silence:
  # 900s catches the real wedge in 15 min with ~5x margin over observed
  # legitimate gaps. Callers should treat exit 4 as grounds for ONE more await
  # before any destructive recovery.
  HUNG_SECS="${CREW_CODEX_HUNG_SECS:-900}"
  HUNG_POLL_SECS="${CREW_CODEX_HUNG_POLL_SECS:-30}"

  deadline=$(( $(date +%s) + FOR_SECS ))
  missing_streak=0
  stale_streak=0

  while :; do
    snap="$(node "$COMPANION" status "$JOB_ID" --json 2>/dev/null || true)"
    parsed="$(printf '%s' "$snap" | python3 -c '
import json, sys
try:
    j = json.load(sys.stdin)["job"]
except Exception:
    print("MISSING\t-\t-\t-\t-")
    raise SystemExit
p = j.get("progressPreview") or []
last = str(p[-1]) if p else "-"
print("\t".join([
    str(j.get("status", "?")),
    str(j.get("elapsed", "?")),
    str(j.get("logFile", "-")),
    last.replace("\t", " ")[:80],
    str(j.get("pid") or "-"),
]))
' 2>/dev/null || printf 'MISSING\t-\t-\t-\t-')"
    IFS=$'\t' read -r jstatus jelapsed jlog jlast jpid <<<"$parsed"

    case "$jstatus" in
      queued|running)
        missing_streak=0
        ;;
      completed|failed|cancelled)
        mkdir -p "$CREW_ARCHIVE_DIR"
        # The rendered text is staged PRIVATE and sanitized below, never written
        # straight to .result.txt: the vendor fallback render prints
        # "Summary: <job.summary>", and a task summary is shorten(prompt, 96)
        # (companion:552) — the exact text .meta.json is carefully cleaned of.
        # ⚠️ Staged OUTSIDE the archive, and trapped. Inside the archive it was
        # unsanitized prompt text sitting in the one directory built to OUTLIVE
        # the vendor cleanup, and a SIGTERM in the window between render and
        # sanitize left it there for good — the archive sweep does not read it,
        # so nothing would ever have found it again.
        CREW_RAW_RESULT="$(umask 077; mktemp "${TMPDIR:-/tmp}/crew-codex-result.XXXXXX")" || CREW_RAW_RESULT=""
        trap 'rm -f "$CREW_RAW_RESULT"' EXIT HUP INT TERM
        if [[ -n "$CREW_RAW_RESULT" ]]; then
          node "$COMPANION" result "$JOB_ID" >"$CREW_RAW_RESULT" 2>/dev/null || true
        fi
        # ---- .meta.json sanitization: a DURABLE prompt leak, not a nicety --
        # `result --json` hands back the companion's storedJob verbatim, and a
        # stored job carries its REQUEST: a background task keeps the prompt in
        # storedJob.request.prompt, a background effort review keeps the focus
        # text in storedJob.request.focusText, and a task's summary is the first
        # 96 characters of the prompt (companion:552, `shorten(prompt)`). So the
        # unsanitized meta sat directly beside a carefully redacted
        # .dispatch.json holding the original incident text, credentials,
        # hostnames and paths — in an archive that exists precisely to OUTLIVE
        # the vendor session cleanup. Redacting the sidecar and not this file
        # redacts nothing.
        # Stripped BY KEY SHAPE and RECURSIVELY, wherever the key appears: a
        # path rule ("request.prompt") fails open the moment the vendor moves or
        # renames that payload in a version bump, and it would fail open
        # silently. Result, thread, status, timing and routing fields survive —
        # they are the reason this archive exists at all.
        # ⚠️ Best-effort by construction: an archiving failure must never change
        # await's exit code or its single stdout line, so the whole pipeline is
        # swallowed. An unparseable payload is WITHHELD rather than written raw:
        # "we could not sanitize it" must not become "so we archived it intact".
        {
          node "$COMPANION" result "$JOB_ID" --json 2>/dev/null \
            | CREW_META_OUT="$CREW_ARCHIVE_DIR/$JOB_ID.meta.json" \
              CREW_RESULT_IN="$CREW_RAW_RESULT" \
              CREW_RESULT_OUT="$CREW_ARCHIVE_DIR/$JOB_ID.result.txt" \
              CREW_META_JOB_ID="$JOB_ID" python3 -c "$CREW_SANITIZER_PY"
        } >/dev/null 2>&1 && CREW_SANITIZED_OK=1 || CREW_SANITIZED_OK=0
        rm -f "$CREW_RAW_RESULT" 2>/dev/null || true
        trap - EXIT HUP INT TERM
        # Fail CLOSED, the same contract .meta.json already has. UNCONDITIONAL
        # on sanitizer failure, not "only if the file is missing": a previous
        # await of this same job may have archived an UNSANITIZED result, and
        # leaving that in place because a file happens to exist is precisely
        # the stale leak this is meant to prevent.
        if [[ "$CREW_SANITIZED_OK" -ne 1 ]]; then
          printf '%s\n' "crew-codex: result withheld — the archive sanitizer did not complete, and the raw render can carry prompt text." \
            >"$CREW_ARCHIVE_DIR/$JOB_ID.result.txt" 2>/dev/null || true
        fi
        if [[ -f "$jlog" ]]; then
          cp -f "$jlog" "$CREW_ARCHIVE_DIR/$JOB_ID.log" 2>/dev/null || true
        fi
        echo "DONE $jstatus | ${jelapsed} | archived: $CREW_ARCHIVE_DIR/$JOB_ID.result.txt"
        if [[ "$jstatus" == "completed" ]]; then exit 0; fi
        exit 1
        ;;
      *)
        # Tolerate a couple of transient unreadable snapshots (state.json is
        # rewritten in place) before declaring the job genuinely gone.
        missing_streak=$(( missing_streak + 1 ))
        if [[ $missing_streak -ge 3 ]]; then
          echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)" >&2
          exit 2
        fi
        ;;
    esac

    remaining=$(( deadline - $(date +%s) ))
    if [[ $remaining -le 0 ]]; then
      echo "RUNNING | ${jelapsed} | last: ${jlast}"
      exit 10
    fi

    # Prefer waiting on the job's own process: tail --pid blocks in the kernel
    # and wakes the instant it exits (verified: state.json is already terminal
    # by then). Wait in bounded slices rather than to the deadline so an
    # alive-but-wedged runtime gets caught by the frozen-log check below.
    # Falls back to polling when the pid is absent or already gone.
    if [[ "$jpid" =~ ^[0-9]+$ ]] && kill -0 "$jpid" 2>/dev/null; then
      stale_streak=0
      slice=$(( remaining < HUNG_POLL_SECS ? remaining : HUNG_POLL_SECS ))
      timeout "$slice" tail --pid="$jpid" -f /dev/null 2>/dev/null || true
      if [[ -n "$jlog" && "$jlog" != "-" && -f "$jlog" ]]; then
        log_age=$(( $(date +%s) - $(stat -c %Y "$jlog" 2>/dev/null || date +%s) ))
        if [[ $log_age -ge $HUNG_SECS ]]; then
          echo "HUNG $JOB_ID | ${jelapsed} | pid $jpid alive but log frozen ${log_age}s (>=${HUNG_SECS}s) — likely a lost model turn; cancel the job, kill leftover app-server/broker processes, then re-dispatch on a fresh runtime" >&2
          exit 4
        fi
      fi
    else
      if [[ "$jpid" =~ ^[0-9]+$ ]]; then
        # Process is gone but the job never reached a terminal status — this is
        # the signature of a silent death, so say so instead of waiting it out.
        stale_streak=$(( stale_streak + 1 ))
        if [[ $stale_streak -ge 3 ]]; then
          echo "STALE $JOB_ID | ${jelapsed} | process $jpid is gone but status is still '$jstatus' — the job died without reporting; resume it or re-dispatch" >&2
          exit 3
        fi
      fi
      sleep "$POLL_SECS"
    fi
  done
fi

# ---- reap: sweep ALL state dirs for jobs stuck in running/queued -----------
# ⚠️ NOTHING in `reap` kills a process or deletes a socket dir any more. The
# process-tree kill and the /tmp/cxc-* removal that used to live here are gone
# on purpose — see the long note above the --brokers block. Do not reintroduce
# them, and never add a pattern-based (`pkill -f`) or wildcard sweep: this
# machine runs SEVERAL Claude Code sessions at once and every one of them owns
# brokers, socket dirs and state dirs in the same shared namespaces.
# The companion never marks a job failed when its runtime dies or wedges, so
# "running" entries accumulate forever (6 found on 2026-08-06, oldest from
# Jul 22). Reap marks a stuck job failed in place when its pid is dead, or —
# for a live/unknown pid — when its log has not moved for
# CREW_CODEX_REAP_LOG_AGE seconds (default 3600). --dry-run reports only.
# Direct state mutation is safe here precisely because the runtime that owned
# the file is gone or wedged; live healthy jobs are never touched, and a
# workspace containing ANY live-pid job is skipped entirely (a live companion
# session may rewrite that workspace's state.json at any moment).
# BOTH records are updated per job: jobs/<id>.json AND the workspace's
# state.json — the companion builds status/result/cancel from state.json, so
# updating only the per-job file leaves a split brain that keeps lying.
# ⚠️ CONCURRENCY, not theory: $CLAUDE_PLUGIN_DATA/state is shared by every
# Claude Code session running on this machine, so a workspace we are about to
# rewrite may belong to a DIFFERENT session's live companion. That is why a
# workspace holding any live-pid job is skipped whole, and why a workspace
# whose records cannot be read is skipped too — an unreadable record is not an
# absent one, and mutating around it would corrupt another session's registry.
# Two further sweeps are OPT-IN: --state deletes job history (irreversible),
# and --brokers is report-only but noisy. Neither runs unless named, and the
# default output stays byte-identical without them.
# ---- sanitize-archive: the SAME scrubber, applied to what is already on disk -
# The .meta.json / .result.txt sanitization above only helps jobs archived from
# now on. Every job archived by an earlier crew-codex is still sitting in the
# archive with its focus text and its prompt-derived summary in the clear, and
# that archive exists precisely to OUTLIVE the vendor session cleanup — so it is
# the copy that lasts. This sweep runs the identical $CREW_SANITIZER_PY over
# those files, which is why the sanitizer is a shared variable and not two
# implementations that could disagree about what is safe to keep.
# It never deletes and never touches .log files; it rewrites in place only when
# the sanitized bytes differ, and --dry-run rewrites nothing at all.
if [[ "${1:-}" == "sanitize-archive" ]]; then
  shift
  SA_DIR="$CREW_ARCHIVE_DIR"
  SA_DRY=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) SA_DRY=1 ;;
      --dir)
        shift
        SA_DIR="${1:-}"
        if [[ -z "$SA_DIR" ]]; then
          echo "crew-codex: sanitize-archive: --dir needs a path" >&2
          exit 2
        fi
        ;;
      *)
        echo "crew-codex: sanitize-archive: unknown flag '$1' — usage: crew-codex sanitize-archive [--dir <path>] [--dry-run]" >&2
        exit 2
        ;;
    esac
    shift
  done

  if [[ ! -d "$SA_DIR" ]]; then
    echo "sanitize-archive: no archive directory at $SA_DIR — nothing to do"
    exit 0
  fi

  SA_TMP="$(mktemp -d)"
  sa_total=0; sa_changed=0; sa_failed=0
  shopt -s nullglob

  # Stale staging files from the pre-trap await path: unsanitized renders that
  # nothing else will ever look at. They carry prompt text and no value, so
  # this is the one thing the sweep removes outright.
  for sa_raw in "$SA_DIR"/.*.result.raw; do
    if rm -f "$sa_raw"; then
      echo "removed stale unsanitized staging file: $(basename "$sa_raw")"
    else
      echo "failed: $(basename "$sa_raw") — could not remove stale staging file"
      sa_failed=$((sa_failed + 1))
    fi
  done

  # The UNION of both artifact kinds, not just the metas. await wrote
  # .result.txt before running the best-effort meta sanitizer, so an
  # interruption in that window leaves a prompt-bearing result with NO meta
  # beside it — and a meta-driven loop never looks at it, never counts it and
  # exits 0 reporting the archive clean.
  sa_ids=""
  for sa_f in "$SA_DIR"/*.meta.json; do
    sa_ids+="$(basename "$sa_f" .meta.json)"$'\n'
  done
  for sa_f in "$SA_DIR"/*.result.txt; do
    sa_ids+="$(basename "$sa_f" .result.txt)"$'\n'
  done
  sa_ids="$(printf '%s' "$sa_ids" | sort -u)"

  [[ -n "$sa_ids" ]] && while IFS= read -r sa_id; do
    [[ -n "$sa_id" ]] || continue
    sa_total=$((sa_total + 1))
    sa_meta="$SA_DIR/$sa_id.meta.json"
    sa_res="$SA_DIR/$sa_id.result.txt"

    # A symlink in the archive is not an archived job. cp/mv through one writes
    # to wherever it points, so --dir at a crafted directory could rewrite
    # files outside the archive entirely.
    if [[ -L "$sa_meta" || -L "$sa_res" ]]; then
      echo "failed: $sa_id — symlinked archive entry, refusing to write through it"
      sa_failed=$((sa_failed + 1))
      continue
    fi

    sa_have_meta=0; [[ -f "$sa_meta" ]] && sa_have_meta=1
    sa_have_res=0;  [[ -f "$sa_res"  ]] && sa_have_res=1

    # Snapshot both inputs. Everything downstream is computed from the snapshot
    # and re-checked against it before committing, so a concurrent await that
    # rewrites the live file mid-sweep is detected instead of clobbered.
    sa_snap_meta="$SA_TMP/$sa_id.snap.meta"
    sa_snap_res="$SA_TMP/$sa_id.snap.res"
    if [[ "$sa_have_meta" -eq 1 ]] && ! cp "$sa_meta" "$sa_snap_meta" 2>/dev/null; then
      echo "failed: $sa_id.meta.json — unreadable, left untouched"
      sa_failed=$((sa_failed + 1)); continue
    fi
    if [[ "$sa_have_res" -eq 1 ]] && ! cp "$sa_res" "$sa_snap_res" 2>/dev/null; then
      echo "failed: $sa_id.result.txt — unreadable, left untouched"
      sa_failed=$((sa_failed + 1)); continue
    fi

    sa_out_meta="$SA_TMP/$sa_id.out.meta"
    sa_out_res=""
    sa_in_res=""
    if [[ "$sa_have_res" -eq 1 ]]; then
      sa_in_res="$sa_snap_res"
      sa_out_res="$SA_TMP/$sa_id.out.res"
    fi
    # A result with no meta has no payload to read, so the sanitizer is fed
    # `null` — the same path an unparseable payload takes, which is exactly
    # what leaves the skeleton rule as the only lever. That is the honest
    # answer here: the summary string is unrecoverable once the meta is gone.
    sa_stdin="$sa_snap_meta"
    if [[ "$sa_have_meta" -eq 0 ]]; then
      sa_stdin="$SA_TMP/$sa_id.null.json"
      printf 'null' > "$sa_stdin"
    fi

    if ! CREW_META_OUT="$sa_out_meta" CREW_META_JOB_ID="$sa_id" \
         CREW_RESULT_IN="$sa_in_res" CREW_RESULT_OUT="$sa_out_res" \
         python3 -c "$CREW_SANITIZER_PY" <"$sa_stdin" 2>/dev/null; then
      echo "failed: $sa_id — sanitizer error, original left untouched"
      sa_failed=$((sa_failed + 1))
      continue
    fi

    sa_diff=0
    if [[ "$sa_have_meta" -eq 1 ]]; then
      cmp -s "$sa_snap_meta" "$sa_out_meta" || sa_diff=1
    fi
    if [[ -n "$sa_out_res" && -f "$sa_out_res" ]]; then
      cmp -s "$sa_snap_res" "$sa_out_res" || sa_diff=1
    fi
    if [[ "$sa_diff" -eq 0 ]]; then
      continue
    fi
    sa_changed=$((sa_changed + 1))
    if [[ "$SA_DRY" -eq 1 ]]; then
      echo "would sanitize: $sa_id"
      continue
    fi

    # Re-check identity before committing: if the live file no longer matches
    # the snapshot this output was computed from, another session rewrote it
    # while the sweep ran, and writing now would truncate their newer archive.
    if [[ "$sa_have_meta" -eq 1 ]] && ! cmp -s "$sa_meta" "$sa_snap_meta"; then
      echo "skipped: $sa_id — the archive changed while this sweep ran, not overwriting"
      sa_failed=$((sa_failed + 1)); continue
    fi
    if [[ "$sa_have_res" -eq 1 ]] && ! cmp -s "$sa_res" "$sa_snap_res"; then
      echo "skipped: $sa_id — the archive changed while this sweep ran, not overwriting"
      sa_failed=$((sa_failed + 1)); continue
    fi

    # Publish through a same-directory temp and rename: an interrupted cp -f
    # leaves a half-written archive, and rename(2) within one directory does
    # not.
    sa_commit() {
      local src="$1" dst="$2" label="$3" stage
      stage="$dst.satmp.$$"
      if cp "$src" "$stage" 2>/dev/null && mv -f "$stage" "$dst" 2>/dev/null; then
        echo "sanitized: $label"
        return 0
      fi
      rm -f "$stage" 2>/dev/null || true
      echo "failed: $label — could not rewrite"
      return 1
    }
    if [[ "$sa_have_meta" -eq 1 ]]; then
      sa_commit "$sa_out_meta" "$sa_meta" "$sa_id.meta.json" || sa_failed=$((sa_failed + 1))
    fi
    if [[ -n "$sa_out_res" && -f "$sa_out_res" ]]; then
      sa_commit "$sa_out_res" "$sa_res" "$sa_id.result.txt" || sa_failed=$((sa_failed + 1))
    fi
  done <<< "$sa_ids"
  rm -rf "$SA_TMP"
  sa_verb="rewritten"
  [[ "$SA_DRY" -eq 1 ]] && sa_verb="would be rewritten"
  echo "sanitize-archive summary: $sa_total archived job(s) inspected, $sa_changed $sa_verb, $sa_failed failed"
  echo "note: .log files are copied verbatim by await and are NOT sanitized by this sweep."
  echo "note: a result with no meta beside it can only be cleaned by the skeleton rule — its exact summary string is unrecoverable."
  if [[ "$sa_failed" -gt 0 ]]; then exit 1; fi
  exit 0
fi

if [[ "${1:-}" == "reap" ]]; then
  shift
  DRY=0
  SWEEP_BROKERS=0
  SWEEP_STATE=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY=1 ;;
      --brokers) SWEEP_BROKERS=1 ;;
      --state)   SWEEP_STATE=1 ;;
      *)
        # Loud, never ignored: reap's default mode MUTATES job records and
        # --state DELETES them, so a typo'd `--dryrun` quietly doing the real
        # thing is precisely the accident this rejection prevents.
        echo "crew-codex: reap: unknown flag '$1' — usage: crew-codex reap [--dry-run] [--brokers] [--state]" >&2
        exit 2
        ;;
    esac
    shift
  done

  # ---- exit code: a blocked sweep must not report success -------------------
  # Every sweep used to end in `exit 0`, so a caller could not tell a sweep that
  # classified everything from one that skipped an unreadable record, a
  # malformed registry or a live-pid workspace — the exact entries a human still
  # has to deal with. Automation reading the exit code was therefore told
  # "clean" by a sweep that had walked past the interesting half of its input.
  #   0 = every entry was classified
  #   2 = usage error (unknown flag), rejected before anything ran
  #   3 = the sweep ran but at least one entry was blocked/unresolved/skipped
  #   1 = reap itself failed (an unhandled error inside a sweep)
  # --brokers is deliberately NOT part of this: it discovers processes, it does
  # not sweep registry entries, and its "unknown" classification is its normal
  # reportable output rather than work left undone.
  REAP_EXIT=0
  reap_record_exit() {
    # Severity, not recency: 1 (reap broke) outranks 3 (sweep incomplete).
    local rc="$1"
    [[ "$rc" -eq 0 ]] && return 0
    if [[ "$REAP_EXIT" -eq 0 || "$rc" -lt "$REAP_EXIT" ]]; then REAP_EXIT="$rc"; fi
    return 0
  }

  rc=0
  REAP_LOG_AGE="${CREW_CODEX_REAP_LOG_AGE:-3600}" \
  REAP_DRY="$DRY" \
  python3 - "$CLAUDE_PLUGIN_DATA/state" <<'PY' || rc=$?
import datetime, json, os, sys, time
root = sys.argv[1]
max_age = int(os.environ.get("REAP_LOG_AGE", "3600"))
dry = os.environ.get("REAP_DRY") == "1"
now = time.time()
reaped = kept = skipped = 0
# The pessimistic reading of a registry entry, shared with the --state sweep:
# anything NOT in this set is treated as a live job, including a status this
# sweep has never heard of.
TERMINAL = {"completed", "failed", "cancelled", "gone"}

def pid_alive(pid):
    if not isinstance(pid, int):
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True

def stuck_reason(job):
    """None if the job looks healthy; else a short reason string."""
    pid = job.get("pid")
    log = job.get("logFile")
    log_age = None
    if log:
        try:
            log_age = now - os.stat(log).st_mtime
        except (FileNotFoundError, NotADirectoryError):
            log_age = None      # genuinely no log file — fall through to age
        except OSError:
            # We cannot see the log, so we cannot claim it is frozen. Report
            # healthy: the cost is one un-reaped record, and the alternative is
            # marking another session's live job failed on no evidence.
            return None
    if isinstance(pid, int) and not pid_alive(pid):
        return "process dead"
    if log_age is not None and log_age >= max_age:
        return f"log frozen {int(log_age)}s"
    if log_age is None:
        try:
            created = datetime.datetime.fromisoformat(
                job.get("createdAt", "").replace("Z", "+00:00"))
            if (now - created.timestamp()) >= max_age:
                return "no activity since creation"
        except Exception:
            pass
    return None

stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
# ⚠️ Attempt the operation, classify the exception — NEVER guard with
# os.path.isdir/isfile/exists. All three return False for permission-denied,
# for a dangling symlink and for an untraversable parent, which makes
# "unreadable" indistinguishable from "absent". Absent is safe; unreadable is
# not, because the state root is shared with every other Claude Code session on
# this machine. FileNotFoundError/NotADirectoryError mean absent; every other
# OSError means "we cannot see it" and stops us touching that workspace.
try:
    state_dirs = sorted(os.listdir(root))
except (FileNotFoundError, NotADirectoryError):
    print(f"reap: no state dir at {root}")
    raise SystemExit(0)
except OSError as exc:
    # Not a clean sweep: nothing was swept and we cannot say what is in there.
    print(f"reap: cannot list {root} ({exc.__class__.__name__}) — nothing swept")
    raise SystemExit(3)
for state_dir in state_dirs:
    ws = os.path.join(root, state_dir)
    jobs_dir = os.path.join(ws, "jobs")
    try:
        job_names = sorted(os.listdir(jobs_dir))
    except (FileNotFoundError, NotADirectoryError):
        # NO `continue` here: state.json below is the AUTHORITATIVE registry —
        # the companion serves status/result/cancel from it — and a workspace
        # can carry a live job there with no per-job file (partial cleanup, or
        # a record written before jobs/ existed). Skipping such a workspace is
        # exactly how a state.json-only running job walked past this sweep
        # while it still reported exit 0. --brokers' survey already refuses to.
        job_names = []
    except OSError as exc:
        # Pre-existing bug, found by a permission-denied test: an unreadable
        # jobs dir raised PermissionError out of the sweep and killed plain
        # `reap` outright. Skip it loudly instead — and skip it whole, because
        # an unreadable record may be another session's live job.
        print(f"skipped: {state_dir}/jobs unreadable ({exc.__class__.__name__}) — not touching this workspace")
        skipped += 1
        continue
    jobs = {}
    unreadable = []
    for name in job_names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(jobs_dir, name)
        try:
            with open(path) as f:
                record = json.load(f)
        except (FileNotFoundError, NotADirectoryError):
            continue                     # vanished between listdir and open
        except (OSError, ValueError) as exc:
            unreadable.append(f"{name}({exc.__class__.__name__})")
            continue
        if not isinstance(record, dict):
            unreadable.append(f"{name}(not a job object)")
            continue
        jobs[path] = record
    if unreadable:
        # A record we cannot read is NOT a record that says "terminal". Another
        # session's companion may be mid-write in this very workspace.
        print(f"skipped: {state_dir} — unreadable job record(s) {unreadable}, not touching this workspace")
        skipped += 1
        continue
    stuck = {p: j for p, j in jobs.items()
             if j.get("status") in ("running", "queued")}
    stuck_ids = {j.get("id") for j in stuck.values()}
    # Read the workspace registry BEFORE any classification, for EVERY
    # workspace — including ones with no jobs/ dir at all. The companion serves
    # status/result/cancel from state.json, so (a) a jobs/*.json rewrite we
    # cannot mirror leaves a split brain that keeps lying, and (b) a job
    # recorded ONLY there is a job this sweep must not walk past. An unreadable
    # or unrecognized registry is exactly the case where another session may
    # own this workspace. Absent is fine (nothing to mirror into, nothing to
    # reconcile); anything else skips the workspace whole, dry and real alike.
    state_path = os.path.join(ws, "state.json")
    state = None
    state_entries = []
    try:
        with open(state_path) as f:
            state = json.load(f)
    except (FileNotFoundError, NotADirectoryError):
        state = None
    except (OSError, ValueError) as exc:
        print(f"skipped: {state_dir} — state.json unreadable ({exc.__class__.__name__}), not touching this workspace")
        skipped += 1
        continue
    else:
        # Only two shapes are understood: a bare list, or {"jobs": [...]}. An
        # empty object is genuinely empty. Anything else we cannot mirror into.
        if isinstance(state, list):
            state_entries = state
        elif isinstance(state, dict) and isinstance(state.get("jobs"), list):
            state_entries = state["jobs"]
        elif isinstance(state, dict) and not state:
            state_entries = []
        else:
            print(f"skipped: {state_dir} — state.json has an unrecognized schema, not touching this workspace")
            skipped += 1
            continue
    # ---- reconcile the UNION of jobs/*.json and state.json -------------------
    # A registry entry this sweep cannot pair with a stuck per-job record is an
    # entry it cannot act on: there is no jobs/<id>.json to mark failed, no log
    # to age, and the disagreement itself is the signature of a companion
    # mid-write in a state root shared with every other Claude Code session on
    # this machine. Report it and leave the WHOLE workspace alone — the same
    # answer an unreadable record already gets — and count it, so the sweep
    # exits 3 instead of claiming it classified everything.
    # NOT-TERMINAL is the test, not `in ("running", "queued")`: a status this
    # sweep has never heard of must fail closed too.
    unreconciled = []
    for e in state_entries:
        if not isinstance(e, dict):
            unreconciled.append("state.json(non-dict entry)")
        elif e.get("status") not in TERMINAL and e.get("id") not in stuck_ids:
            unreconciled.append(f"{e.get('id', '?')}({e.get('status')})")
    if unreconciled:
        for entry in unreconciled:
            print(f"skipped: {state_dir}/{entry} — recorded in state.json with no matching stuck jobs/*.json record, not touching this workspace")
            skipped += 1
        continue
    if not stuck:
        continue
    # A workspace with ANY live-pid running job may have a live companion
    # session — very often a DIFFERENT Claude Code session on this machine —
    # that rewrites state.json at will. Never race it.
    live = [j.get("id") for j in stuck.values() if pid_alive(j.get("pid"))]
    if live:
        for p, j in stuck.items():
            why = stuck_reason(j)
            if why and j.get("id") not in live:
                print(f"skipped: {state_dir}/{j.get('id')} ({why}) — workspace has live job(s) {live}, not touching its state")
                skipped += 1
            else:
                print(f"kept: {state_dir}/{j.get('id')} (pid alive)")
                kept += 1
        continue
    to_reap = {p: (j, stuck_reason(j)) for p, j in stuck.items()}
    to_reap = {p: (j, why) for p, (j, why) in to_reap.items() if why}
    for p, (j, why) in to_reap.items():
        verb = "would reap" if dry else "reaped"
        print(f"{verb}: {state_dir}/{j.get('id')} ({j.get('status')}, {why})")
        reaped += 1
    for p, j in stuck.items():
        if p not in to_reap:
            print(f"kept: {state_dir}/{j.get('id')} (no stuck signal)")
            kept += 1
    if dry or not to_reap:
        continue
    reaped_ids = set()
    for p, (j, why) in to_reap.items():
        j.update(status="failed", phase="reaped", reapedAt=stamp, reapReason=why)
        j["pid"] = None
        with open(p, "w") as f:
            json.dump(j, f, indent=2)
        reaped_ids.add(j.get("id"))
        log = j.get("logFile")
        if log:
            try:
                with open(log, "a") as f:
                    f.write(f"[{stamp}] crew-codex reap: marked failed ({why}).\n")
            except OSError:
                pass            # a missing/unwritable log must not abort the sweep
    # Mirror into the workspace's state.json — the authoritative registry the
    # companion serves status/result/cancel from. Already read and shape-checked
    # above; only the reaped entries are touched and everything else round-trips
    # untouched.
    if state is not None and reaped_ids:
        try:
            # ⚠️ MERGE INTO A FRESH READ. Never write back the snapshot the
            # classification above ran on. state.json is the shared registry
            # every other Claude Code session on this machine writes to, and a
            # snapshot writeback DELETES whatever they recorded while this
            # sweep was busy — a job queued after the read simply vanishes,
            # await then reports it missing, and a duplicate dispatch follows.
            # Re-reading here means a concurrently added job survives, because
            # it is present in what we are about to write.
            with open(state_path) as f:
                fresh = json.load(f)
            if isinstance(fresh, list):
                fresh_entries = fresh
            elif isinstance(fresh, dict) and isinstance(fresh.get("jobs"), list):
                fresh_entries = fresh["jobs"]
            elif isinstance(fresh, dict) and not fresh:
                fresh_entries = []
            else:
                raise ValueError("state.json schema changed under the sweep")
            # Abort only for a genuine conflict: an entry this sweep is about
            # to mark failed whose status somebody else has already moved. A
            # blanket abort-on-any-difference would fire constantly in a busy
            # state root and mirror nothing, which is its own kind of lying.
            was = {e.get("id"): e.get("status")
                   for e in state_entries if isinstance(e, dict)}
            conflicts = [e.get("id") for e in fresh_entries
                         if isinstance(e, dict) and e.get("id") in reaped_ids
                         and e.get("status") != was.get(e.get("id"))]
            if conflicts:
                print(f"skipped: {state_dir} — {conflicts} changed status while this sweep ran, not overwriting another session's update")
                skipped += 1
            else:
                changed = False
                for e in fresh_entries:
                    if isinstance(e, dict) and e.get("id") in reaped_ids:
                        e.update(status="failed", phase="reaped",
                                 reapedAt=stamp, updatedAt=stamp)
                        e["pid"] = None
                        changed = True
                if changed:
                    # Residual, irreducible from outside: another writer can
                    # still land between the read above and this replace. That
                    # window is one in-memory read-modify-write with no I/O in
                    # it, where the old one spanned the whole classification
                    # and per-job rewrite phase. Closing it entirely needs a
                    # lock the vendor companion does not take.
                    tmp = state_path + ".reap-tmp"
                    with open(tmp, "w") as f:
                        json.dump(fresh, f, indent=2)
                    os.replace(tmp, state_path)
        except (OSError, ValueError) as exc:
            # The per-job files now say "failed" and the registry the companion
            # actually serves does not. That is unfinished work, not a clean
            # sweep, so it counts toward the non-zero exit below.
            print(f"warning: could not update {state_path}: {exc}")
            skipped += 1
print(f"reap summary: {reaped} {'flagged' if dry else 'reaped'}, {kept} kept, "
      f"{skipped} skipped (unreadable, unreconciled, live workspace or unwritable)")
raise SystemExit(3 if skipped else 0)
PY
  reap_record_exit "$rc"

  # ---- --brokers: REPORT ONLY. This sweep kills NOTHING. --------------------
  # A broker outlives the worktree it was spawned for: delete the worktree and
  # its `node app-server-broker.mjs serve --cwd <gone>` process stays resident
  # forever, holding a /tmp/cxc-* socket dir. Finding those is useful. KILLING
  # them from here is not, and this section no longer does.
  #
  # ⚠️⚠️ WHY THERE IS NO KILL HERE — read this before "restoring" one.
  # The kill failed OPEN five distinct times across five review rounds, each
  # time inside the fix for the previous one:
  #   1. the safety gate read only jobs/*.json while --state took a pessimistic
  #      union, so a job recorded only in state.json opened the gate;
  #   2. the union was then added AFTER a `continue` that skipped workspaces
  #      with no jobs/ dir — bypassing it in exactly the split-brain case it
  #      was written for;
  #   3. os.path.isdir/isfile return False for permission-denied, so an
  #      UNREADABLE registry was indistinguishable from an ABSENT one and read
  #      as "no live jobs" — the gate opened on a workspace we could not see;
  #   4. the fix for (3) swapped those for os.path.exists, which carries the
  #      IDENTICAL EACCES ambiguity one directory level up. Reproduced live: a
  #      mode-000 state/<ws>/ holding a running job made both guards return
  #      False, the live list came back empty, and the sweep proceeded;
  #   5. irreducible TOCTOU — the registry scan finishes before brokers are
  #      classified, so a job can start between the scan and the kill. No
  #      amount of scanning closes that; the process being killed is the only
  #      thing that knows whether it is idle.
  # On top of all five: $CLAUDE_PLUGIN_DATA/state, the /tmp/cxc-* namespace and
  # the broker processes themselves are SHARED BY EVERY CLAUDE CODE SESSION
  # RUNNING ON THIS MACHINE. A broker with a dead --cwd may still be serving
  # another session's in-flight review. Doing this safely needs broker-owned
  # idle-lease / shutdown coordination, and that lives in vendor code we do not
  # own — so the decision is a human's, with the evidence printed for them.
  #
  # RULES FOR ANYONE EDITING THIS BLOCK:
  #   * Never kill, never rm. Print a command; let a human run it.
  #   * Never a global or pattern operation — no `pkill -f`, no `rm /tmp/cxc-*`,
  #     no "everything older than N". Brokers are per-workspace, so a pattern
  #     kill takes out every other session's healthy runtime with it. Every
  #     line below names one specific PID the caller has already been shown.
  #   * Never guard with os.path.exists/isdir/isfile. Attempt the operation and
  #     classify the exception: FileNotFoundError/NotADirectoryError mean
  #     ABSENT (safe); every other OSError means UNREADABLE (not safe).
  if [[ "$SWEEP_BROKERS" -eq 1 ]]; then
    echo
    echo "reap --brokers: REPORT ONLY — this sweep kills no process and deletes no socket dir."
    if [[ "$DRY" -eq 1 ]]; then
      echo "note: --dry-run is redundant with --brokers (accepted, no effect) — the broker sweep never acts."
    fi

    # ADVISORY, not a gate. There is no kill to gate any more, and this survey
    # could never have proven a broker idle anyway (nothing maps a job to the
    # broker serving it). It is printed because a human deciding whether to
    # kill a pid deserves to know that some registry could not be read — an
    # unreadable workspace is NOT an empty one, and it may be another session's.
    SURVEY="$(python3 - "$CLAUDE_PLUGIN_DATA/state" <<'PY'
import json, os, sys
root = sys.argv[1]
TERMINAL = {"completed", "failed", "cancelled", "gone"}
live = []
try:
    names = sorted(os.listdir(root))
except (FileNotFoundError, NotADirectoryError):
    names = []
except OSError as exc:
    names = []
    live.append(f"state-root(unlistable: {exc.__class__.__name__})")
for name in names:
    jobs_dir = os.path.join(root, name, "jobs")
    # NO `continue` when jobs/ is missing: state.json below is the
    # authoritative registry and a workspace can carry a job there with no
    # per-job file (partial cleanup, or a record written before jobs/ existed).
    try:
        entries = sorted(os.listdir(jobs_dir))
    except (FileNotFoundError, NotADirectoryError):
        entries = []                      # genuinely absent — nothing to read
    except OSError as exc:
        live.append(f"{name}/jobs(unreadable: {exc.__class__.__name__})")
        entries = []
    for entry in entries:
        if not entry.endswith(".json"):
            continue
        try:
            with open(os.path.join(jobs_dir, entry)) as f:
                job = json.load(f)
        except (FileNotFoundError, NotADirectoryError):
            continue                      # vanished between listdir and open
        except (OSError, ValueError) as exc:
            live.append(f"{name}/{entry}(unreadable: {exc.__class__.__name__})")
            continue
        if not isinstance(job, dict):
            live.append(f"{name}/{entry}(not a job object)")
        elif job.get("status") not in TERMINAL:
            live.append(f"{name}/{job.get('id', entry)}({job.get('status')})")
    state_path = os.path.join(root, name, "state.json")
    try:
        with open(state_path) as f:
            data = json.load(f)
    except (FileNotFoundError, NotADirectoryError):
        continue                          # no registry here
    except (OSError, ValueError) as exc:
        live.append(f"{name}/state.json(unreadable: {exc.__class__.__name__})")
        continue
    # Only two shapes are understood: a bare list, or {"jobs": [...]}. An empty
    # object is genuinely empty. Anything else is reported, never assumed empty.
    if isinstance(data, list):
        state_entries = data
    elif isinstance(data, dict) and isinstance(data.get("jobs"), list):
        state_entries = data["jobs"]
    elif isinstance(data, dict) and not data:
        state_entries = []
    else:
        live.append(f"{name}/state.json(unrecognized schema)")
        state_entries = []
    for e in state_entries:
        if not isinstance(e, dict):
            live.append(f"{name}/state.json(non-dict entry)")
        elif e.get("status") not in TERMINAL:
            live.append(f"{name}/{e.get('id', '?')}({e.get('status')})")
print(" ".join(sorted(set(live))))
PY
)"
    if [[ -n "$SURVEY" ]]; then
      echo "registry survey: non-terminal or unreadable record(s): $SURVEY"
      echo "  (advisory only — an unreadable record is NOT an empty workspace, and any of these may belong to another Claude Code session)"
    else
      echo "registry survey: every job record read cleanly and is terminal"
    fi

    # Discovery via pgrep -af matches on the FULL command line, which includes
    # this very sweep's own shell whenever the pattern appears in its argv, so
    # every candidate is re-validated against /proc below and our own process
    # ancestry is excluded there.
    BROKER_PATTERN="${CREW_CODEX_BROKER_PATTERN:-app-server-broker}"
    broker_pids=()
    while read -r bpid _; do
      [[ "$bpid" =~ ^[0-9]+$ ]] || continue
      broker_pids+=("$bpid")
    done < <(pgrep -af "$BROKER_PATTERN" 2>/dev/null || true)

    brokers_candidates=0
    brokers_kept=0
    brokers_unknown=0
    brokers_skipped=0
    if [[ "${#broker_pids[@]}" -gt 0 ]]; then
      while IFS=$'\t' read -r verdict bpid bnote; do
        case "$verdict" in
          LIVE)
            echo "broker live: pid $bpid (cwd $bnote exists — not a candidate)"
            brokers_kept=$((brokers_kept + 1))
            ;;
          UNKNOWN)
            echo "broker unknown: pid $bpid ($bnote) — cwd could NOT be proven absent, so this is not a candidate"
            brokers_unknown=$((brokers_unknown + 1))
            ;;
          SKIP)
            echo "broker skipped: pid $bpid ($bnote)"
            brokers_skipped=$((brokers_skipped + 1))
            ;;
          REAP)
            echo "broker candidate: pid $bpid (cwd $bnote is gone — nothing can dispatch into that workspace any more)"
            echo "  ⚠️ this pid may belong to ANOTHER Claude Code session. Confirm it first:"
            echo "      ps -o pid,ppid,lstart,args -p $bpid"
            echo "  then, only if you are sure, kill it yourself — children before the parent:"
            echo "      pkill -P $bpid; kill -TERM $bpid"
            brokers_candidates=$((brokers_candidates + 1))
            ;;
        esac
      done < <(REAP_SELF_PID=$$ python3 - "${broker_pids[@]}" <<'PY'
import os, sys

self_pid = int(os.environ.get("REAP_SELF_PID", "0"))


def ppid_of(pid):
    try:
        with open(f"/proc/{pid}/status") as f:
            for line in f:
                if line.startswith("PPid:"):
                    return int(line.split()[1])
    except Exception:
        return None
    return None


# Our own ancestry is never a candidate. pgrep matched on the full command
# line, so the shell running this reap (and whatever spawned it) can match the
# pattern themselves; reporting an ancestor as reapable would invite a human to
# kill the sweep's own session.
ancestors = set()
walker = self_pid
while walker and walker > 1 and walker not in ancestors:
    ancestors.add(walker)
    walker = ppid_of(walker)


def cmdline(pid):
    # /proc/<pid>/cmdline is NUL-separated and authoritative. The pgrep line is
    # space-joined and cannot be re-split safely once a path contains a space.
    try:
        with open(f"/proc/{pid}/cmdline", "rb") as f:
            raw = f.read()
    except Exception:
        return None
    return [a.decode("utf-8", "replace") for a in raw.split(b"\0") if a]


for arg in sys.argv[1:]:
    try:
        pid = int(arg)
    except ValueError:
        continue
    if pid <= 1 or pid in ancestors:
        print(f"SKIP\t{pid}\tthis reap or one of its ancestors")
        continue
    args = cmdline(pid)
    if not args:
        print(f"SKIP\t{pid}\tprocess vanished before inspection")
        continue
    # A real broker is `node .../app-server-broker.mjs serve --endpoint ...
    # --cwd <workspace> --pid-file ...`. Anything without the serve verb and a
    # --cwd is some other process that merely mentions the pattern.
    if "serve" not in args:
        print(f"SKIP\t{pid}\tnot a broker 'serve' invocation")
        continue
    cwd = None
    for i, a in enumerate(args):
        if a == "--cwd" and i + 1 < len(args):
            cwd = args[i + 1]
        elif a.startswith("--cwd="):
            cwd = a[len("--cwd="):]
    if not cwd:
        print(f"SKIP\t{pid}\tno --cwd argument")
        continue
    # ⚠️ NOT os.path.isdir(cwd). isdir returns False for permission-denied and
    # for an untraversable parent, which reported a workspace we merely cannot
    # SEE as one that is GONE — the fail-open that made the old kill unsafe.
    # lstat and classify: only a proven-absent cwd is a candidate, and a
    # symlinked workspace root is reported LIVE because lstat does not follow
    # it (the link itself still exists, so the workspace is not provably gone).
    try:
        os.lstat(cwd)
    except (FileNotFoundError, NotADirectoryError):
        print(f"REAP\t{pid}\t{cwd}")
    except OSError as exc:
        print(f"UNKNOWN\t{pid}\tcwd {cwd} is unreadable: {exc.__class__.__name__}")
    else:
        print(f"LIVE\t{pid}\t{cwd}")
PY
      )
    fi
    echo "reap brokers summary: $brokers_candidates reported (nothing killed), $brokers_kept live (cwd exists), $brokers_unknown unknown (cwd unreadable), $brokers_skipped skipped (not a broker)"
    echo "reap --brokers took no action: killing a broker from a sweep has failed open five times and cannot be made safe from outside the broker; socket dirs under /tmp/cxc-* are likewise left alone because that namespace is shared with other sessions."
  fi

  # ---- --state: REPORT ONLY. This sweep deletes NOTHING. -------------------
  # It used to rmtree a state dir whose workspace was gone. It no longer does,
  # and this is not a hardening pass: DELETION ITSELF WAS THE DEFECT.
  #
  # ⚠️⚠️ WHY THERE IS NO rmtree HERE — read this before "restoring" one.
  # The dir this sweep would delete IS the registry the companion serves
  # status/result/cancel from, and $CLAUDE_PLUGIN_DATA/state is shared by EVERY
  # Claude Code session on this machine. Four findings closed by construction
  # the moment the delete went away — every one of them a fail-OPEN in front of
  # an irreversible operation, and every one of them the same class that already
  # forced --brokers to become report-only:
  #   1. UNLOCKED SCAN-TO-RMTREE RACE. Nothing holds a lock between
  #      inspect_jobs() and the delete. Another session can enqueue a job into
  #      this workspace, or recreate the cwd, in that window — the identical
  #      irreducible TOCTOU that made the broker kill unsafe. Scanning harder
  #      does not close it; only the process owning the registry can.
  #   2. DANGLING SYMLINK / ENOTDIR read as ABSENCE. The cwd probe classifies
  #      FileNotFoundError and NotADirectoryError as "provably gone", but a cwd
  #      that is a symlink to a moved-and-restored workspace, or a path whose
  #      parent is momentarily a file, raises exactly those — so a live
  #      workspace read as gone and its history was deleted.
  #   3. MALFORMED/MISSING PIDs LAUNDERED INTO TERMINAL RECORDS. The default
  #      sweep runs first and rewrites stuck jobs to status "failed" with
  #      pid None. A record whose pid was a string, a float, or absent is not
  #      alive to pid_alive() — so the preliminary sweep can hand --state a
  #      workspace that reads terminal-and-idle purely because we could not
  #      evaluate its pid.
  #   4. resolve_cwd KEEPS ONLY THE FIRST cwd. A state dir accumulates records
  #      from several workspace roots (worktrees recreated at the same path,
  #      moved checkouts). The first recorded cwd being gone said nothing about
  #      the others, so a LATER, LIVE workspace's history was deleted on the
  #      evidence of an older dead one.
  # Findings 2, 3 and 4 are deliberately NOT hardened here. They exist only
  # because a delete existed; with no delete, the worst outcome of each is a
  # misclassified line of REPORT, which a human reads before running anything.
  # Hardening them would re-establish the illusion that a scan can prove a
  # shared registry idle from outside — the illusion that failed five times on
  # the broker path.
  #
  # What is kept is the detection, and every blocking classification with it:
  # unreadable, unparseable, unrecognized schema, non-terminal job, live pid.
  # Nothing here is global: it names one directory at a time and prints a
  # paste-ready command for a human. Never add a "prune everything older than N".
  #
  # RULES FOR ANYONE EDITING THIS BLOCK:
  #   * Never rm, never rmtree, never truncate. Print a command; let a human run it.
  #   * Never guard with os.path.exists/isdir/isfile. Attempt the operation and
  #     classify the exception: FileNotFoundError/NotADirectoryError mean
  #     ABSENT; every other OSError means UNREADABLE and blocks the report.
  if [[ "$SWEEP_STATE" -eq 1 ]]; then
    echo
    echo "reap --state: REPORT ONLY — this sweep deletes no state dir and no job history."
    if [[ "$DRY" -eq 1 ]]; then
      echo "note: --dry-run is redundant with --state (accepted, no effect) — the state sweep never deletes."
    fi
    rc=0
    REAP_DRY="$DRY" python3 - "$CLAUDE_PLUGIN_DATA/state" <<'PY' || rc=$?
import json, os, shlex, stat, sys

root = sys.argv[1]
# Parsed and reported for symmetry with --brokers, which also accepts a
# redundant --dry-run. There is no destructive branch left for it to select.
dry = os.environ.get("REAP_DRY") == "1"
TERMINAL = {"completed", "failed", "cancelled", "gone"}
candidates = kept = unresolved = blocked = 0


def read_json(path):
    """(kind, value) where kind is 'ok' | 'absent' | 'error'.

    ⚠️ NEVER precede this with os.path.isfile/exists. Those return False for
    permission-denied and for an untraversable parent, so "unreadable" comes
    back indistinguishable from "absent" — and absent is the answer that lets an
    irreversible delete proceed. Attempt the read, classify the exception:
    FileNotFoundError/NotADirectoryError are the only ABSENT signals; every
    other OSError, and every parse failure, is an ERROR that blocks the prune.
    The previous helper returned None for all of them alike.
    """
    try:
        with open(path, encoding="utf-8") as handle:
            raw = handle.read()
    except (FileNotFoundError, NotADirectoryError):
        return ("absent", None)
    except OSError as exc:
        return ("error", f"unreadable: {exc.__class__.__name__}")
    try:
        return ("ok", json.loads(raw))
    except ValueError:
        return ("error", "unparseable JSON")


def registry_entries(data):
    """(kind, entries). Only two shapes are understood: a bare list, or
    {"jobs": [...]}. An empty object is genuinely empty and passes. ANYTHING
    else blocks — a non-list `jobs` value (e.g. {"jobs": {"id": "live"}}) used
    to fall through an isinstance check and read as an empty registry, which is
    a fail-open in front of an rmtree."""
    if isinstance(data, list):
        return ("ok", data)
    if isinstance(data, dict) and isinstance(data.get("jobs"), list):
        return ("ok", data["jobs"])
    if isinstance(data, dict) and not data:
        return ("ok", [])
    return ("error", "unrecognized schema")


def pid_alive(pid):
    # ⚠️ A pid that is not an int (a string, a float, absent) reads as NOT
    # alive — and the default reap sweep runs FIRST, rewriting stuck records to
    # status "failed" with pid None. So a workspace can reach this sweep looking
    # terminal-and-idle purely because its pid was unevaluable (finding 3). That
    # was a fail-open in front of an rmtree; with the delete gone it is one
    # possibly-wrong line of report, and hardening it would only make the report
    # look more authoritative than a scan of a shared registry can ever be.
    if not isinstance(pid, int):
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True        # another user's process is still very much alive
    except OSError:
        return True        # unknown failure: assume alive, never report on it


def resolve_cwd(ws):
    """(cwd or None, [problems]).

    Layouts seen in practice: broker.json/state.json may carry cwd,
    workspaceRoot or root at the top level, and state.json always carries
    jobs[].workspaceRoot — which in current versions is the only place it
    appears at all. A file we could not READ is a problem, not a miss: it may
    have named a cwd that is still very much alive.

    ⚠️ Only the FIRST cwd found is kept, so a state dir holding records from
    several workspace roots is judged on one of them. That was finding 4 while
    this sweep deleted: a later, LIVE workspace's history could be removed on
    the evidence of an older dead one. It is left as-is deliberately — the
    output is now a suggestion a human reads, and the `rm -rf` line prints the
    STATE DIR, so the reader sees the same directory we judged.
    """
    problems = []
    found = None
    for fname in ("broker.json", "state.json"):
        kind, data = read_json(os.path.join(ws, fname))
        if kind == "error":
            problems.append(f"{fname}({data})")
            continue
        if kind == "absent":
            continue
        jobs = None
        if isinstance(data, dict):
            for key in ("cwd", "workspaceRoot", "root"):
                value = data.get(key)
                if isinstance(value, str) and value and found is None:
                    found = value
            jobs = data.get("jobs")
        elif isinstance(data, list):
            jobs = data
        if isinstance(jobs, list):
            for job in jobs:
                if not isinstance(job, dict):
                    continue
                for key in ("workspaceRoot", "cwd", "root"):
                    value = job.get(key)
                    if isinstance(value, str) and value and found is None:
                        found = value
    return found, problems


def inspect_jobs(ws):
    """(live, problems): non-terminal/live-pid job ids, and unreadable records.

    The union of jobs/*.json and state.json, because the two can disagree — a
    job may exist in the workspace registry with its per-job file deleted or
    never written. Before an irreversible delete the pessimistic reading is the
    right one, and a record we cannot read is never read as "no jobs".
    """
    live = []
    problems = []
    jobs_dir = os.path.join(ws, "jobs")
    try:
        entries = sorted(os.listdir(jobs_dir))
    except (FileNotFoundError, NotADirectoryError):
        entries = []                      # genuinely absent — safe
    except OSError as exc:
        problems.append(f"jobs/(unreadable: {exc.__class__.__name__})")
        entries = []
    for entry in entries:
        if not entry.endswith(".json"):
            continue
        kind, job = read_json(os.path.join(jobs_dir, entry))
        if kind == "absent":
            continue                      # vanished between listdir and open
        if kind == "error":
            problems.append(f"jobs/{entry}({job})")
            continue
        if not isinstance(job, dict):
            problems.append(f"jobs/{entry}(not a job object)")
            continue
        if job.get("status") not in TERMINAL:
            live.append(str(job.get("id", entry)))
        elif pid_alive(job.get("pid")):
            # Terminal record, live pid: another session's companion is still
            # running in this workspace whatever the record claims.
            live.append(f"{job.get('id', entry)}(pid {job.get('pid')} alive)")
    kind, data = read_json(os.path.join(ws, "state.json"))
    if kind == "error":
        problems.append(f"state.json({data})")
    elif kind == "ok":
        shape, entries = registry_entries(data)
        if shape == "error":
            problems.append(f"state.json({entries})")
        else:
            for entry in entries:
                if not isinstance(entry, dict):
                    problems.append("state.json(non-dict entry)")
                elif entry.get("status") not in TERMINAL:
                    live.append(str(entry.get("id", "?")))
                elif pid_alive(entry.get("pid")):
                    live.append(f"{entry.get('id', '?')}(pid {entry.get('pid')} alive)")
    return sorted(set(live)), sorted(set(problems))


try:
    names = sorted(os.listdir(root))
except (FileNotFoundError, NotADirectoryError):
    names = []
except OSError as exc:
    print(f"reap state: cannot list {root} ({exc.__class__.__name__}) — nothing inspected")
    raise SystemExit(3)
if not names:
    print(f"reap state: no state dirs under {root}")
for name in names:
    ws = os.path.join(root, name)
    try:
        info = os.lstat(ws)
    except (FileNotFoundError, NotADirectoryError):
        continue                          # vanished mid-sweep: nothing to do
    except OSError as exc:
        print(f"state blocked: {name} — cannot stat it ({exc.__class__.__name__}); never pruning what cannot be inspected")
        blocked += 1
        continue
    if not stat.S_ISDIR(info.st_mode):
        continue
    cwd, problems = resolve_cwd(ws)
    if problems:
        print(f"state blocked: {name} — unreadable record(s) {problems}; this may be another session's live workspace")
        blocked += 1
        continue
    if cwd is None:
        print(f"state unresolved: {name} — no cwd recorded anywhere, skipping")
        unresolved += 1
        continue
    try:
        os.lstat(cwd)
    except (FileNotFoundError, NotADirectoryError):
        # "Provably gone" — as far as one lstat can prove anything. A dangling
        # symlink and a parent that is momentarily a file raise these too
        # (finding 2), which is precisely why the answer is now a REPORT and
        # not a delete. Not hardened: no probe run from outside can do better.
        pass
    except OSError as exc:
        print(f"state blocked: {name} — cwd {cwd} could not be proven absent ({exc.__class__.__name__})")
        blocked += 1
        continue
    else:
        print(f"state kept: {name} ({cwd} still exists)")
        kept += 1
        continue
    live, problems = inspect_jobs(ws)
    if problems:
        print(f"state blocked: {name} — unreadable record(s) {problems}; an unreadable registry is not an empty one")
        blocked += 1
        continue
    if live:
        print(f"state blocked: {name} ({cwd} is gone but jobs {live} are non-terminal or still have a live pid)")
        blocked += 1
        continue
    # Everything the old sweep required before an rmtree holds — and it held a
    # moment ago, not now (finding 1: nothing locks this registry against the
    # other sessions sharing it). So the finding is reported, with the command,
    # for a human who can check what we cannot.
    print(f"state candidate: {name} — cwd {cwd} is gone; every record here parsed and is terminal with no live pid")
    print(f"  ⚠️ this registry is in a state root SHARED by every Claude Code session on this machine, and a")
    print(f"     job can be queued into it between this scan and any delete. Confirm it is nobody's first:")
    print(f"      ls -la {shlex.quote(ws)}")
    print(f"  then, only if you are sure, delete it yourself — this destroys the job history irreversibly:")
    print(f"      rm -rf {shlex.quote(ws)}")
    candidates += 1
print(f"reap state summary: {candidates} reported (nothing deleted), {kept} kept (cwd alive), "
      f"{blocked} blocked (non-terminal, live pid or unreadable), "
      f"{unresolved} unresolved (skipped)")
print("reap --state took no action: the registry it would delete is shared with every other session, and "
      "no scan run from outside it can prove it idle — the same reason --brokers stopped killing.")
# Blocked and unresolved entries are work a human still has to finish. Reporting
# exit 0 for them told automation the sweep was complete when it had walked past
# exactly the dirs that need a decision.
raise SystemExit(3 if (blocked or unresolved) else 0)
PY
    reap_record_exit "$rc"
  fi

  exit "$REAP_EXIT"
fi

# ---- effort routing: adversarial-review --effort runs on our own driver ----
# Default is unchanged: RUN_CMD is the verbatim companion passthrough, so a
# dispatch WITHOUT --effort behaves exactly as it always has. Only
# `adversarial-review --effort <e>` diverges, and it diverges to a driver that
# re-composes the companion's own exported modules — no vendor file is patched.
# Everything downstream (capacity retry, dispatch stamping, output passthrough)
# is shared, so the driver inherits it for free.
RUN_CMD=(node "$COMPANION" "$@")
if [[ $REVIEW_EFFORT_SEEN -eq 1 && "${1:-}" == "adversarial-review" ]]; then
  DRIVER="$CREW_LIB_DIR/review-with-effort.mjs"
  if [[ ! -f "$DRIVER" ]]; then
    echo "crew-codex: effort driver missing at $DRIVER — codex-crew is installed incompletely. Re-run without --effort to use the vendor review path (it runs at the config's model_reasoning_effort)." >&2
    exit 1
  fi
  # $1 is dropped: the driver only ever runs adversarial reviews. Everything
  # else forwards verbatim, --effort included — the driver parses it the same
  # way the companion's parser would.
  RUN_CMD=(node "$DRIVER" --plugin-root "$COMPANION_ROOT" "${@:2}")
fi

# Bounded retry on model-capacity rejection. The capacity error is an
# admission-time rejection (the turn never starts), so retrying is write-safe.
# Jittered backoff so parallel fan-outs don't thundering-herd the quota window.
# Overridable for tests: CREW_CODEX_RETRY_DELAYS="0 0" collapses the waits.
RETRY_DELAYS=(${CREW_CODEX_RETRY_DELAYS:-5 15 45})
MAX_ATTEMPTS=$(( ${#RETRY_DELAYS[@]} + 1 ))
CAPACITY_PATTERN="at capacity"

TMP_OUT="$(mktemp)" TMP_ERR="$(mktemp)"
trap 'rm -f "$TMP_OUT" "$TMP_ERR"' EXIT

attempt=1
while :; do
  rc=0
  "${RUN_CMD[@]}" >"$TMP_OUT" 2>"$TMP_ERR" || rc=$?

  if [[ $rc -eq 0 ]] || ! grep -qi "$CAPACITY_PATTERN" "$TMP_OUT" "$TMP_ERR"; then
    break
  fi

  if [[ $attempt -ge $MAX_ATTEMPTS ]]; then
    echo "crew-codex: model still at capacity after $MAX_ATTEMPTS attempts — giving up" >&2
    break
  fi

  base=${RETRY_DELAYS[$((attempt - 1))]}
  delay=$(( base + (base > 0 ? RANDOM % (base / 2 + 1) : 0) ))
  echo "crew-codex: model at capacity (attempt $attempt/$MAX_ATTEMPTS); retrying in ${delay}s" >&2
  sleep "$delay"
  attempt=$((attempt + 1))
done

# ---- dispatch stamp: the audit trail for model + reasoning effort ----------
# A finished REVIEW leaves no record of what it ran at: the companion stores
# model/effort under storedJob.request, and the review path never receives
# either as an option, so review-*.meta.json carries neither (task-*.meta.json
# does carry both — the gap is reviews only). Review effort comes from
# model_reasoning_effort in the codex config, which no companion-written record
# ever sees, so nothing else can record it. Stamping `task` too is deliberate
# duplication: one sidecar shape for every dispatch beats a shape that only
# exists for the subcommand nobody checks. Do not "clean up" the task case.
# Best-effort by construction — an audit-trail failure must never change the
# dispatch's exit code, stdout or stderr, so the whole block is swallowed.
case "${1:-}" in
  review|adversarial-review|task)
    {
      # First id wins: the launch line names the job we just dispatched, and
      # later ids (resume candidates, status hints) belong to other jobs.
      JOB_ID="$(grep -ohE '(review|task)-[A-Za-z0-9]+-[A-Za-z0-9]+' "$TMP_OUT" "$TMP_ERR" 2>/dev/null | head -n 1 || true)"
      if [[ -n "$JOB_ID" ]]; then
        mkdir -p "$CREW_ARCHIVE_DIR"
        CREW_STAMP_JOB_ID="$JOB_ID" \
        CREW_STAMP_OUT="$CREW_ARCHIVE_DIR/$JOB_ID.dispatch.json" \
        CREW_STAMP_CONFIG="${CODEX_HOME:-$HOME/.codex}/config.toml" \
        python3 - "$@" <<'PY'
import json, os, re, sys, time

argv = sys.argv[1:]
subcommand = argv[0] if argv else None


def flag_value(name):
    """Value of --name <v> or --name=<v>. Last occurrence wins, matching the
    companion's own parser, so the stamp records what actually took effect."""
    value = None
    i = 0
    while i < len(argv):
        arg = argv[i]
        # ⚠️ Stop at `--`. Everything after it is literal focus text that the
        # vendor parser never interprets as flags. Reading past the sentinel
        # records a "model" or "effort" the dispatch never actually used, so the
        # audit trail would assert a configuration that did not happen.
        if arg == "--":
            break
        if arg == name and i + 1 < len(argv):
            value = argv[i + 1]
            i += 2
            continue
        if arg.startswith(name + "="):
            value = arg[len(name) + 1:]
            i += 1
            continue
        i += 1
    return value


# ⚠️ ONE TABLE PER SUBCOMMAND, matching the VENDOR PARSER for that subcommand.
# A single shared table was a leak: `--base` is a review flag the task parser
# has never heard of, so `crew-codex task --base=AKIA...` is prompt TEXT to the
# dispatch — but the shared table recognized the prefix and wrote the whole
# secret-bearing token verbatim into an archive that deliberately outlives the
# vendor's session cleanup. Anything not recognized for THIS subcommand is a
# positional and gets redacted; that is the safe default and must stay the
# default when a new flag appears upstream.
# `--effort` is deliberately absent from the review tables: the vendor review
# parser does not take it, and on adversarial-review (where crew-codex's own
# driver does) it is already recorded as first-class `effortRequested` /
# `effortEffective` fields, so redacting it from argv loses nothing.
SUBCOMMAND_FLAGS = {
    "review": (
        ("--base", "--scope", "--model", "--cwd"),
        ("--json", "--background", "--wait"),
    ),
    "adversarial-review": (
        ("--base", "--scope", "--model", "--cwd"),
        ("--json", "--background", "--wait"),
    ),
    "task": (
        ("--model", "--effort", "--cwd", "--prompt-file"),
        ("--json", "--write", "--resume-last", "--resume", "--fresh", "--background"),
    ),
}
# Unknown subcommand => empty tables => every token redacted. Fail closed.
ROUTING_VALUE_FLAGS, ROUTING_BOOL_FLAGS = SUBCOMMAND_FLAGS.get(subcommand, ((), ()))


def redacted_argv():
    """Routing flags recognized FOR THIS SUBCOMMAND verbatim; every other token
    replaced by a shape marker. --prompt-file keeps its PATH (not contents) on
    `task` because the path is routing information there; the file it names is
    never read here."""
    out = []
    i = 0
    positionals = 0
    while i < len(argv):
        arg = argv[i]
        # ⚠️ Everything after `--` is focus text, even when it LOOKS like a flag.
        # `adversarial-review -- --prompt-file /internal/INC-123` passes that path
        # to the model as prose, and re-parsing it here as routing metadata would
        # archive an internal path into storage that outlives session cleanup --
        # exactly the leak this function exists to prevent. Count the rest as
        # positionals and stop interpreting.
        if arg == "--":
            positionals += len(argv) - i - 1
            break
        if i == 0:
            out.append(arg)          # the subcommand itself
        elif arg in ROUTING_VALUE_FLAGS and i + 1 < len(argv):
            out.append(arg)
            out.append(argv[i + 1])
            i += 2
            continue
        elif any(arg.startswith(f + "=") for f in ROUTING_VALUE_FLAGS):
            out.append(arg)
        elif arg in ROUTING_BOOL_FLAGS:
            out.append(arg)
        else:
            positionals += 1
        i += 1
    if positionals:
        out.append(f"<redacted: {positionals} positional token(s)>")
    return out


def config_effort(path):
    """model_reasoning_effort from the ROOT table only. A value under a
    [profiles.x] table applies only when that profile is selected, so counting
    it would stamp an effort the dispatch never ran at."""
    try:
        with open(path, encoding="utf-8") as handle:
            for line in handle:
                stripped = line.strip()
                if stripped.startswith("#"):
                    continue
                if stripped.startswith("["):
                    break
                match = re.match(
                    r'^model_reasoning_effort\s*=\s*["\']?([A-Za-z-]+)', stripped)
                if match:
                    return match.group(1)
    except OSError:
        return None
    return None


effort_requested = flag_value("--effort")
effort_config = config_effort(os.environ["CREW_STAMP_CONFIG"])
# --effort really takes effect on two paths: `task` (codex-companion parses it)
# and `adversarial-review` (crew-codex's own driver threads it into the turn).
# On the native `review` path it does not exist at all, and crew-codex rejects
# it before we ever get here — so there it can only be config-sourced.
from_flag = subcommand in ("task", "adversarial-review") and effort_requested is not None
record = {
    "jobId": os.environ["CREW_STAMP_JOB_ID"],
    "subcommand": subcommand,
    "model": flag_value("--model"),
    "effortRequested": effort_requested,
    "effortEffective": effort_requested if from_flag else effort_config,
    "effortConfig": effort_config,
    "effortSource": "flag" if from_flag else "config",
    # NOT the raw argv. Positionals on these subcommands are the review focus
    # text and task prompts, which routinely carry pasted incident logs, internal
    # hostnames and secret-bearing commands -- and this archive is deliberately
    # retained past the vendor's session cleanup, so anything written here
    # outlives the job by design. The audit objective needs routing metadata, not
    # content: record the recognized flags and only the SHAPE of the positionals.
    "argv": redacted_argv(),
    "stampedAt": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime()),
}
out = os.environ["CREW_STAMP_OUT"]
tmp = out + ".tmp"
with open(tmp, "w", encoding="utf-8") as handle:
    json.dump(record, handle, indent=2)
os.replace(tmp, out)
PY
      fi
    } >/dev/null 2>&1 || true
    ;;
esac

cat "$TMP_OUT"
cat "$TMP_ERR" >&2
exit $rc
