#!/usr/bin/env bash
# crew-codex — forward to the official codex plugin's companion runtime.
# Resolves the runtime through installed_plugins.json so version bumps of
# codex@openai-codex never break the crew agents.
set -euo pipefail

CLAUDE_DIR="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
INSTALLED_JSON="$CLAUDE_DIR/plugins/installed_plugins.json"
CODEX_PLUGIN_ID="codex@openai-codex"
# Our own code, shipped beside this script — the effort driver, the app-server
# bridge steer/queue ride on, and the codex-plugin patch.
# NOT `readlink -f`: upstream uses it here, but it is GNU-only and this plugin
# is installed on darwin too, where the resolution would fail and take the
# patch file, the bridge and every steer/queue call with it.
CREW_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
CREW_LIB_DIR="$CREW_ROOT/lib"

# ---- usage guards: a help request must never become a dispatch -------------
# codex-companion has NO per-subcommand help handler, and its review parser
# knows only --base/--scope/--model/--cwd (plus --json/--wait/--background);
# EVERY other argument becomes a positional and is joined into the review's
# focus text. So `crew-codex adversarial-review --help` used to run a FULL
# review against the default base `main` — ~10 minutes of wall clock, burned
# twice on 2026-08-22 — and `--effort high` was swallowed into the prompt
# while the turn still ran at whatever effort the codex config carried.
# Both are intercepted here, before the companion is even resolved: printing
# usage must not depend on the codex plugin being installed. `--effort` on
# `adversarial-review` is no longer an error — it is now a routing decision
# (see the effort-routing block further down) — but it is still parsed here so
# an invalid value is rejected before anything is dispatched.
crew_usage() {
  cat <<'USAGE'
crew-codex <subcommand> [args...]

Subcommands crew-codex handles itself:
  --resolve                     print the resolved codex-companion.mjs path
  await <job-id> [--for <s>]    block until the job leaves running — exit 0
                                completed, 1 failed/cancelled, 2 not found,
                                3 stale, 4 hung, 5 SUPERSEDED by a redirect
                                (the line names the successor id — await THAT
                                one; a redirect is never a failure),
                                10 still running (call again)
  steer <job-id> "<message>"    interject into the turn the job is running RIGHT
                                NOW. Stops nothing: the in-flight tool call
                                finishes and the model reads it at its next
                                step. The normal way to correct a running job.
                                Needs `crew-codex patch --apply`.
  queue <job-id> "<message>"    a message for AFTER the current turn. A turn is
                                the WHOLE task, so this arrives once the work is
                                done — use it for "then also do X", never for a
                                correction. Needs `crew-codex patch --apply`.
  redirect <job-id> [--model <m>] [--effort <e>] "<instruction>"
                                DESTRUCTIVE. Interrupts the live turn, then
                                resumes the same Codex thread with the new text,
                                so an edit in flight can be left half applied.
                                For a job genuinely off the rails only — reach
                                for `steer` first. Prints REDIRECTED <old> ->
                                <new>; await the NEW id.
  patch [--status|--apply|--revert]
                                apply the queue-passthrough fix to whichever
                                codex plugin version is installed. Stock, its
                                broker forwards only turn/interrupt while a turn
                                streams, so steer and queue are refused — the
                                one destructive option was the only one that got
                                through. Idempotent, keeps *.crew-orig backups.
                                A SessionStart hook applies it automatically;
                                CREW_CODEX_NO_AUTO_PATCH=1 opts out.
  sanitize-archive [--dir <path>] [--dry-run]
                                re-run the archive scrubber over jobs archived
                                by an earlier crew-codex, which kept focus text
                                and prompt-derived summaries in the clear.
                                Rewrites in place only where the bytes differ;
                                deletes nothing; never touches .log files.
  reap [--dry-run] [--brokers] [--state]
                                retire the per-job brokers crew-codex started
                                whose jobs have ended (safe: we spawned them and
                                the sidecar proves identity), and mark stuck job
                                records failed; --brokers and
                                --state are REPORT ONLY — they kill no process
                                and delete no directory, they print the command
                                for you to run. Exit: 0 the sweep classified
                                everything, 2 usage error, 3 the sweep was
                                INCOMPLETE (entries blocked, unresolved or
                                skipped — read the lines, do not treat as clean)
  --help | -h | help            this text

Everything else (task, review, adversarial-review, status, result, cancel,
setup, transfer) is forwarded verbatim to the codex plugin's companion
runtime — with ONE exception: `adversarial-review --effort <e>` runs on
crew-codex's own driver, because the companion cannot set reasoning effort on
a review. Run `crew-codex adversarial-review --help` for that path's flags.
USAGE
}

review_usage() {
  local sub="$1"
  cat <<USAGE
crew-codex $sub [flags] [focus text]

Flags codex-companion actually parses on the review path:
  --base <ref>                  diff base (default: main)
  --scope <auto|working-tree|branch>
  --model <model>               model override for this review
  --cwd <path>                  workspace root
  --json                        machine-readable output
  --wait | --background         run inline, or detach and return a job id
USAGE

  if [[ "$sub" == "adversarial-review" ]]; then
    cat <<USAGE
  [focus text]                  every remaining word becomes the review focus

Flag crew-codex adds on top of the companion:
  --effort <none|minimal|low|medium|high|xhigh>
                                per-dispatch reasoning effort; medium when
                                omitted. codex-companion cannot set it, so
                                crew-codex routes EVERY adversarial review to
                                its own driver
                                (lib/review-with-effort.mjs), which composes the
                                codex plugin's exported modules and threads the
                                effort into the turn the companion leaves null.
                                The driver also detaches properly under
                                --background and stamps effort + model into the
                                job record, which vendor review records lack.

Validator ceiling is xhigh — the registry's max/ultra tiers are refused here.
Practical FLOOR on the gpt-5.6 family (sol/terra/luna) and on gpt-6-astra is
low: those models return a 400 on reasoning.effort for 'none' and 'minimal',
so those two are accepted (other model families may take them) but warned
about, and the job fails at the API rather than in the wrapper.

EFFORT IS THE CALLER'S. The turn runs at exactly the --effort you pass; WITHOUT
--effort it runs at medium, sent explicitly — never at model_reasoning_effort
from ${CODEX_HOME:-$HOME/.codex}/config.toml. Nothing raises or lowers it. Ask
for high or xhigh yourself when the change warrants it (an auth change,
extremely complex code); that is a per-dispatch choice, not a rule.

SENSITIVITY LABELS. Before the turn starts, the driver classifies the changed
files of the very diff it is about to review — Terraform, Bicep/ARM,
CloudFormation, Kubernetes RBAC and network policy, CI/CD pipelines, keys and
dotenvs, auth/identity source paths — and names any matched rules and paths on
stderr and in the job record. Informational only: it changes nothing.
USAGE
  else
    cat <<USAGE
  [focus text]                  every remaining word becomes the review focus

The native review path accepts NO --effort flag. It runs through the
companion's built-in reviewer (runAppServerReview), a different code path that
crew-codex's effort driver does not model, and unknown arguments there are not
rejected — they are folded into the review request — so an --effort flag would
change the request and never the reasoning effort. Use
'crew-codex adversarial-review --effort <e>' for per-dispatch effort, or set
model_reasoning_effort in ${CODEX_HOME:-$HOME/.codex}/config.toml.
USAGE
  fi
}

task_usage() {
  cat <<USAGE
crew-codex task [flags] [prompt]

Flags codex-companion parses on the task path:
  --background                  detach and return a job id
  --write                       allow file writes (default: read-only)
  --resume-last | --resume | --fresh
  --model <model|spark>         model override
  --effort <none|minimal|low|medium|high|xhigh>
  --cwd <path>                  workspace root
  --prompt-file <path>          read the prompt from a file
  [prompt]                      every remaining word becomes the prompt

Unlike the native review path, task DOES accept --effort — codex-companion
parses it here itself. The other dispatch mode with per-job effort control is
'crew-codex adversarial-review --effort <e>', which crew-codex drives itself
because the companion cannot set effort on a review.
USAGE
}

if [[ $# -eq 0 || "${1:-}" == "--help" || "${1:-}" == "-h" || "${1:-}" == "help" ]]; then
  crew_usage
  exit 0
fi

# Set by the review guard below and read by the effort-routing block after the
# companion is resolved. Declared here because `set -u` is on and the guard
# only runs for the two review subcommands.
REVIEW_EFFORT=""
REVIEW_EFFORT_SEEN=0

if [[ "$1" == "review" || "$1" == "adversarial-review" ]]; then
  # EXACT matches only, and only for these two subcommands. Focus text is free
  # prose that may legitimately contain the word "help" or a --flag-shaped
  # token, and rejecting unknown flags wholesale would break dispatches the
  # companion accepts. Two passes so --help wins over the --effort error no
  # matter which comes first.
  #
  # ⚠️ SCOPE DIFFERS BY SPELLING, deliberately:
  #   --help  — scanned at EVERY position. Nobody passes a literal "--help"
  #             token as review focus prose.
  #   help/-h — accepted ONLY as the first argument after the subcommand.
  #             Focus text is passed as unquoted positionals that the companion
  #             joins, so scanning every position would make
  #             `adversarial-review improve the help wording` print usage and
  #             exit 0 WITHOUT dispatching — silently swallowing a real review
  #             and reporting success to the caller. Refusing to review is a
  #             worse failure than printing usage one position later.
  case "${2:-}" in
    -h|help) review_usage "$1"; exit 0 ;;
  esac
  # Stop at `--`: the vendor parser treats every token after the sentinel as
  # positional focus text, so `adversarial-review -- --help` is a review whose
  # literal focus is "--help". Scanning past it would intercept a valid dispatch.
  for arg in "$@"; do
    [[ "$arg" == "--" ]] && break
    case "$arg" in
      --help) review_usage "$1"; exit 0 ;;
    esac
  done
  # Collect --effort in BOTH spellings, last occurrence wins — the same rule
  # the companion's own parser applies, so what we validate and route on is
  # what would actually take effect.
  effort_pending=0
  for arg in "$@"; do
    # Same sentinel rule as the help scan: after `--` everything is focus text,
    # so `adversarial-review -- --effort high` is a NO-effort dispatch (the
    # driver's medium default) whose focus is the literal string
    # "--effort high". Validating that token as an effort would refuse a valid
    # review.
    [[ "$arg" == "--" ]] && break
    if [[ $effort_pending -eq 1 ]]; then
      REVIEW_EFFORT="$arg"
      effort_pending=0
      continue
    fi
    case "$arg" in
      --effort) effort_pending=1; REVIEW_EFFORT_SEEN=1 ;;
      --effort=*) REVIEW_EFFORT="${arg#--effort=}"; REVIEW_EFFORT_SEEN=1 ;;
    esac
  done
  if [[ $effort_pending -eq 1 ]]; then
    echo "crew-codex: --effort was given without a value." >&2
    exit 2
  fi

  # The native reviewer is a DIFFERENT companion code path (runAppServerReview,
  # companion:1002) that takes a review target rather than a prompt+turn, so
  # crew-codex's effort driver does not model it. Refuse rather than pretend.
  if [[ $REVIEW_EFFORT_SEEN -eq 1 && "$1" == "review" ]]; then
    echo "crew-codex: review does not accept --effort. The native reviewer runs through codex-companion's runAppServerReview path, which takes no reasoning effort, and unknown arguments there are folded into the review request instead of rejected — so '--effort $REVIEW_EFFORT' would change the request and the turn would still run at the config's effort. Silently wrong, not an error." >&2
    echo "crew-codex: --effort IS supported on 'crew-codex adversarial-review --effort <e>' (crew-codex drives that turn itself). Otherwise set model_reasoning_effort in ${CODEX_HOME:-$HOME/.codex}/config.toml, or use 'crew-codex task --effort <e>'." >&2
    exit 2
  fi

  # Validated here, before the companion is resolved and long before anything
  # is dispatched, so a typo costs nothing. The driver re-validates against the
  # same list; this copy exists so `--effort bogus` never reaches node at all.
  # Ceiling is xhigh on purpose — the registry's max/ultra tiers are untested
  # through this path and the driver bypasses the vendor's own validator.
  if [[ $REVIEW_EFFORT_SEEN -eq 1 ]]; then
    case "$REVIEW_EFFORT" in
      none|minimal|low|medium|high|xhigh) ;;
      *)
        echo "crew-codex: invalid --effort '$REVIEW_EFFORT'. Valid values: none|minimal|low|medium|high|xhigh." >&2
        echo "crew-codex: xhigh is the ceiling through this plugin — the registry's max/ultra tiers are not accepted here." >&2
        exit 2
        ;;
    esac
  fi
fi

if [[ "$1" == "task" ]]; then
  # Same class of bug as the review path: codex-companion has no help handler
  # for `task` either, so `crew-codex task --help` dispatches a real Codex job
  # whose PROMPT is the literal string "--help". Cheaper than an accidental
  # review, but still a wasted job and a wasted rate window.
  #
  # Only --help/-h, NOT a bare `help`: a task's prompt is a positional, so
  # `crew-codex task help` is a plausible (if terse) real prompt in a way that
  # `review help` is not. Intercepting it would break a legitimate dispatch.
  for arg in "$@"; do
    case "$arg" in
      --help|-h) task_usage; exit 0 ;;
    esac
  done
fi

if ! command -v node >/dev/null 2>&1; then
  echo "crew-codex: node is required (the codex companion runtime is a Node script)" >&2
  exit 1
fi

if [[ ! -f "$INSTALLED_JSON" ]]; then
  echo "crew-codex: $INSTALLED_JSON not found — install the official Codex plugin first: /plugin install $CODEX_PLUGIN_ID" >&2
  exit 1
fi

if ! COMPANION_ROOT="$(node -e '
  const fs = require("fs");
  const data = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
  const entries = (data.plugins || {})[process.argv[2]];
  if (!Array.isArray(entries) || entries.length === 0 || !entries[0].installPath) process.exit(2);
  process.stdout.write(entries[0].installPath);
' "$INSTALLED_JSON" "$CODEX_PLUGIN_ID")"; then
  echo "crew-codex: $CODEX_PLUGIN_ID is not installed — run: /plugin install $CODEX_PLUGIN_ID" >&2
  exit 1
fi

COMPANION="$COMPANION_ROOT/scripts/codex-companion.mjs"
if [[ ! -f "$COMPANION" ]]; then
  echo "crew-codex: companion script missing at $COMPANION — the codex plugin layout changed; update codex-crew's resolver" >&2
  exit 1
fi

# Job state must land in the codex plugin's data dir so /codex:status,
# /codex:result and its SessionEnd cleanup see crew-launched jobs too.
export CLAUDE_PLUGIN_DATA="${CLAUDE_PLUGIN_DATA:-$CLAUDE_DIR/plugins/data/codex-openai-codex}"

# Our own archive — the companion prunes at 50 jobs (deleting logs) and drops
# a session's jobs at SessionEnd, so results are copied somewhere it can't reap.
CREW_ARCHIVE_DIR="${CREW_CODEX_ARCHIVE_DIR:-$CLAUDE_DIR/plugins/data/codex-crew/jobs}"

# ---- per-job brokers -------------------------------------------------------
# A broker carries ONE streaming turn per cwd. The companion's answer to a busy
# broker (lib/codex.mjs, withAppServer) is to run the whole job on a private
# stdio app-server, which has no socket, so nothing can ever steer, queue or
# interrupt it. In a shared cwd that means exactly one reachable job: whichever
# won the broker first. Everything launched during its turn is unreachable for
# life.
#
# So every launch gets its OWN broker and we remember the endpoint per job.
# CODEX_COMPANION_APP_SERVER_ENDPOINT takes priority over broker.json in the
# companion's own client, which is the seam this rides on.
#
# Brokers hold a codex app-server each, so a leak is expensive. Every one is
# recorded in a sidecar, reaped when its job reaches terminal state, and swept
# on the next launch plus `crew-codex reap`. A broker's SIGTERM handler closes
# its app-server child and removes its socket, so one signal is a clean stop.
CREW_BROKER_ENV="CODEX_COMPANION_APP_SERVER_ENDPOINT"
CREW_BROKER_SCRIPT="$COMPANION_ROOT/scripts/app-server-broker.mjs"

crew_sidecar() { printf '%s/%s.broker' "$CREW_ARCHIVE_DIR" "$1"; }

crew_job_endpoint() {
  local f; f="$(crew_sidecar "$1")"
  [[ -f "$f" ]] || return 0
  cut -f1 <"$f"
}

# A pid alone is not an identity: pids get recycled, and a sidecar can outlive
# its broker by hours. Field 22 of /proc/<pid>/stat is the process start time in
# clock ticks, which together with the pid is stable and unforgeable enough to
# prove we are signalling the same process we started.
# ⚠️ Upstream reads /proc/<pid>/stat and nothing else. That is Linux-only, and
# this plugin is installed on darwin too, where it returns EMPTY — and an empty
# start time makes crew_kill_broker skip the ownership check entirely and signal
# whatever now holds the pid. The check silently degrading to "no check" on half
# the install base is worse than not having it, so darwin gets a real answer:
# `ps -o lstart=` is the process start time to the second, stable for the life
# of the process and unaffected by pid reuse.
crew_pid_starttime() {
  local pid="$1" st=""
  [[ "$pid" =~ ^[0-9]+$ ]] || return 0
  if [[ -r "/proc/$pid/stat" ]]; then
    st="$(awk '{ n = split($0, a, ") "); print a[n] }' "/proc/$pid/stat" 2>/dev/null \
      | awk '{ print $20 }' 2>/dev/null || true)"
  fi
  if [[ -z "$st" ]] && command -v ps >/dev/null 2>&1; then
    # Collapse whitespace: the field is compared as a string, so "Thu Aug 28"
    # and "Thu  Aug 28" must not read as two different processes.
    st="$(ps -o lstart= -p "$pid" 2>/dev/null | tr -s '[:space:]' '_' || true)"
    st="${st#_}"; st="${st%_}"
  fi
  printf '%s' "$st"
}

# Block until $1 exits or $2 seconds pass, whichever is first.
# ⚠️ `timeout N tail --pid=` is GNU-only twice over. On darwin neither exists,
# the command failed instantly, and await busy-polled the companion instead of
# blocking. GNU tools stay the primary path (a kernel wait, wakes the instant
# the pid exits); otherwise a kill -0 loop at a 0.2s cadence — bounded, never
# a spin, and it still wakes within a fraction of a second of the exit.
crew_wait_pid() {
  local pid="$1" secs="$2" to="" end
  if command -v timeout >/dev/null 2>&1; then to=timeout
  elif command -v gtimeout >/dev/null 2>&1; then to=gtimeout; fi
  if [[ -n "$to" ]] && tail --version 2>/dev/null | grep -q GNU; then
    "$to" "$secs" tail --pid="$pid" -f /dev/null 2>/dev/null || true
    return 0
  fi
  end=$(( $(date +%s) + secs ))
  while kill -0 "$pid" 2>/dev/null && [[ $(date +%s) -lt $end ]]; do
    sleep 0.2
  done
  return 0
}

# File mtime in epoch seconds. GNU stat takes -c, BSD stat takes -f; BSD stat
# rejects -c outright, which made every log look brand new on darwin and the
# hung-turn check could never fire. Unreadable -> now (age 0, never HUNG).
crew_mtime() {
  stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null || date +%s
}

# Stop one broker and remove everything it left behind. Refuses to signal a pid
# whose start time no longer matches the one recorded at spawn.
crew_kill_broker() {
  local pid="$1" dir="$2" expect_start="${3:-}"
  if [[ -n "$expect_start" && "$pid" =~ ^[0-9]+$ ]]; then
    local now_start
    now_start="$(crew_pid_starttime "$pid")"
    if [[ -n "$now_start" && "$now_start" != "$expect_start" ]]; then
      # Same pid, different process: the broker died and something else took
      # its number. Clean the files, never signal the stranger.
      if [[ -n "$dir" && -d "$dir" ]]; then
        rm -f "$dir/broker.sock" "$dir/broker.pid" "$dir/broker.log" 2>/dev/null || true
        rmdir "$dir" 2>/dev/null || true
      fi
      return 0
    fi
  fi
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    kill "$pid" 2>/dev/null || true
    local i=0
    while [[ $i -lt 20 ]] && kill -0 "$pid" 2>/dev/null; do
      sleep 0.1
      i=$((i + 1))
    done
    kill -0 "$pid" 2>/dev/null && kill -9 "$pid" 2>/dev/null || true
  fi
  if [[ -n "$dir" && -d "$dir" ]]; then
    rm -f "$dir/broker.sock" "$dir/broker.pid" "$dir/broker.log" 2>/dev/null || true
    rmdir "$dir" 2>/dev/null || true
  fi
}

# Sweep: any recorded broker whose job is no longer running, plus any of our
# broker directories whose process is already gone.
crew_reap_brokers() {
  local f job pid dir endpoint status
  for f in "$CREW_ARCHIVE_DIR"/*.broker; do
    [[ -f "$f" ]] || continue
    job="$(basename "$f" .broker)"
    IFS=$'\t' read -r endpoint pid dir _cwd startt _rest <"$f" || true
    # "running" is not proof of life: a worker killed with the session leaves
    # the index saying running forever, and its broker with it. Require a live
    # worker process too, or the leak this whole sidecar exists to prevent just
    # moves to the crash path.
    meta="$(crew_job_meta "$job")"
    IFS=$'\037' read -r mfound status _mthread _mcwd _mmodel _meffort _mwrite _mnewest _mturn jobpid _mrest <<<"$meta"
    # An unreadable snapshot is usually the companion rewriting the file in
    # place, not a dead job, and reaping on it would cut a live job off for
    # good. But a crash mid-rewrite can leave it invalid forever, and skipping
    # forever leaks the broker, so count strikes and give up after a few.
    strikes_file="$f.unreadable"
    if [[ "$mfound" == "UNREADABLE" ]]; then
      # Age it by WALL CLOCK, not by sweep count: several sweeps can fire in the
      # same second (a fan-out of launches each sweeping first) and race through
      # a count while the companion is mid-rewrite, killing a live broker. The
      # file records when the record first read badly; it has to stay bad for a
      # while before we believe it.
      now="$(date +%s)"
      first="$now"
      if [[ -f "$strikes_file" ]]; then
        first="$(cat "$strikes_file" 2>/dev/null || echo "$now")"
        [[ "$first" =~ ^[0-9]+$ ]] || first="$now"
      else
        printf '%s' "$now" >"$strikes_file.tmp.$$" 2>/dev/null \
          && mv -f "$strikes_file.tmp.$$" "$strikes_file" 2>/dev/null || true
      fi
      if [[ $(( now - first )) -lt ${CREW_CODEX_UNREADABLE_SECS:-120} ]]; then
        continue
      fi
      # Unreadable continuously for the whole grace period: a crashed rewrite,
      # not a busy one. Release the broker rather than hold it forever.
    else
      rm -f "$strikes_file" 2>/dev/null || true
    fi
    if [[ "$status" == "running" || "$status" == "queued" ]]; then
      if [[ "$jobpid" =~ ^[0-9]+$ ]] && kill -0 "$jobpid" 2>/dev/null; then
        continue
      fi
    fi
    crew_kill_broker "$pid" "$dir" "$startt"
    rm -f "$f" "$f.unreadable" 2>/dev/null || true
  done
  local d
  for d in "${CREW_CODEX_BROKER_TMPDIR:-${TMPDIR:-/tmp}}"/crewb-*; do
    [[ -d "$d" ]] || continue
    if [[ -f "$d/broker.pid" ]]; then
      pid="$(cat "$d/broker.pid" 2>/dev/null || true)"
      if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
        continue
      fi
    fi
    rm -f "$d/broker.sock" "$d/broker.pid" "$d/broker.log" 2>/dev/null || true
    rmdir "$d" 2>/dev/null || true
  done
  return 0
}

# ONE cleanup path for the whole script. An unpublished broker is unreferenced,
# so anything that exits before publication must kill it. Two rules learned the
# hard way: a second `trap ... EXIT` anywhere silently replaces an earlier one,
# so there is exactly one EXIT trap and it consults state instead of capturing
# it; and a signal handler that does not exit lets bash resume, which could
# publish a sidecar naming the broker it just killed.
CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""

crew_cleanup() {
  if [[ -n "${CREW_CLEANUP_PID:-}" ]]; then
    local p="$CREW_CLEANUP_PID" d="$CREW_CLEANUP_DIR" st="$CREW_CLEANUP_START"
    CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    crew_kill_broker "$p" "$d" "$st"
  fi
  rm -f "${TMP_OUT:-}" "${TMP_ERR:-}" 2>/dev/null || true
}

crew_arm_cleanup() {
  trap 'crew_cleanup' EXIT
  trap 'crew_cleanup; exit 130' INT
  trap 'crew_cleanup; exit 143' TERM
}

# Start a broker for one job. Socket paths live under a short tmp dir because a
# unix
# socket path is capped near 108 bytes and the plugin data dir can be deep.
# Sets CREW_SPAWNED_ENDPOINT/PID/DIR/START; returns 1 on failure.
#
# Deliberately NOT called through command substitution. A subshell owns $! only
# inside itself, so between spawning and returning, the parent knows nothing to
# clean up while the broker is already alive and disowned - a TERM in that
# window left it running forever. Ownership is handed to the cleanup path on
# the line after $!, before anything that can block.
crew_spawn_job_broker() {
  local cwd="$1" dir sock pid i=0
  CREW_SPAWNED_ENDPOINT="" CREW_SPAWNED_PID="" CREW_SPAWNED_DIR="" CREW_SPAWNED_START=""
  [[ -f "$CREW_BROKER_SCRIPT" ]] || return 1
  dir="$(mktemp -d "${CREW_CODEX_BROKER_TMPDIR:-${TMPDIR:-/tmp}}/crewb-XXXXXXXX" 2>/dev/null)" || return 1
  sock="$dir/broker.sock"
  if [[ ${#sock} -ge 100 ]]; then
    rmdir "$dir" 2>/dev/null || true
    return 1
  fi
  node "$CREW_BROKER_SCRIPT" serve --endpoint "unix:$sock" --cwd "$cwd" \
    --pid-file "$dir/broker.pid" >"$dir/broker.log" 2>&1 &
  pid=$!
  CREW_CLEANUP_PID="$pid" CREW_CLEANUP_DIR="$dir" CREW_CLEANUP_START="$(crew_pid_starttime "$pid")"
  disown "$pid" 2>/dev/null || true
  while [[ $i -lt 100 ]]; do
    [[ -S "$sock" ]] && break
    kill -0 "$pid" 2>/dev/null || break
    sleep 0.1
    i=$((i + 1))
  done
  if [[ ! -S "$sock" ]]; then
    crew_kill_broker "$pid" "$dir" "$CREW_CLEANUP_START"
    CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    return 1
  fi
  CREW_SPAWNED_ENDPOINT="unix:$sock" CREW_SPAWNED_PID="$pid" CREW_SPAWNED_DIR="$dir"
  CREW_SPAWNED_START="$CREW_CLEANUP_START"
  return 0
}

# Publish ownership atomically. A truncating write can be read half-formed by a
# concurrent sweep; a rename cannot.
crew_publish_sidecar() {
  local job="$1" side tmp
  side="$(crew_sidecar "$job")"
  mkdir -p "$CREW_ARCHIVE_DIR" || return 1
  tmp="$side.tmp.$$"
  printf '%s\t%s\t%s\t%s\t%s\n' "$CREW_SPAWNED_ENDPOINT" "$CREW_SPAWNED_PID" \
    "$CREW_SPAWNED_DIR" "$PWD" "$CREW_SPAWNED_START" >"$tmp" || return 1
  mv -f "$tmp" "$side" || { rm -f "$tmp" 2>/dev/null || true; return 1; }
  return 0
}

# --resume-last resolves "newest job in this cwd" at the moment it runs, so a
# launch landing between redirect's check and its relaunch makes redirect resume
# the wrong thread - after it has already cancelled the intended one. A per-cwd
# lock closes that window for the calls that can create the race.
#
# Deliberately fails OPEN. A fleet running many jobs in one directory would be
# far worse off deadlocked than racy, so a missing flock or a wait timeout warns
# and proceeds instead of blocking the launch.
crew_lock_acquire() {
  command -v flock >/dev/null 2>&1 || return 0
  mkdir -p "$CREW_ARCHIVE_DIR" 2>/dev/null || return 0
  local key
  # md5sum is GNU; darwin ships `md5`. cksum is the last resort so the lock is
  # still per-cwd everywhere rather than silently skipped on a whole platform.
  key="$(printf '%s' "$PWD" | { md5sum 2>/dev/null || md5 2>/dev/null || cksum 2>/dev/null; } \
    | tr -cd '[:alnum:]' | cut -c1-16)" || return 0
  [[ -n "$key" ]] || return 0
  exec 9>"$CREW_ARCHIVE_DIR/.launch-$key.lock" 2>/dev/null || return 0
  if ! flock -w "${CREW_CODEX_LOCK_WAIT:-60}" 9 2>/dev/null; then
    echo "crew-codex: timed out waiting for the per-cwd launch lock; proceeding without it (a concurrent launch could race a redirect)" >&2
  fi
  return 0
}

crew_lock_release() {
  exec 9>&- 2>/dev/null || true
}

# One remover, so a sidecar and its strike file never drift apart.
crew_drop_sidecar() {
  rm -f "$(crew_sidecar "$1")" "$(crew_sidecar "$1").unreadable" 2>/dev/null || true
}

# The companion keys job state to a hash of the shell's cwd, and Claude Code
# resets the cwd between Bash calls, so a job launched from one directory is
# invisible to a call made from another. Keying stays as it is; we just refuse
# to report a live job as gone. On "not found", probe the sibling state
# directories under the same parent and name the cwd to re-run from.
crew_cwd_hint() {
  local job="$1" f jcwd
  for f in "$CLAUDE_PLUGIN_DATA"/state/*/jobs/"$job".json; do
    [[ -f "$f" ]] || continue
    jcwd="$(node -e '
      const fs = require("fs");
      try {
        const j = JSON.parse(fs.readFileSync(process.argv[1], "utf8"));
        process.stdout.write(String((j.request && j.request.cwd) || j.workspaceRoot || ""));
      } catch (e) {}
    ' "$f" 2>/dev/null || true)"
    if [[ "$jcwd" == "$PWD" ]]; then continue; fi
    if [[ -n "$jcwd" ]]; then
      printf '; job exists under cwd %s; re-run from that directory' "$jcwd"
    else
      printf '; job exists in state dir %s; re-run from the directory it was launched from' \
        "$(dirname "$(dirname "$f")")"
    fi
    return 0
  done
  return 0
}

# One read of a job's state file, as 0x1f-separated fields:
#   FOUND|MISSING|UNREADABLE, status, threadId, cwd, model, effort, write,
#   newest-or-id, turnId, pid
#
# NOT tab-separated. Tab is IFS whitespace, so bash collapses runs of it and an
# empty column silently shifts every later field left: a review job has no
# model or effort, which used to land the turn id in the wrong variable. 0x1f
# is not IFS whitespace, so empty fields survive.
#
# UNREADABLE means the job file exists but did not parse, which happens while
# the companion rewrites it in place. It is deliberately distinct from MISSING
# so the reaper never mistakes a transient read for a dead job.
crew_job_meta() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [dataDir, jobId] = process.argv.slice(1);
    const stateRoot = path.join(dataDir, "state");
    const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
    const SEP = "\u001f";
    let dirs = [];
    let sawUnreadable = false;
    try { dirs = fs.readdirSync(stateRoot); } catch { }
    for (const d of dirs) {
      const jobsDir = path.join(stateRoot, d, "jobs");
      const file = path.join(jobsDir, `${jobId}.json`);
      if (!fs.existsSync(file)) continue;
      const job = read(file);
      if (!job) { sawUnreadable = true; continue; }
      const cwd = (job.request && job.request.cwd) || job.workspaceRoot || "";
      let newest = jobId, newestAt = "";
      for (const f of fs.readdirSync(jobsDir)) {
        if (!f.endsWith(".json")) continue;
        const other = read(path.join(jobsDir, f));
        if (!other || !String(other.id || "").startsWith("task-")) continue;
        const at = String(other.createdAt || "");
        if (at > newestAt) { newestAt = at; newest = other.id; }
      }
      const req = job.request || {};
      process.stdout.write([
        "FOUND", job.status || "?", job.threadId || "", cwd,
        req.model || "", req.effort || "", req.write ? "true" : "false",
        newest === jobId ? "newest" : newest, job.turnId || "", String(job.pid || "")
      ].join(SEP));
      process.exit(0);
    }
    process.stdout.write((sawUnreadable ? "UNREADABLE" : "MISSING") + SEP.repeat(9));
  ' "$CLAUDE_PLUGIN_DATA" "$1" 2>/dev/null || printf 'UNREADABLE\037\037\037\037\037\037\037\037\037'
}

# A redirect cancels the old job and resumes its Codex thread under a NEW job
# id. An agent still awaiting the old id would otherwise read that cancellation
# as failure, so name the successor: same threadId, created later.
crew_successor() {
  node -e '
    const fs = require("fs"), path = require("path");
    const [dataDir, jobId] = process.argv.slice(1);
    const stateRoot = path.join(dataDir, "state");
    const read = (f) => { try { return JSON.parse(fs.readFileSync(f, "utf8")); } catch { return null; } };
    let dirs = [];
    try { dirs = fs.readdirSync(stateRoot); } catch { }
    for (const d of dirs) {
      const jobsDir = path.join(stateRoot, d, "jobs");
      const self = read(path.join(jobsDir, `${jobId}.json`));
      if (!self) continue;
      if (!self.threadId) process.exit(0);
      const mine = String(self.createdAt || "");
      let best = "", bestAt = "";
      for (const f of fs.readdirSync(jobsDir)) {
        if (!f.endsWith(".json") || f === `${jobId}.json`) continue;
        const other = read(path.join(jobsDir, f));
        if (!other || other.threadId !== self.threadId) continue;
        const at = String(other.createdAt || "");
        if (at > mine && at > bestAt) { bestAt = at; best = other.id; }
      }
      if (best) process.stdout.write(best);
      process.exit(0);
    }
  ' "$CLAUDE_PLUGIN_DATA" "$1" 2>/dev/null || true
}

# ---- patch: teach the installed codex plugin to accept a queued message -----
# Every user installs their own copy of codex@openai-codex, at whatever version
# they happen to be on, so we carry the fix as a patch and apply it to the tree
# we resolve rather than pinning a version. Context matching (fuzz 3) absorbs
# the line drift between plugin releases; a release that moves the code out from
# under the patch fails loudly instead of half-applying.
CREW_PATCH_FILE="${CREW_CODEX_PATCH_FILE:-$CREW_ROOT/patches/codex-plugin-queue-passthrough.patch}"

# ⚠️ -N ON EVERY patch CALL, AND BOTH DRY-RUNS MUST DISAGREE. Apple's patch
# (macOS /usr/bin/patch, 2.0-12u11) meets `-R` against an UNPATCHED tree with
# "Unreversed (or previously applied) patch detected! Ignore -R? [y]" and, with
# no tty, answers yes itself — so the reverse dry-run exits 0 on an unpatched
# install and the old first-match test said "applied". The SessionStart
# `patch --apply` then printed "already patched; nothing to do" and the patch
# was silently never applied. -N (POSIX --forward) makes both Apple and GNU
# patch refuse a reversed-looking patch instead of guessing, and requiring the
# forward and reverse dry-runs to disagree means any other tool that still
# guesses reads as stale (refuse) rather than as a false PATCHED.
crew_patch_state() {
  # applied | appliable | stale
  local rev=1 fwd=1
  patch -N -p1 -R --dry-run -s -F3 -d "$COMPANION_ROOT" -i "$CREW_PATCH_FILE" </dev/null >/dev/null 2>&1 && rev=0
  patch -N -p1 --dry-run -s -F3 -d "$COMPANION_ROOT" -i "$CREW_PATCH_FILE" </dev/null >/dev/null 2>&1 && fwd=0
  if [[ $rev -eq 0 && $fwd -ne 0 ]]; then
    echo applied
  elif [[ $fwd -eq 0 && $rev -ne 0 ]]; then
    echo appliable
  else
    echo stale
  fi
}

# ---- the archive sanitizer, shared by `await` and `sanitize-archive` ------
# ONE copy on purpose. When this lived inline in the await path only, the
# migration sweep would have needed a second implementation, and the two
# would have drifted into disagreeing about what is safe to keep.
# Contract: reads a `result --json` payload on stdin; writes a sanitized
# $CREW_META_OUT; if $CREW_RESULT_OUT is set, sanitizes $CREW_RESULT_IN into
# it. Idempotent — re-running it over an already-clean archive is a no-op.
read -r -d '' CREW_SANITIZER_PY <<'CREW_SANITIZER_EOF' || true
import hashlib, json, os, re, sys, tempfile

JOB_ID = os.environ.get("CREW_META_JOB_ID", "")
# A TASK summary is shorten(prompt) — prompt text wearing a routing-looking
# name. A REVIEW summary is the model finding summary: output, not input, and
# worth keeping. The job-id prefix is the discriminator crew-codex already has.
# ⚠️ INVERTED DELIBERATELY: keep the summary only for job kinds KNOWN to put
# model output there, rather than dropping it only for job kinds known to put
# input there. `review-` summaries are the model's finding summary; `task-`
# summaries are shorten(prompt, 96). A future vendor job kind under any third
# prefix is unknown, and unknown has to mean redacted — the old
# `startswith("task-")` test let exactly that leak silently, which is the
# failure mode this whole rewrite exists to remove.
KEEP_SUMMARY = JOB_ID.startswith("review-")
DROP_SUMMARY = not KEEP_SUMMARY

# ⚠️ MARKER TRUST IS A PRIVILEGE, NOT A PROPERTY OF THE STRING. A value that
# looks like something an earlier pass wrote is only believable when the input
# itself came from an earlier pass. `sanitize-archive` re-reads its OWN output
# and sets this; the live `await` path reads the companion, whose payload is
# user-controlled end to end, and never sets it. Without that separation a
# prompt that is exactly a canonical marker survives verbatim — and idempotence
# is the only thing marker trust was ever needed for.
TRUST_MARKERS = os.environ.get("CREW_TRUST_MARKERS") == "1"


# ⚠️ EVERY structural test below compares the key EXACTLY. There is deliberately
# no normalization step. An earlier version lowercased and stripped
# non-alphanumerics first, which felt defensive and was the opposite: under a
# DENYLIST normalization tightens (more spellings caught), but under an
# ALLOWLIST it can only loosen. `r-e-s-u-l-t` normalized to `result` and took
# the verbatim-output branch; `j-o-b` normalized to `job`; `t-h-r-e-a-d-I-d`
# and `m-o-d-e-l` normalized into the metadata and request allowlists and kept
# short secrets there. Nothing in the payload path spells these keys any other
# way, and a vendor that starts to must fail CLOSED — an over-redacted archive
# is a bug report, an under-redacted one is a disclosure nobody notices. A
# genuine vendor alias gets added to these sets by hand, deliberately.

# ---- the structural allowlist ----------------------------------------------
# Ground truth, from a real archived payload:
#   payload      = {job: {...}, storedJob: {...}}
#   job/storedJob= ids, timings, status, routing, request, result, rendered
#   request      = cwd base scope model effort focusText pluginRoot ... prompt
#
# The rule is POSITIONAL: a key is recognized by WHERE it sits, and anything
# unrecognized is redacted regardless of its length or its name. The predecessor
# of this design decided by name instead, and leaked three ways that share one
# root — a `*prompt`/`*focusText` DENYLIST cannot survive a vendor rename; an
# output allowlist matched at ANY depth let a nested key called `result` carry
# anything; and a 512-char length guard as the catch-all let every SHORT secret
# — a token, a hostname, a bearer header — walk straight through. Unknown is now
# redacted, and new vendor fields fail CLOSED until someone adds them here.

# Level 1 — the payload root. Only these two hold a job.
TOP_LEVEL_JOB_KEYS = {"job", "storedJob"}
# Level 2 — inside job/storedJob. The ONLY preserved output subtrees, and only
# at this exact depth. A key named `result` nested anywhere else is not an
# output boundary and gets no privileges from its name.
OUTPUT_SUBTREE_KEYS = {"result", "rendered"}

# Level 2 — routing/metadata worth keeping. Kept, but type-checked as scalars
# and length-capped as a SECONDARY bound: the allowlist is the defence, the cap
# only stops a recognized field from becoming a smuggling channel.
# Deliberately absent: `title`, an unconstrained string whose contents this
# script cannot predict — the id and kind already say what the job was.
ALLOWED_META_KEYS = {
    "id", "kind", "kindLabel", "jobClass", "status", "phase", "pid",
    "createdAt", "updatedAt", "startedAt", "completedAt", "reapedAt",
    "cancelledAt", "elapsed", "exitCode", "threadId", "turnId", "sessionId",
    "dispatchedBy", "model", "effort", "effortRequested", "effortEffective",
    "codexPluginVersion", "workspaceRoot", "logFile", "cwd", "base",
    "background", "reapReason",
    # `write` is a plain boolean the companion really emits
    # (codex-companion.mjs:567) and it is the only record of whether a task ran
    # write-enabled — worth auditing, and it cannot carry content.
    "write",
}

# Level 3 — inside a request. Routing only; values are scalars by the same rule.
# Deliberately absent, though the vendor sends them: `scope` and `title`. Both
# are unconstrained strings, and neither is worth an archive leak.
ALLOWED_REQUEST_KEYS = {
    "cwd", "base", "model", "effort", "effortRequested", "effortEffective",
    "pluginRoot", "pluginVersion", "kind", "jobClass", "resumeLast", "sandbox",
    "approval", "background", "json", "wait", "promptFile", "threadId",
    "turnId", "sessionId", "dispatchedBy", "workspaceRoot",
    # Emitted by buildTaskRequest (codex-companion.mjs:604): a boolean and an id.
    "write", "jobId",
}

MAX_METADATA_CHARS = 512

# The prompt-derived summary strings to strip out of preserved output, filled in
# from the payload once it is parsed. Empty unless DROP_SUMMARY applies.
#
# ⚠️ SOURCED FROM `storedJob` ONLY, and this is not a stylistic choice. The two
# summaries in a completed payload have OPPOSITE provenance, verified against
# codex 1.0.6:
#   storedJob.summary — `writeJobFile(..., {...runningRecord, ...})`
#     (tracked-jobs.mjs:155) keeps the DISPATCH-time record, whose summary is
#     `shorten(prompt)` (codex-companion.mjs:552). This is the input. It is the
#     needle.
#   job.summary — `upsertJob(..., summary: execution.summary)`
#     (tracked-jobs.mjs:174), and execution.summary is
#     `firstMeaningfulLine(rawOutput, ...)` (codex-companion.mjs:525). This is
#     MODEL OUTPUT, and it is by construction a line that also appears inside
#     `result`/`rendered`.
# Using job.summary as a needle therefore does not redact a prompt — it deletes
# the first line of the answer out of the preserved output subtree, in every
# completed task. The archive exists to keep that text.
SUMMARY_STRINGS = []

# ⚠️ ANCHORED with fullmatch and ASCII-only. A prefix test here is a redaction
# bypass, and `\d` without re.ASCII matches Devanagari digits, so a crafted
# "<redacted: ६ chars>" would read as canonical. fullmatch (not match) also
# denies the trailing-newline slack `$` allows.
MARKER_RE = re.compile(r"<redacted(: \d+ (chars|item\(s\)|key\(s\)))?>", re.ASCII)


def is_marker(value):
    return isinstance(value, str) and MARKER_RE.fullmatch(value) is not None


def marker(value):
    # Shape only, never content — the same contract the .dispatch.json argv
    # redaction uses, so the two sidecars cannot disagree about what is safe.
    if value is None:
        return None
    if TRUST_MARKERS and is_marker(value):
        # Already our own marker, and the input is our own output. Re-markering
        # would rewrite the recorded length to the length of the marker itself,
        # so a second sweep over a clean archive has to be a no-op.
        return value
    if isinstance(value, str):
        return "<redacted: %d chars>" % len(value)
    if isinstance(value, list):
        return "<redacted: %d item(s)>" % len(value)
    if isinstance(value, dict):
        return "<redacted: %d key(s)>" % len(value)
    return "<redacted>"


def keep_scalar(value):
    # A recognized metadata name promises a SHAPE as well as a meaning. A dict
    # or a list under `status` is not the field this allowlist vouched for.
    if value is None or isinstance(value, (bool, int, float)):
        return value
    if isinstance(value, str) and len(value) <= MAX_METADATA_CHARS:
        return value
    return marker(value)


def scrub_request(value):
    # A request that is not a mapping is not a shape this can reason about, so
    # it goes whole.
    if not isinstance(value, dict):
        return marker(value)
    return dict(
        (k, keep_scalar(v) if k in ALLOWED_REQUEST_KEYS else marker(v))
        for k, v in value.items()
    )


def redact_summary_in_text(value):
    """Replace a prompt-derived summary where it appears STRUCTURALLY — as a
    whole line, or as the value of a `Summary: ` field — never as a bare
    substring anywhere in the text.

    ⚠️ The anchoring is the whole point. A bare `str.replace` cuts both ways: a
    two-character summary rewrites every occurrence of those two characters
    inside a legitimate answer, and the obvious mitigation (skip short
    summaries) leaves a short prompt secret in the archive verbatim. Anchoring
    removes the trade — the summary is redacted wherever the renderer actually
    put it, at any length, and text that merely contains those characters is
    left alone. Prompt text the model echoed elsewhere in its own output is out
    of scope by design and `request.prompt` is redacted regardless."""
    lines = value.split("\n")
    for i, line in enumerate(lines):
        for summary in SUMMARY_STRINGS:
            marked = "<redacted: %d chars>" % len(summary)
            if line.strip() == summary:
                lines[i] = line.replace(summary, marked)
            elif line.startswith("Summary: ") and line[9:].strip() == summary:
                lines[i] = "Summary: " + marked
    return "\n".join(lines)


def scrub_output(value):
    """Preserved verbatim — with ONE anchored substitution. When the summary is
    prompt-derived, `renderStoredJobResult` can embed it in the rendered text,
    and the .result.txt path below strips it from exactly that string. Doing it
    there and not here would mean the archive redacts a prompt in the file a
    human reads and keeps it in the file beside it. Structure, types and every
    other character are untouched."""
    if not SUMMARY_STRINGS:
        return value
    if isinstance(value, str):
        return redact_summary_in_text(value)
    if isinstance(value, dict):
        return dict((k, scrub_output(v)) for k, v in value.items())
    if isinstance(value, list):
        return [scrub_output(v) for v in value]
    return value


def scrub_job(value):
    if not isinstance(value, dict):
        return marker(value)
    out = {}
    for k, v in value.items():
        if k == "request":
            out[k] = scrub_request(v)
        elif k in OUTPUT_SUBTREE_KEYS:
            # The reason the archive exists. Verbatim, arbitrarily long, and
            # only here — this is the one place no length bound applies.
            out[k] = scrub_output(v)
        elif k == "summary":
            # Capped like any other kept metadata even when it is output: an
            # allowlisted NAME is not a promise about content, and the full
            # finding text lives in `result`/`rendered` regardless.
            out[k] = keep_scalar(v) if KEEP_SUMMARY else marker(v)
        elif k in ALLOWED_META_KEYS:
            out[k] = keep_scalar(v)
        else:
            out[k] = marker(v)
    return out


def scrub_payload(value):
    out = {}
    for k, v in value.items():
        if k in TOP_LEVEL_JOB_KEYS:
            out[k] = scrub_job(v)
        else:
            out[k] = marker(v)
    return out


def write_atomic(path, text):
    # ⚠️ Staged through mkstemp in the DESTINATION directory, not at
    # `path + ".tmp"`. This is the same reasoning `sanitize-archive`'s commit
    # helper uses, and it applies identically here: the archive directory can be
    # group- or world-writable, `path + ".tmp"` is perfectly predictable, and a
    # plain open(..., "w") follows a symlink planted there. mkstemp creates the
    # file O_EXCL under an unguessable name, so there is nothing to precreate.
    directory = os.path.dirname(path) or "."
    fd, tmp_path = tempfile.mkstemp(prefix=".crew-w.", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(text)
        os.replace(tmp_path, path)
    except BaseException:
        # Never leave staging residue behind: it is unsanitized-adjacent bytes
        # in the one directory built to outlive the vendor cleanup.
        try:
            os.unlink(tmp_path)
        except OSError:
            pass
        raise


raw = sys.stdin.read()
try:
    payload = json.loads(raw)
except ValueError:
    payload = None
WITHHELD_REASON = ("companion result --json was empty or unparseable; the raw "
                   "payload is NOT archived because it can carry unredacted "
                   "prompt text")

# ⚠️ A payload holding neither `job` nor `storedJob` is not a payload this script
# can walk, and that includes the withheld record it writes itself. It is
# REGENERATED from scratch rather than copied through — which is what makes a
# second sweep byte-identical without this script ever having to trust a scalar
# it read back off disk. The previous version recognized `jobId`/`crewArchive`/
# `reason` at the top level under marker trust, and `sanitize-archive` sets
# marker trust for EVERY file it sweeps, including the legacy unsanitized ones
# it exists to migrate — so a legacy `{"reason": "<secret>"}` was preserved
# verbatim by the very command meant to clean it. Nothing is trusted now.
if not isinstance(payload, dict) or not (
        isinstance(payload.get("job"), dict)
        or isinstance(payload.get("storedJob"), dict)):
    payload = None
    record = {
        "jobId": JOB_ID,
        "crewArchive": "withheld",
        "reason": WITHHELD_REASON,
    }
else:
    if DROP_SUMMARY:
        _node = payload.get("storedJob")
        if isinstance(_node, dict):
            _summary = _node.get("summary")
            # A marker is never a needle. Under marker trust a previous pass's
            # `<redacted: N chars>` would otherwise be used as a search string
            # and rewrite every matching marker inside preserved output, which
            # breaks idempotence on the second sweep.
            # ⚠️ NO LENGTH FLOOR. There was one, and it was a mistake: it
            # existed because the replacement was a bare substring sweep, where
            # a two-character summary ("ls") rewrites every "ls" inside the
            # answer. Exempting short summaries fixed the shredding by
            # preserving short PROMPTS verbatim — `summary: "PIN=123456"` echoed
            # into the output stayed in the archive in full. That trades
            # confidentiality for fidelity, which is the wrong way round.
            # The replacement is anchored instead (see redact_summary_in_text),
            # so length stops mattering in either direction.
            if isinstance(_summary, str) and _summary.strip() and not is_marker(_summary):
                SUMMARY_STRINGS.append(_summary)
    record = scrub_payload(payload)

out = os.environ["CREW_META_OUT"]
write_atomic(out, json.dumps(record, indent=2))

# ---- .result.txt: the SAME leak, in the file nobody was looking at ----------
# renderStoredJobResult falls back to printing "Summary: <job.summary>" when a
# job stored no output at all (render.mjs:390), and a TASK summary is
# shorten(prompt, 96) (companion:552). So a cancelled or failed task archived
# the first 96 characters of its prompt in plain text, directly beside the
# .meta.json this script had just carefully cleaned of exactly that string.
# A REVIEW summary is the model finding summary — output, not input — and
# survives, the same discriminator DROP_SUMMARY already uses above.
result_in = os.environ.get("CREW_RESULT_IN", "")
result_out = os.environ.get("CREW_RESULT_OUT", "")
sentinel_out = os.environ.get("CREW_SENTINEL_OUT", "")
if result_out:
    # ⚠️ Drop any existing sentinel FIRST. A sentinel that outlives the result
    # it vouches for is worse than none: the caller's fail-closed stub would
    # see "verified" and preserve an unverified file.
    if sentinel_out:
        try:
            os.unlink(sentinel_out)
        except OSError:
            pass
    try:
        with open(result_in, "r", encoding="utf-8", errors="replace") as handle:
            text = handle.read()
    except OSError:
        text = None
    if text is None:
        text = "crew-codex: result withheld — the rendered result could not be read for sanitization.\n"
    elif DROP_SUMMARY:
        # Exact substring first. It holds whichever branch emitted the
        # summary, so a vendor moving the field does not reopen this, and
        # it cannot over-redact model output that merely happens to begin a
        # line with "Summary: ".
        # storedJob only, for the reason spelled out at SUMMARY_STRINGS: a
        # completed job.summary is the first line of the model's own answer,
        # and replacing it here mutilates the rendered result. Anchored, for the
        # reason spelled out at redact_summary_in_text.
        if SUMMARY_STRINGS:
            text = redact_summary_in_text(text)
        # Skeleton rule, for the case the payload was unparseable and the
        # exact string is therefore unknowable. Scoped to the vendor
        # fallback render so a model answer is never touched.
        lines = text.split("\n")
        if (len(lines) >= 4 and lines[0].startswith("# ") and lines[1] == ""
                and lines[2].startswith("Job: ") and lines[3].startswith("Status: ")):
            for i, line in enumerate(lines):
                # ⚠️ Skip a value this pass (or an earlier one) already wrote.
                # The rule measures what it replaces, so re-measuring its own
                # marker rewrites 30 to 20 and the recorded length stops
                # describing the text that was removed. Only reachable now that
                # the exact-substring pass no longer always fires first — the
                # sweep re-reads its own output, so this has to be idempotent
                # on its own terms, not by luck of ordering.
                if line.startswith("Summary: ") and not is_marker(line[9:].strip()):
                    lines[i] = "Summary: <redacted: %d chars>" % len(line[9:])
            text = "\n".join(lines)
    write_atomic(result_out, text)
    # ---- provenance sentinel ------------------------------------------------
    # Written LAST, and only over a result this run actually produced. It lets
    # the caller tell "a sanitized result is already on disk" from "a legacy
    # unsanitized one is". Without it the fail-closed stub is unconditional,
    # and a transient sanitizer failure DESTROYS a good archived result. The
    # digest is content-addressed and carries no timestamp, so re-running the
    # sweep over a clean archive rewrites nothing.
    if sentinel_out:
        digest = hashlib.sha256(text.encode("utf-8")).hexdigest()
        write_atomic(sentinel_out, json.dumps(
            {"jobId": JOB_ID, "sha256": digest, "bytes": len(text.encode("utf-8"))},
            indent=2))
CREW_SANITIZER_EOF

# ---- sentinel verification: "is the archived result one WE sanitized?" ------
# Content-addressed on purpose. A bare "the file exists" flag would keep a
# legacy unsanitized render alive forever, and a timestamp would make the
# sweep non-idempotent. Any failure to read either file is a NO — the caller
# is deciding whether it may skip a fail-closed overwrite, so an unreadable
# sentinel has to mean "not verified", not "assume the best".
crew_sentinel_ok() {
  python3 - "$1" "$2" <<'CREW_SENTINEL_EOF' 2>/dev/null
import hashlib, json, sys
try:
    with open(sys.argv[1], encoding="utf-8") as handle:
        record = json.load(handle)
    with open(sys.argv[2], "rb") as handle:
        data = handle.read()
except (OSError, ValueError):
    raise SystemExit(1)
ok = (isinstance(record, dict)
      and isinstance(record.get("sha256"), str)
      and record["sha256"] == hashlib.sha256(data).hexdigest())
raise SystemExit(0 if ok else 1)
CREW_SENTINEL_EOF
}

if [[ "${1:-}" == "--resolve" ]]; then
  echo "$COMPANION"
  exit 0
fi

if [[ "${1:-}" == "patch" ]]; then
  shift
  ACTION="status"
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply) ACTION="apply"; shift ;;
      --revert) ACTION="revert"; shift ;;
      --status) ACTION="status"; shift ;;
      *) shift ;;
    esac
  done

  if ! command -v patch >/dev/null 2>&1; then
    echo "crew-codex: patch(1) is required to manage the codex plugin patch" >&2
    exit 1
  fi
  if [[ ! -f "$CREW_PATCH_FILE" ]]; then
    echo "crew-codex: patch file missing at $CREW_PATCH_FILE" >&2
    exit 1
  fi

  PLUGIN_VERSION="$(basename "$COMPANION_ROOT")"
  state="$(crew_patch_state)"

  case "$ACTION" in
    status)
      case "$state" in
        applied)   echo "PATCHED | codex plugin $PLUGIN_VERSION at $COMPANION_ROOT"; exit 0 ;;
        appliable) echo "UNPATCHED | codex plugin $PLUGIN_VERSION applies cleanly; run: crew-codex patch --apply"; exit 10 ;;
        *)         echo "crew-codex: patch does not apply to codex plugin $PLUGIN_VERSION at $COMPANION_ROOT — the upstream code moved; re-cut patches/codex-plugin-queue-passthrough.patch" >&2; exit 1 ;;
      esac
      ;;
    apply)
      if [[ "$state" == "applied" ]]; then
        echo "PATCHED | codex plugin $PLUGIN_VERSION was already patched; nothing to do"
        exit 0
      fi
      if [[ "$state" != "appliable" ]]; then
        echo "crew-codex: patch does not apply to codex plugin $PLUGIN_VERSION at $COMPANION_ROOT — refusing to half-apply; re-cut the patch against this version" >&2
        exit 1
      fi
      # ⚠️ -i FILE, never stdin, plus </dev/null. The </dev/null guard keeps
      # any patch(1) prompt from waiting on a tty, and bash keeps only the LAST
      # stdin redirect — so the patch goes in with -i, where the guard cannot
      # displace it (`<FILE </dev/null` would feed patch an empty stdin).
      if ! patch -N -p1 -s -F3 -b --suffix=.crew-orig -d "$COMPANION_ROOT" -i "$CREW_PATCH_FILE" </dev/null; then
        echo "crew-codex: applying the patch failed partway; restore from the .crew-orig backups in $COMPANION_ROOT" >&2
        exit 1
      fi
      if [[ "$(crew_patch_state)" != "applied" ]]; then
        echo "crew-codex: patch reported success but verification failed; inspect $COMPANION_ROOT" >&2
        exit 1
      fi
      echo "PATCHED | codex plugin $PLUGIN_VERSION | backups: *.crew-orig | brokers already running keep the old code until their job ends"
      exit 0
      ;;
    revert)
      # ⚠️ Only a CLEANLY unpatched tree is "nothing to revert". A half-applied
      # install (one target patched, one not) reads as stale; reporting it
      # UNPATCHED with exit 0 told the operator the tree was clean while the
      # patched hunks stayed in place.
      if [[ "$state" == "appliable" ]]; then
        echo "UNPATCHED | codex plugin $PLUGIN_VERSION is not patched; nothing to revert"
        exit 0
      fi
      if [[ "$state" != "applied" ]]; then
        echo "crew-codex: codex plugin $PLUGIN_VERSION at $COMPANION_ROOT is in state '$state' (neither cleanly patched nor cleanly unpatched — possibly half-applied); nothing was changed. Restore from the *.crew-orig backups in $COMPANION_ROOT" >&2
        exit 1
      fi
      if ! patch -N -p1 -R -s -F3 -d "$COMPANION_ROOT" -i "$CREW_PATCH_FILE" </dev/null; then
        echo "crew-codex: reverting the patch failed; restore from the .crew-orig backups in $COMPANION_ROOT" >&2
        exit 1
      fi
      echo "UNPATCHED | codex plugin $PLUGIN_VERSION restored"
      exit 0
      ;;
  esac
fi

# ---- steer: interject into the turn a job is running right now --------------
# The primary way to correct a job in flight. Unlike interrupt, this stops
# nothing: the tool call in progress finishes, and the model reads the message
# at its next step, so it can change course before it has done all the wrong
# work. Verified: a job told to stop at file 9 of 20 read the message and
# stopped at 16, reporting "I had created exactly 16 iota files when I read
# your message." Requires the codex plugin patch (crew-codex patch --apply).
if [[ "${1:-}" == "steer" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: steer needs a job id — usage: crew-codex steer <job-id> \"<message>\"" >&2
    exit 2
  fi
  shift
  MESSAGE="$*"
  if [[ -z "$MESSAGE" ]]; then
    echo "crew-codex: steer needs the message text — usage: crew-codex steer <job-id> \"<message>\"" >&2
    exit 2
  fi

  # Name EVERY field and keep a trailing catch-all: `read` hands the unconsumed
  # remainder, tab separators included, to its last variable, so a short list
  # silently glues later fields onto it.
  IFS=$'\037' read -r jfound jstatus jthread jcwd _m _e _w _n jturn _jpid _rest <<<"$(crew_job_meta "$JOB_ID")"

  if [[ "$jfound" != "FOUND" ]]; then
    echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
    exit 2
  fi
  if [[ -n "$jcwd" && "$jcwd" != "$PWD" ]]; then
    echo "crew-codex: job $JOB_ID belongs to cwd $jcwd; re-run steer from that directory" >&2
    exit 2
  fi
  if [[ "$jstatus" != "running" ]]; then
    echo "crew-codex: job $JOB_ID is $jstatus, so there is no live turn to steer; use crew-codex queue to leave a message for its next turn" >&2
    exit 2
  fi
  if [[ -z "$jthread" || -z "$jturn" ]]; then
    echo "crew-codex: job $JOB_ID has not started a turn yet; try again in a moment" >&2
    exit 2
  fi

  steer_ep="$(crew_job_endpoint "$JOB_ID")"
  if [[ -n "$steer_ep" ]]; then
    export CODEX_COMPANION_APP_SERVER_ENDPOINT="$steer_ep"
  else
    echo "crew-codex: no broker recorded for $JOB_ID (launched before per-job brokers, or by another tool); it may be running on a private app-server that nothing can reach" >&2
  fi

  src=0
  steered="$(printf '%s' "$MESSAGE" | node "$CREW_ROOT/lib/appserver-cli.mjs" \
    steer "$COMPANION_ROOT" "$PWD" "$jthread" "$jturn" 2>&1)" || src=$?
  if [[ $src -ne 0 ]]; then
    echo "crew-codex: steering failed: $steered" >&2
    if grep -qiE "busy|experimentalApi" <<<"$steered"; then
      echo "crew-codex: that is the unpatched codex plugin refusing to steer — run: crew-codex patch --apply" >&2
    elif grep -qiE "no active turn|expected active turn|ExpectedTurnMismatch|not steerable" <<<"$steered"; then
      echo "crew-codex: the turn ended or moved on; use crew-codex queue to leave a message for the next one" >&2
    fi
    exit 1
  fi

  echo "STEERED $JOB_ID | thread $jthread | turn $jturn | the agent reads it at its next step; its reply lands in this job's own result"
  exit 0
fi

# ---- queue: say something to a running job without stopping it --------------
# The non-destructive way to change a job's course. The message waits; the
# agent reads it when it finishes the turn it is already running, so a job
# halfway through a multi-file edit lands that edit first. This is how a person
# redirects an agent, and it is the default: `redirect` interrupts, and an
# interrupt mid-edit leaves the tree half-written.
# Requires the codex plugin patch (crew-codex patch --apply).
if [[ "${1:-}" == "queue" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: queue needs a job id — usage: crew-codex queue <job-id> \"<message>\"" >&2
    exit 2
  fi
  shift
  MESSAGE="$*"
  if [[ -z "$MESSAGE" ]]; then
    echo "crew-codex: queue needs the message text — usage: crew-codex queue <job-id> \"<message>\"" >&2
    exit 2
  fi

  IFS=$'\037' read -r jfound jstatus jthread jcwd _jmodel _jeffort _jwrite _jnewest _jturn _jpid _rest <<<"$(crew_job_meta "$JOB_ID")"

  if [[ "$jfound" != "FOUND" ]]; then
    echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
    exit 2
  fi
  if [[ -n "$jcwd" && "$jcwd" != "$PWD" ]]; then
    echo "crew-codex: job $JOB_ID belongs to cwd $jcwd; re-run queue from that directory" >&2
    exit 2
  fi
  if [[ -z "$jthread" ]]; then
    echo "crew-codex: job $JOB_ID has no Codex thread yet; wait for it to start before queueing" >&2
    exit 2
  fi
  if [[ "$jstatus" != "running" && "$jstatus" != "queued" ]]; then
    echo "crew-codex: job $JOB_ID is $jstatus, so a queued message would never be read; resume the thread instead (crew-codex redirect, or task --resume-last)" >&2
    exit 2
  fi

  queue_ep="$(crew_job_endpoint "$JOB_ID")"
  if [[ -n "$queue_ep" ]]; then
    export CODEX_COMPANION_APP_SERVER_ENDPOINT="$queue_ep"
  else
    echo "crew-codex: no broker recorded for $JOB_ID (launched before per-job brokers, or by another tool); it may be running on a private app-server that nothing can reach" >&2
  fi

  mkdir -p "$CREW_ARCHIVE_DIR"
  seq_file="$CREW_ARCHIVE_DIR/$JOB_ID.queued.txt"
  next=1
  if [[ -f "$seq_file" ]]; then
    next=$(( $(wc -l <"$seq_file") + 1 ))
  fi
  CLIENT_ID="crew-$JOB_ID-$next"

  qrc=0
  submission="$(printf '%s' "$MESSAGE" | node "$CREW_ROOT/lib/appserver-cli.mjs" \
    queue-add "$COMPANION_ROOT" "$PWD" "$jthread" "$CLIENT_ID" 2>&1)" || qrc=$?
  if [[ $qrc -ne 0 ]]; then
    echo "crew-codex: queueing failed: $submission" >&2
    if grep -qiE "busy|experimentalApi" <<<"$submission"; then
      echo "crew-codex: that is the unpatched codex plugin refusing a queued message — run: crew-codex patch --apply" >&2
    fi
    exit 1
  fi

  # ⚠️ The MESSAGE never goes in. Upstream appends it verbatim, but $CREW_ARCHIVE_DIR
  # is the directory built to OUTLIVE the vendor's session cleanup — the same
  # archive .dispatch.json redacts positionals out of and the sanitizer scrubs
  # .meta.json / .result.txt for. A queued message is free-form operator text and
  # carries exactly what those two redact: incident logs, hostnames, credentials.
  # Only the id and the SHAPE are recorded. Nothing downstream needs the text:
  # `await` reads this file for its LINE COUNT (how many replies to expect) and
  # matches replies by client id, never by message body.
  printf '%s\t<redacted: %s chars>\n' "$CLIENT_ID" "${#MESSAGE}" >>"$seq_file"
  echo "QUEUED $JOB_ID | thread $jthread | id $CLIENT_ID | the agent reads it when its current turn ends; keep awaiting"
  exit 0
fi

# ---- redirect: put a running job onto new instructions, keeping its thread --
# Codex itself can steer a turn in flight (turn/steer), but the codex plugin's
# broker forwards exactly ONE method while a turn streams: turn/interrupt
# (app-server-broker.mjs). So mid-turn steering is not reachable from here, and
# `codex queue` writes to a queue a crew job never drains. What IS reachable is
# interrupt-then-resume: cancel stops the live turn, and --resume-last picks the
# same Codex thread back up with the work so far still in context. Verified: a
# job cancelled after 4 of 30 files resumed knowing it had made exactly 4.
if [[ "${1:-}" == "redirect" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: redirect needs a job id — usage: crew-codex redirect <job-id> [--model <m>] [--effort <e>] \"<instruction>\"" >&2
    exit 2
  fi
  shift

  R_MODEL="" R_EFFORT="" INSTRUCTION=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --model) R_MODEL="${2:-}"; shift 2 ;;
      --effort) R_EFFORT="${2:-}"; shift 2 ;;
      *) INSTRUCTION="${INSTRUCTION:+$INSTRUCTION }$1"; shift ;;
    esac
  done

  if [[ -z "$INSTRUCTION" ]]; then
    echo "crew-codex: redirect needs the new instruction text — usage: crew-codex redirect <job-id> \"<instruction>\"" >&2
    exit 2
  fi

  # --resume-last resumes the newest task thread for THIS cwd, so the job being
  # redirected has to be that newest job or we would silently steer another one.
  IFS=$'\037' read -r jfound jstatus jthread jcwd jmodel jeffort jwrite jnewest _jturn _jpid _rest <<<"$(crew_job_meta "$JOB_ID")"

  if [[ "$jfound" != "FOUND" ]]; then
    echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)$(crew_cwd_hint "$JOB_ID")" >&2
    exit 2
  fi
  if [[ -n "$jcwd" && "$jcwd" != "$PWD" ]]; then
    echo "crew-codex: job $JOB_ID belongs to cwd $jcwd; re-run redirect from that directory so --resume-last targets its thread" >&2
    exit 2
  fi
  if [[ "$jnewest" != "newest" ]]; then
    echo "crew-codex: job $JOB_ID is not the newest task job for this cwd ($jnewest is); redirect resumes the newest thread, so cancel and re-dispatch explicitly instead" >&2
    exit 2
  fi

  # Order matters. Cancelling destroys the old turn, so nothing irreversible
  # happens until the successor's broker exists: allocating it afterwards meant
  # an allocation failure left the turn destroyed AND the successor on an
  # unreachable private app-server, the exact failure this release prevents.
  old_ep="$(crew_job_endpoint "$JOB_ID")"
  RED_PID="" RED_DIR="" RED_EP="" RED_START=""
  if [[ -z "${CREW_CODEX_NO_JOB_BROKER:-}" ]]; then
    if crew_spawn_job_broker "$PWD"; then
      RED_EP="$CREW_SPAWNED_ENDPOINT" RED_PID="$CREW_SPAWNED_PID"
      RED_DIR="$CREW_SPAWNED_DIR" RED_START="$CREW_SPAWNED_START"
      crew_arm_cleanup
    else
      echo "crew-codex: could not start a broker for the successor; leaving $JOB_ID running rather than cancelling it and relaunching somewhere unreachable" >&2
      exit 1
    fi
  fi

  # Hold the per-cwd lock from here until the successor exists, so no launch can
  # slip in and become "newest" between the check and the relaunch.
  crew_lock_acquire

  # Re-check under the lock, right before the destructive step.
  IFS=$'\037' read -r _rf _rs _rt _rc _rm _re _rw rnewest _rturn _rpid _rrest <<<"$(crew_job_meta "$JOB_ID")"
  if [[ "$rnewest" != "newest" ]]; then
    echo "crew-codex: $JOB_ID stopped being the newest job for this cwd ($rnewest launched since); not cancelling it, re-run the redirect against the newest job" >&2
    crew_lock_release
    exit 2
  fi

  if [[ "$jstatus" == "running" || "$jstatus" == "queued" ]]; then
    crc=0
    cancel_out="$(CODEX_COMPANION_APP_SERVER_ENDPOINT="${old_ep:-${CODEX_COMPANION_APP_SERVER_ENDPOINT:-}}" \
      node "$COMPANION" cancel "$JOB_ID" 2>&1)" || crc=$?
    if [[ $crc -ne 0 ]]; then
      echo "crew-codex: cancelling $JOB_ID failed, so the old turn may still be running; refusing to start a second one on the same thread" >&2
      echo "$cancel_out" >&2
      exit 1
    fi
    echo "crew-codex: interrupted $JOB_ID (was $jstatus)"
  else
    echo "crew-codex: $JOB_ID was already $jstatus; resuming its thread"
  fi

  # The old job is finished, so retire its broker and give the successor its
  # own. Without this the resumed job falls back to a private app-server and is
  # unreachable, which is the whole failure this release exists to fix.
  old_side="$(crew_sidecar "$JOB_ID")"
  if [[ -f "$old_side" ]]; then
    IFS=$'\t' read -r _oe obpid obdir _ocwd obstart _orest <"$old_side" || true
    crew_kill_broker "$obpid" "$obdir" "$obstart"
    crew_drop_sidecar "$JOB_ID"
  fi
  unset CODEX_COMPANION_APP_SERVER_ENDPOINT
  if [[ -n "$RED_EP" ]]; then
    export CODEX_COMPANION_APP_SERVER_ENDPOINT="$RED_EP"
  fi

  relaunch=(task --background --resume-last)
  [[ "$jwrite" == "true" ]] && relaunch+=(--write)
  use_model="${R_MODEL:-$jmodel}"
  use_effort="${R_EFFORT:-$jeffort}"
  [[ -n "$use_model" ]] && relaunch+=(--model "$use_model")
  [[ -n "$use_effort" ]] && relaunch+=(--effort "$use_effort")
  relaunch+=("$INSTRUCTION")

  rrc=0
  relaunch_out="$(node "$COMPANION" "${relaunch[@]}" 2>&1)" || rrc=$?
  echo "$relaunch_out"
  if [[ $rrc -ne 0 ]]; then
    echo "crew-codex: redirect relaunch failed (exit $rrc); the thread is intact — resume it manually with --resume-last" >&2
    exit $rrc
  fi

  NEW_ID="$(grep -oE '\b(task|review)-[a-z0-9]+-[a-z0-9]+\b' <<<"$relaunch_out" | head -1 || true)"
  if [[ -n "$RED_PID" ]]; then
    if [[ -n "$NEW_ID" ]]; then
      if ! crew_publish_sidecar "$NEW_ID"; then
        # The successor is already running; killing its broker would strand it.
        echo "crew-codex: successor $NEW_ID started but its broker could not be recorded; steer/queue will not route to it (endpoint $RED_EP)" >&2
      fi
      RED_PID="" CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    else
      crew_kill_broker "$RED_PID" "$RED_DIR" "$RED_START"
      RED_PID="" CREW_CLEANUP_PID="" CREW_CLEANUP_DIR="" CREW_CLEANUP_START=""
    fi
  fi
  crew_lock_release
  echo "REDIRECTED $JOB_ID -> ${NEW_ID:-<unknown>} | thread ${jthread:-<pending>} | await the NEW id"
  exit 0
fi

# ---- await: poll a detached job toward terminal state, token-free ----------
# Claude Code's Bash tool caps a single call at 600s, but codex jobs run for
# hours. Each await call blocks up to --for seconds (default 540, safely under
# that cap) and prints exactly ONE line; the caller loops until it stops
# reporting RUNNING. Polling happens in-shell, so a multi-hour job costs no
# model tokens while it runs. Exit: 0 completed, 1 failed/cancelled,
# 2 job not found, 3 stale (process died silently), 4 hung (process alive but
# the job log has not moved for CREW_CODEX_HUNG_SECS — a lost model turn),
# 5 superseded by a redirect (the line names the successor), 10 still running
# (call again).
# ⚠️ 5, not upstream's 4, for SUPERSEDED — 4 has meant HUNG in this fork since
# v0.4.2 and downstream agents key a recovery protocol to it. See README.
if [[ "${1:-}" == "await" ]]; then
  shift
  JOB_ID="${1:-}"
  if [[ -z "$JOB_ID" || "$JOB_ID" == --* ]]; then
    echo "crew-codex: await needs a job id — usage: crew-codex await <job-id> [--for <seconds>]" >&2
    exit 2
  fi
  shift

  FOR_SECS=540
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --for) FOR_SECS="${2:-540}"; shift 2 ;;
      *) shift ;;
    esac
  done
  POLL_SECS="${CREW_CODEX_POLL_SECS:-5}"
  # A live pid whose job log stops moving is a hung model turn, not progress
  # (observed 2026-08-06: app-server lost the thread mid-turn — "thread not
  # found" on cancel — while the pid idled forever, log frozen 27 min). BUT
  # legitimate xhigh turns go silent for minutes mid-reasoning (>=188s observed
  # in a healthy run), so the threshold must sit far above normal silence:
  # 900s catches the real wedge in 15 min with ~5x margin over observed
  # legitimate gaps. Callers should treat exit 4 as grounds for ONE more await
  # before any destructive recovery.
  HUNG_SECS="${CREW_CODEX_HUNG_SECS:-900}"
  HUNG_POLL_SECS="${CREW_CODEX_HUNG_POLL_SECS:-30}"

  # Talk to the broker this job actually runs on, not whichever one the cwd's
  # broker.json happens to name right now.
  await_ep="$(crew_job_endpoint "$JOB_ID")"
  [[ -n "$await_ep" ]] && export CODEX_COMPANION_APP_SERVER_ENDPOINT="$await_ep"

  deadline=$(( $(date +%s) + FOR_SECS ))
  missing_streak=0
  stale_streak=0

  while :; do
    snap="$(node "$COMPANION" status "$JOB_ID" --json 2>/dev/null || true)"
    parsed="$(printf '%s' "$snap" | python3 -c '
import json, sys
try:
    j = json.load(sys.stdin)["job"]
except Exception:
    print("MISSING\t-\t-\t-\t-")
    raise SystemExit
p = j.get("progressPreview") or []
last = str(p[-1]) if p else "-"
print("\t".join([
    str(j.get("status", "?")),
    str(j.get("elapsed", "?")),
    str(j.get("logFile", "-")),
    last.replace("\t", " ")[:80],
    str(j.get("pid") or "-"),
]))
' 2>/dev/null || printf 'MISSING\t-\t-\t-\t-')"
    IFS=$'\t' read -r jstatus jelapsed jlog jlast jpid <<<"$parsed"

    case "$jstatus" in
      queued|running)
        missing_streak=0
        ;;
      completed|failed|cancelled)
        mkdir -p "$CREW_ARCHIVE_DIR"
        # The rendered text is staged PRIVATE and sanitized below, never written
        # straight to .result.txt: the vendor fallback render prints
        # "Summary: <job.summary>", and a task summary is shorten(prompt, 96)
        # (companion:552) — the exact text .meta.json is carefully cleaned of.
        # ⚠️ Staged OUTSIDE the archive, and trapped. Inside the archive it was
        # unsanitized prompt text sitting in the one directory built to OUTLIVE
        # the vendor cleanup, and a SIGTERM in the window between render and
        # sanitize left it there for good — the archive sweep does not read it,
        # so nothing would ever have found it again.
        CREW_RAW_RESULT="$(umask 077; mktemp "${TMPDIR:-/tmp}/crew-codex-result.XXXXXX")" || CREW_RAW_RESULT=""
        trap 'rm -f "$CREW_RAW_RESULT"' EXIT HUP INT TERM
        if [[ -n "$CREW_RAW_RESULT" ]]; then
          node "$COMPANION" result "$JOB_ID" >"$CREW_RAW_RESULT" 2>/dev/null || true
        fi
        # ---- queued follow-ups, captured BEFORE the sanitizer runs ---------
        # The companion closes a job at its FIRST turn/completed, so a turn
        # started from a queued message finishes outside the job record and its
        # answer would be lost. Upstream appends it to the ARCHIVED .result.txt
        # after the fact; here it goes into the PRIVATE staged render instead,
        # and for two reasons that both matter:
        #   1. it is raw model output, so it must pass through the same
        #      sanitizer as the rest of the result rather than around it, and
        #   2. the sentinel is a SHA-256 of the archived .result.txt — text
        #      appended after that hash is written makes every later
        #      crew_sentinel_ok call report the file as unrecognized, so a
        #      transient sanitizer failure would then destroy a good result.
        # Appending here keeps one sanitize pass and one hash over the whole
        # thing.
        if [[ -n "$CREW_RAW_RESULT" && -s "$CREW_ARCHIVE_DIR/$JOB_ID.queued.txt" ]]; then
          # Name every field plus a trailing catch-all: `read` hands the
          # unconsumed remainder to its last variable, so a short list silently
          # glues later fields onto it (the v0.6.1 bug, upstream).
          IFS=$'\037' read -r _qf _qs qthread _qcwd _qm _qe _qw _qn _qturn _qpid _qrest \
            <<<"$(crew_job_meta "$JOB_ID")"
          if [[ -n "$qthread" ]]; then
            # The job reports terminal the moment its FIRST turn ends, which is
            # before the queued turn has run. Wait for the replies we know were
            # queued rather than racing them, but stay bounded: a queued turn
            # can be lost if the worker tears down first.
            # Arithmetic, not a bare $(wc -l): BSD wc left-pads the count, which
            # printed "QUEUED-REPLIES 1/       1" on darwin.
            expected=$(( $(wc -l <"$CREW_ARCHIVE_DIR/$JOB_ID.queued.txt") ))
            grace_deadline=$(( $(date +%s) + ${CREW_CODEX_QUEUE_GRACE_SECS:-180} ))
            followups=""
            while :; do
              followups="$(node "$CREW_ROOT/lib/appserver-cli.mjs" followups \
                "$COMPANION_ROOT" "$PWD" "$qthread" "crew-$JOB_ID-" 2>/dev/null || true)"
              got=$(grep -c "^\[crew-$JOB_ID-" <<<"$followups" || true)
              [[ "$got" -ge "$expected" ]] && break
              if [[ $(date +%s) -ge $grace_deadline ]]; then
                # Out of patience: take whatever the turn has said so far rather
                # than reporting nothing, and let the count show it is partial.
                followups="$(node "$CREW_ROOT/lib/appserver-cli.mjs" followups --any-phase \
                  "$COMPANION_ROOT" "$PWD" "$qthread" "crew-$JOB_ID-" 2>/dev/null || true)"
                got=$(grep -c "^\[crew-$JOB_ID-" <<<"$followups" || true)
                break
              fi
              sleep "${CREW_CODEX_POLL_SECS:-5}"
            done
            if [[ -n "$followups" ]]; then
              printf '\n--- queued follow-ups ---\n%s\n' "$followups" >>"$CREW_RAW_RESULT"
              echo "QUEUED-REPLIES $got/$expected captured | appended to $CREW_ARCHIVE_DIR/$JOB_ID.result.txt"
            else
              echo "QUEUED-REPLIES 0/$expected | the queued turn did not run before the job's runtime went away; resume the thread to deliver it" >&2
            fi
          fi
        fi
        # ---- .meta.json sanitization: a DURABLE prompt leak, not a nicety --
        # `result --json` hands back the companion's storedJob verbatim, and a
        # stored job carries its REQUEST: a background task keeps the prompt in
        # storedJob.request.prompt, a background effort review keeps the focus
        # text in storedJob.request.focusText, and a task's summary is the first
        # 96 characters of the prompt (companion:552, `shorten(prompt)`). So the
        # unsanitized meta sat directly beside a carefully redacted
        # .dispatch.json holding the original incident text, credentials,
        # hostnames and paths — in an archive that exists precisely to OUTLIVE
        # the vendor session cleanup. Redacting the sidecar and not this file
        # redacts nothing.
        # Stripped BY KEY SHAPE and RECURSIVELY, wherever the key appears: a
        # path rule ("request.prompt") fails open the moment the vendor moves or
        # renames that payload in a version bump, and it would fail open
        # silently. Result, thread, status, timing and routing fields survive —
        # they are the reason this archive exists at all.
        # ⚠️ Best-effort by construction: an archiving failure must never change
        # await's exit code or its single stdout line, so the whole pipeline is
        # swallowed. An unparseable payload is WITHHELD rather than written raw:
        # "we could not sanitize it" must not become "so we archived it intact".
        {
          node "$COMPANION" result "$JOB_ID" --json 2>/dev/null \
            | CREW_META_OUT="$CREW_ARCHIVE_DIR/$JOB_ID.meta.json" \
              CREW_RESULT_IN="$CREW_RAW_RESULT" \
              CREW_RESULT_OUT="$CREW_ARCHIVE_DIR/$JOB_ID.result.txt" \
              CREW_SENTINEL_OUT="$CREW_ARCHIVE_DIR/$JOB_ID.sanitized" \
              CREW_META_JOB_ID="$JOB_ID" python3 -c "$CREW_SANITIZER_PY"
        } >/dev/null 2>&1 && CREW_SANITIZED_OK=1 || CREW_SANITIZED_OK=0
        rm -f "$CREW_RAW_RESULT" 2>/dev/null || true
        trap - EXIT HUP INT TERM
        # Fail CLOSED, the same contract .meta.json already has — but NOT
        # blindly. Unconditional stubbing was itself a defect: a transient
        # sanitizer failure (node crash, OOM, a pipe closed by a signal) then
        # DESTROYED a result an earlier await had already sanitized, and the
        # model turn that produced it is not repeatable. The provenance
        # sentinel is the discriminator, and it is content-addressed, so a
        # legacy unsanitized render — which has no sentinel, or a stale one —
        # is still replaced, which is the stale leak this must prevent.
        if [[ "$CREW_SANITIZED_OK" -ne 1 ]]; then
          if ! crew_sentinel_ok "$CREW_ARCHIVE_DIR/$JOB_ID.sanitized" "$CREW_ARCHIVE_DIR/$JOB_ID.result.txt"; then
            rm -f "$CREW_ARCHIVE_DIR/$JOB_ID.sanitized" 2>/dev/null || true
            # rm FIRST: a bare `>` redirect follows a symlink, so a link planted
            # at this path would send the stub — and, on the next successful
            # await, the result — outside the archive entirely.
            rm -f "$CREW_ARCHIVE_DIR/$JOB_ID.result.txt" 2>/dev/null || true
            printf '%s\n' "crew-codex: result withheld — the archive sanitizer did not complete, and the raw render can carry prompt text." \
              >"$CREW_ARCHIVE_DIR/$JOB_ID.result.txt" 2>/dev/null || true
          fi
        fi
        if [[ -f "$jlog" ]]; then
          cp -f "$jlog" "$CREW_ARCHIVE_DIR/$JOB_ID.log" 2>/dev/null || true
        fi
        # ---- superseded by a redirect ---------------------------------------
        # A redirect cancels the old job and resumes its Codex thread under a
        # NEW id. An agent still awaiting the old id would otherwise read that
        # cancellation as a failure, so name the successor instead.
        #
        # ⚠️ EXIT 5, NOT 4. Upstream returns 4 here. In this fork 4 has meant
        # HUNG since v0.4.2 (pid alive, job log frozen), and the devops
        # codex-adversary agent keys a confirm-then-recover protocol to it.
        # Taking 4 for SUPERSEDED would make an agent running against a
        # still-installed older codex-crew read a real hang as a redirect and
        # chase a successor id that does not exist — silent and destructive.
        # This divergence from upstream is deliberate; see README § Exit codes.
        if [[ "$jstatus" == "cancelled" ]]; then
          successor="$(crew_successor "$JOB_ID")"
          if [[ -n "$successor" ]]; then
            echo "SUPERSEDED $JOB_ID -> $successor | redirected onto the same Codex thread; await the NEW id"
            exit 5
          fi
        fi
        # Terminal: this job's broker has nothing left to serve, and each one
        # holds a codex app-server, so it is retired here rather than left to a
        # later sweep. Killing it is safe in a way the vendor-broker sweep is
        # not — we spawned this one, and the sidecar carries the pid AND its
        # start time, so crew_kill_broker can prove it is signalling the same
        # process it started rather than a stranger that inherited the pid.
        side="$(crew_sidecar "$JOB_ID")"
        if [[ -f "$side" ]]; then
          IFS=$'\t' read -r _ep bpid bdir _bcwd bstart _brest <"$side" || true
          crew_kill_broker "$bpid" "$bdir" "$bstart"
          crew_drop_sidecar "$JOB_ID"
        fi
        echo "DONE $jstatus | ${jelapsed} | archived: $CREW_ARCHIVE_DIR/$JOB_ID.result.txt"
        if [[ "$jstatus" == "completed" ]]; then exit 0; fi
        exit 1
        ;;
      *)
        # Tolerate a couple of transient unreadable snapshots (state.json is
        # rewritten in place) before declaring the job genuinely gone.
        missing_streak=$(( missing_streak + 1 ))
        if [[ $missing_streak -ge 3 ]]; then
          echo "crew-codex: job $JOB_ID not found in codex state (pruned, session-cleaned, or wrong id)" >&2
          exit 2
        fi
        ;;
    esac

    remaining=$(( deadline - $(date +%s) ))
    if [[ $remaining -le 0 ]]; then
      echo "RUNNING | ${jelapsed} | last: ${jlast}"
      exit 10
    fi

    # Prefer waiting on the job's own process: tail --pid blocks in the kernel
    # and wakes the instant it exits (verified: state.json is already terminal
    # by then). Wait in bounded slices rather than to the deadline so an
    # alive-but-wedged runtime gets caught by the frozen-log check below.
    # Falls back to polling when the pid is absent or already gone.
    if [[ "$jpid" =~ ^[0-9]+$ ]] && kill -0 "$jpid" 2>/dev/null; then
      stale_streak=0
      slice=$(( remaining < HUNG_POLL_SECS ? remaining : HUNG_POLL_SECS ))
      crew_wait_pid "$jpid" "$slice"
      if [[ -n "$jlog" && "$jlog" != "-" && -f "$jlog" ]]; then
        log_age=$(( $(date +%s) - $(crew_mtime "$jlog") ))
        if [[ $log_age -ge $HUNG_SECS ]]; then
          echo "HUNG $JOB_ID | ${jelapsed} | pid $jpid alive but log frozen ${log_age}s (>=${HUNG_SECS}s) — likely a lost model turn; cancel the job, kill leftover app-server/broker processes, then re-dispatch on a fresh runtime" >&2
          exit 4
        fi
      fi
    else
      if [[ "$jpid" =~ ^[0-9]+$ ]]; then
        # Process is gone but the job never reached a terminal status — this is
        # the signature of a silent death, so say so instead of waiting it out.
        stale_streak=$(( stale_streak + 1 ))
        if [[ $stale_streak -ge 3 ]]; then
          echo "STALE $JOB_ID | ${jelapsed} | process $jpid is gone but status is still '$jstatus' — the job died without reporting; resume it or re-dispatch" >&2
          exit 3
        fi
      fi
      sleep "$POLL_SECS"
    fi
  done
fi

# ---- reap: sweep ALL state dirs for jobs stuck in running/queued -----------
# ⚠️ NOTHING in `reap` kills a process or deletes a socket dir any more. The
# process-tree kill and the /tmp/cxc-* removal that used to live here are gone
# on purpose — see the long note above the --brokers block. Do not reintroduce
# them, and never add a pattern-based (`pkill -f`) or wildcard sweep: this
# machine runs SEVERAL Claude Code sessions at once and every one of them owns
# brokers, socket dirs and state dirs in the same shared namespaces.
# The companion never marks a job failed when its runtime dies or wedges, so
# "running" entries accumulate forever (6 found on 2026-08-06, oldest from
# Jul 22). Reap marks a stuck job failed in place when its pid is dead, or —
# for a live/unknown pid — when its log has not moved for
# CREW_CODEX_REAP_LOG_AGE seconds (default 3600). --dry-run reports only.
# Direct state mutation is safe here precisely because the runtime that owned
# the file is gone or wedged; live healthy jobs are never touched, and a
# workspace containing ANY live-pid job is skipped entirely (a live companion
# session may rewrite that workspace's state.json at any moment).
# BOTH records are updated per job: jobs/<id>.json AND the workspace's
# state.json — the companion builds status/result/cancel from state.json, so
# updating only the per-job file leaves a split brain that keeps lying.
# ⚠️ CONCURRENCY, not theory: $CLAUDE_PLUGIN_DATA/state is shared by every
# Claude Code session running on this machine, so a workspace we are about to
# rewrite may belong to a DIFFERENT session's live companion. That is why a
# workspace holding any live-pid job is skipped whole, and why a workspace
# whose records cannot be read is skipped too — an unreadable record is not an
# absent one, and mutating around it would corrupt another session's registry.
# Two further sweeps are OPT-IN: --state deletes job history (irreversible),
# and --brokers is report-only but noisy. Neither runs unless named, and the
# default output stays byte-identical without them.
# ---- sanitize-archive: the SAME scrubber, applied to what is already on disk -
# The .meta.json / .result.txt sanitization above only helps jobs archived from
# now on. Every job archived by an earlier crew-codex is still sitting in the
# archive with its focus text and its prompt-derived summary in the clear, and
# that archive exists precisely to OUTLIVE the vendor session cleanup — so it is
# the copy that lasts. This sweep runs the identical $CREW_SANITIZER_PY over
# those files, which is why the sanitizer is a shared variable and not two
# implementations that could disagree about what is safe to keep.
# It never deletes and never touches .log files; it rewrites in place only when
# the sanitized bytes differ, and --dry-run rewrites nothing at all.
if [[ "${1:-}" == "sanitize-archive" ]]; then
  shift
  SA_DIR="$CREW_ARCHIVE_DIR"
  SA_DRY=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) SA_DRY=1 ;;
      --dir)
        shift
        SA_DIR="${1:-}"
        if [[ -z "$SA_DIR" ]]; then
          echo "crew-codex: sanitize-archive: --dir needs a path" >&2
          exit 2
        fi
        ;;
      *)
        echo "crew-codex: sanitize-archive: unknown flag '$1' — usage: crew-codex sanitize-archive [--dir <path>] [--dry-run]" >&2
        exit 2
        ;;
    esac
    shift
  done

  if [[ ! -d "$SA_DIR" ]]; then
    echo "sanitize-archive: no archive directory at $SA_DIR — nothing to do"
    exit 0
  fi

  SA_TMP="$(mktemp -d)"
  # Publish through a same-directory temp and rename: an interrupted cp -f
  # leaves a half-written archive, and rename(2) within one directory does not.
  # ⚠️ mktemp, NOT "$dst.satmp.$$". A pid-derived name is PREDICTABLE, and the
  # archive directory can be group- or world-writable: precreating a symlink at
  # the guessable staging path redirected the write straight through the very
  # symlink check this sweep performs on the destination. mktemp creates the
  # file O_EXCL under an unguessable name, so there is nothing to precreate.
  sa_commit() {
    local src="$1" dst="$2" label="$3" stage dir
    dir="$(dirname "$dst")"
    stage="$(mktemp "$dir/.crew-sa.XXXXXX" 2>/dev/null)" || {
      echo "failed: $label — could not create a staging file"
      return 1
    }
    if cat "$src" >"$stage" 2>/dev/null && mv -f "$stage" "$dst" 2>/dev/null; then
      [[ -n "$label" ]] && echo "sanitized: $label"
      return 0
    fi
    rm -f "$stage" 2>/dev/null || true
    echo "failed: $label — could not rewrite"
    return 1
  }

  # The provenance sentinel is bookkeeping, not a sanitization: it records a
  # digest of bytes that are already clean. It is therefore installed silently
  # and never counted as a rewrite, or an already-clean archive would report
  # itself dirty on every sweep and idempotence would stop meaning anything.
  sa_install_sentinel() {
    local staged="$1" dst="$2"
    [[ "$SA_DRY" -eq 1 ]] && return 0
    [[ -n "$staged" && -f "$staged" ]] || return 0
    cmp -s "$staged" "$dst" 2>/dev/null && return 0
    sa_commit "$staged" "$dst" "" >/dev/null 2>&1 || true
  }

  sa_total=0; sa_changed=0; sa_failed=0
  shopt -s nullglob

  # Stale staging files from the pre-trap await path: unsanitized renders that
  # nothing else will ever look at. They carry prompt text and no value, so
  # this is the one thing the sweep removes outright.
  # ⚠️ Staging files stranded mid-write are REPORTED, NEVER DELETED — and that
  # is the same rule `reap --brokers` arrived at one file over, for the same
  # reason: a tool that cannot establish ownership must not act destructively.
  # Age is not an ownership test. An `await` that is SIGSTOPed, swapped, or
  # simply slow can own a `.crew-w.*` for any length of time, and deleting it
  # makes that await's `os.replace` fail — which, in the result-publication
  # window, replaces a perfectly good archived result with a withheld stub.
  # Trading a stray file for a destroyed model answer is not a trade worth an
  # mtime heuristic.
  sa_stranded=()
  while IFS= read -r -d '' sa_old; do
    sa_stranded+=("$sa_old")
  done < <(find "$SA_DIR" -maxdepth 1 -type f \( -name '.crew-w.*' -o -name '.crew-sa.*' \) -print0 2>/dev/null)
  if [[ ${#sa_stranded[@]} -gt 0 ]]; then
    echo "note: ${#sa_stranded[@]} staging file(s) present and NOT removed — a live await may own them:"
    for sa_old in "${sa_stranded[@]}"; do
      echo "  $sa_old"
    done
    echo "  remove them by hand once no crew-codex await is running."
  fi

  # `.result.raw` is different, and it is the one thing this sweep does remove.
  # Nothing writes that name any more — the staging path moved out of the
  # archive entirely — so no live process can own one. It is pure prompt text
  # from a dead design, and leaving it is the leak this command exists to close.
  for sa_raw in "$SA_DIR"/.*.result.raw; do
    [[ -e "$sa_raw" ]] || continue
    if rm -f "$sa_raw"; then
      echo "removed stale unsanitized staging file: $(basename "$sa_raw")"
    else
      echo "failed: $(basename "$sa_raw") — could not remove stale staging file"
      sa_failed=$((sa_failed + 1))
    fi
  done

  # The UNION of both artifact kinds, not just the metas. await wrote
  # .result.txt before running the best-effort meta sanitizer, so an
  # interruption in that window leaves a prompt-bearing result with NO meta
  # beside it — and a meta-driven loop never looks at it, never counts it and
  # exits 0 reporting the archive clean.
  # ⚠️ A bash ARRAY, not a newline-joined string. A filename may legally
  # contain a newline, and the old `sort -u` over a joined string split one
  # such file into two phantom ids — neither of which exists, so both "failed"
  # while the real prompt-bearing file was never inspected and never reported.
  # No command substitution here either: it would strip trailing newlines and
  # reintroduce exactly that.
  # ⚠️ No associative array: macOS system bash is 3.2, which has no
  # `declare -A` and aborted the whole sweep. Every meta id is unique by
  # construction (one glob, one suffix), so only a result id needs checking,
  # and only against the ids already collected — an exact quoted string
  # comparison, so spaces, glob characters and newlines stay one id.
  sa_ids=()
  for sa_f in "$SA_DIR"/*.meta.json; do
    sa_id="${sa_f##*/}"; sa_id="${sa_id%.meta.json}"
    sa_ids+=("$sa_id")
  done
  for sa_f in "$SA_DIR"/*.result.txt; do
    sa_id="${sa_f##*/}"; sa_id="${sa_id%.result.txt}"
    sa_dup=0
    for sa_have in ${sa_ids[@]+"${sa_ids[@]}"}; do
      [[ "$sa_have" == "$sa_id" ]] && { sa_dup=1; break; }
    done
    [[ "$sa_dup" -eq 1 ]] || sa_ids+=("$sa_id")
  done

  for sa_id in ${sa_ids[@]+"${sa_ids[@]}"}; do
    [[ -n "$sa_id" ]] || continue
    sa_total=$((sa_total + 1))
    sa_meta="$SA_DIR/$sa_id.meta.json"
    sa_res="$SA_DIR/$sa_id.result.txt"
    sa_sent="$SA_DIR/$sa_id.sanitized"

    # A symlink in the archive is not an archived job. cp/mv through one writes
    # to wherever it points, so --dir at a crafted directory could rewrite
    # files outside the archive entirely. The sentinel counts: it is a file
    # this sweep writes, so it is a redirect target like any other.
    if [[ -L "$sa_meta" || -L "$sa_res" || -L "$sa_sent" ]]; then
      echo "failed: $sa_id — symlinked archive entry, refusing to write through it"
      sa_failed=$((sa_failed + 1))
      continue
    fi

    sa_have_meta=0; [[ -f "$sa_meta" ]] && sa_have_meta=1
    sa_have_res=0;  [[ -f "$sa_res"  ]] && sa_have_res=1

    # Snapshot both inputs. Everything downstream is computed from the snapshot
    # and re-checked against it before committing, so a concurrent await that
    # rewrites the live file mid-sweep is detected instead of clobbered.
    sa_snap_meta="$SA_TMP/$sa_id.snap.meta"
    sa_snap_res="$SA_TMP/$sa_id.snap.res"
    if [[ "$sa_have_meta" -eq 1 ]] && ! cp "$sa_meta" "$sa_snap_meta" 2>/dev/null; then
      echo "failed: $sa_id.meta.json — unreadable, left untouched"
      sa_failed=$((sa_failed + 1)); continue
    fi
    if [[ "$sa_have_res" -eq 1 ]] && ! cp "$sa_res" "$sa_snap_res" 2>/dev/null; then
      echo "failed: $sa_id.result.txt — unreadable, left untouched"
      sa_failed=$((sa_failed + 1)); continue
    fi

    sa_out_meta="$SA_TMP/$sa_id.out.meta"
    sa_out_res=""
    sa_in_res=""
    if [[ "$sa_have_res" -eq 1 ]]; then
      sa_in_res="$sa_snap_res"
      sa_out_res="$SA_TMP/$sa_id.out.res"
    fi
    # A result with no meta has no payload to read, so the sanitizer is fed
    # `null` — the same path an unparseable payload takes, which is exactly
    # what leaves the skeleton rule as the only lever. That is the honest
    # answer here: the summary string is unrecoverable once the meta is gone.
    sa_stdin="$sa_snap_meta"
    if [[ "$sa_have_meta" -eq 0 ]]; then
      sa_stdin="$SA_TMP/$sa_id.null.json"
      printf 'null' > "$sa_stdin"
    fi

    sa_out_sent=""
    [[ -n "$sa_out_res" ]] && sa_out_sent="$SA_TMP/$sa_id.out.sent"
    # CREW_TRUST_MARKERS is set HERE and nowhere else. This is the one caller
    # whose input is this script's own prior output, so it is the one caller
    # entitled to believe a marker-shaped value was written by a marker. The
    # live await path reads the companion and must never trust one.
    if ! CREW_META_OUT="$sa_out_meta" CREW_META_JOB_ID="$sa_id" \
         CREW_RESULT_IN="$sa_in_res" CREW_RESULT_OUT="$sa_out_res" \
         CREW_SENTINEL_OUT="$sa_out_sent" CREW_TRUST_MARKERS=1 \
         python3 -c "$CREW_SANITIZER_PY" <"$sa_stdin" 2>/dev/null; then
      echo "failed: $sa_id — sanitizer error, original left untouched"
      sa_failed=$((sa_failed + 1))
      continue
    fi

    sa_diff=0
    if [[ "$sa_have_meta" -eq 1 ]]; then
      cmp -s "$sa_snap_meta" "$sa_out_meta" || sa_diff=1
    fi
    if [[ -n "$sa_out_res" && -f "$sa_out_res" ]]; then
      cmp -s "$sa_snap_res" "$sa_out_res" || sa_diff=1
    fi
    if [[ "$sa_diff" -eq 0 ]]; then
      # Already clean — but "already clean" is exactly the state that deserves
      # a sentinel. Without one, an await whose sanitizer later fails would
      # stub over a result this sweep just verified.
      sa_install_sentinel "$sa_out_sent" "$sa_sent"
      continue
    fi
    sa_changed=$((sa_changed + 1))
    if [[ "$SA_DRY" -eq 1 ]]; then
      echo "would sanitize: $sa_id"
      continue
    fi

    # Re-check identity before committing: if the live file no longer matches
    # the snapshot this output was computed from, another session rewrote it
    # while the sweep ran, and writing now would truncate their newer archive.
    if [[ "$sa_have_meta" -eq 1 ]] && ! cmp -s "$sa_meta" "$sa_snap_meta"; then
      echo "skipped: $sa_id — the archive changed while this sweep ran, not overwriting"
      sa_failed=$((sa_failed + 1)); continue
    fi
    if [[ "$sa_have_res" -eq 1 ]] && ! cmp -s "$sa_res" "$sa_snap_res"; then
      echo "skipped: $sa_id — the archive changed while this sweep ran, not overwriting"
      sa_failed=$((sa_failed + 1)); continue
    fi

    if [[ "$sa_have_meta" -eq 1 ]]; then
      sa_commit "$sa_out_meta" "$sa_meta" "$sa_id.meta.json" || sa_failed=$((sa_failed + 1))
    fi
    if [[ -n "$sa_out_res" && -f "$sa_out_res" ]]; then
      if sa_commit "$sa_out_res" "$sa_res" "$sa_id.result.txt"; then
        # Only now — the sentinel vouches for bytes on disk, so it must never
        # be written for a commit that did not happen.
        sa_install_sentinel "$sa_out_sent" "$sa_sent"
      else
        rm -f "$sa_sent" 2>/dev/null || true
        sa_failed=$((sa_failed + 1))
      fi
    fi
  done
  rm -rf "$SA_TMP"
  sa_verb="rewritten"
  [[ "$SA_DRY" -eq 1 ]] && sa_verb="would be rewritten"
  echo "sanitize-archive summary: $sa_total archived job(s) inspected, $sa_changed $sa_verb, $sa_failed failed"
  echo "note: .log files are copied verbatim by await and are NOT sanitized by this sweep."
  echo "note: a result with no meta beside it can only be cleaned by the skeleton rule — its exact summary string is unrecoverable."
  if [[ "$sa_failed" -gt 0 ]]; then exit 1; fi
  exit 0
fi

if [[ "${1:-}" == "reap" ]]; then
  shift
  DRY=0
  SWEEP_BROKERS=0
  SWEEP_STATE=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --dry-run) DRY=1 ;;
      --brokers) SWEEP_BROKERS=1 ;;
      --state)   SWEEP_STATE=1 ;;
      *)
        # Loud, never ignored: reap's default mode MUTATES job records and
        # --state DELETES them, so a typo'd `--dryrun` quietly doing the real
        # thing is precisely the accident this rejection prevents.
        echo "crew-codex: reap: unknown flag '$1' — usage: crew-codex reap [--dry-run] [--brokers] [--state]" >&2
        exit 2
        ;;
    esac
    shift
  done

  # ---- exit code: a blocked sweep must not report success -------------------
  # Every sweep used to end in `exit 0`, so a caller could not tell a sweep that
  # classified everything from one that skipped an unreadable record, a
  # malformed registry or a live-pid workspace — the exact entries a human still
  # has to deal with. Automation reading the exit code was therefore told
  # "clean" by a sweep that had walked past the interesting half of its input.
  #   0 = every entry was classified
  #   2 = usage error (unknown flag), rejected before anything ran
  #   3 = the sweep ran but at least one entry was blocked/unresolved/skipped
  #   1 = reap itself failed (an unhandled error inside a sweep)
  # --brokers is deliberately NOT part of this: it discovers processes, it does
  # not sweep registry entries, and its "unknown" classification is its normal
  # reportable output rather than work left undone.
  REAP_EXIT=0
  reap_record_exit() {
    # Severity, not recency: 1 (reap broke) outranks 3 (sweep incomplete).
    local rc="$1"
    [[ "$rc" -eq 0 ]] && return 0
    if [[ "$REAP_EXIT" -eq 0 || "$rc" -lt "$REAP_EXIT" ]]; then REAP_EXIT="$rc"; fi
    return 0
  }

  # ---- crew-OWNED per-job brokers: the one sweep that may actually kill ----
  # Everything else in `reap` is report-only, and deliberately so (see the long
  # note above the --brokers block). This sweep is different in kind, not in
  # nerve: crew-codex STARTED these brokers, recorded each one in a sidecar
  # carrying its pid AND its start time, and crew_kill_broker refuses to signal
  # a pid whose start time no longer matches. So there is no "might belong to
  # another session" case to be careful about — an unmatched pid is a stranger
  # and is left alone, files cleaned, no signal sent. A broker holds a whole
  # codex app-server, so NOT retiring these is the expensive failure.
  # --dry-run skips it: it is the one part of reap that changes anything.
  # ⚠️ SILENT in the default mode, on purpose. `reap`'s default output is a
  # fixed contract — the opt-in sweeps must add lines, the default must not —
  # and this retirement is not a user-facing action anyway: it is the same
  # automatic housekeeping that already runs before every launch and on every
  # terminal `await`. The COUNT is reported under --brokers, beside the vendor
  # broker survey, where broker output belongs.
  BROKERS_HELD=0
  if [[ "$DRY" -eq 0 ]]; then
    crew_reap_brokers || true
  fi
  for f in "$CREW_ARCHIVE_DIR"/*.broker; do
    [[ -f "$f" ]] && BROKERS_HELD=$((BROKERS_HELD + 1))
  done

  rc=0
  REAP_LOG_AGE="${CREW_CODEX_REAP_LOG_AGE:-3600}" \
  REAP_DRY="$DRY" \
  python3 - "$CLAUDE_PLUGIN_DATA/state" <<'PY' || rc=$?
import datetime, json, os, sys, tempfile, time
root = sys.argv[1]
max_age = int(os.environ.get("REAP_LOG_AGE", "3600"))
dry = os.environ.get("REAP_DRY") == "1"
now = time.time()
reaped = kept = skipped = unresolved = 0
# The pessimistic reading of a registry entry, shared with the --state sweep:
# anything NOT in this set is treated as a live job, including a status this
# sweep has never heard of.
TERMINAL = {"completed", "failed", "cancelled", "gone"}

def pid_alive(pid):
    if not isinstance(pid, int):
        return False
    try:
        os.kill(pid, 0)
        return True
    except ProcessLookupError:
        return False
    except PermissionError:
        return True

def stuck_reason(job):
    """None if the job looks healthy; else a short reason string."""
    pid = job.get("pid")
    log = job.get("logFile")
    log_age = None
    if log:
        try:
            log_age = now - os.stat(log).st_mtime
        except (FileNotFoundError, NotADirectoryError):
            log_age = None      # genuinely no log file — fall through to age
        except OSError:
            # We cannot see the log, so we cannot claim it is frozen. Report
            # healthy: the cost is one un-reaped record, and the alternative is
            # marking another session's live job failed on no evidence.
            return None
    if isinstance(pid, int) and not pid_alive(pid):
        return "process dead"
    if log_age is not None and log_age >= max_age:
        return f"log frozen {int(log_age)}s"
    if log_age is None:
        try:
            created = datetime.datetime.fromisoformat(
                job.get("createdAt", "").replace("Z", "+00:00"))
            if (now - created.timestamp()) >= max_age:
                return "no activity since creation"
        except Exception:
            pass
    return None

# ⚠️ THE CONFLICT TEST IS THE FULL IDENTITY, NOT `status`. A session resuming a
# job it owns moves pid, updatedAt, threadId and turnId while `status` stays
# "running" the whole time — so a status-only comparison read a live resume as
# "nobody touched it" and this sweep marked the running job failed underneath
# them. Every field another writer can move belongs in the tuple.
CONFLICT_FIELDS = ("status", "phase", "pid", "updatedAt", "threadId", "turnId")


def entry_identity(entry):
    return tuple(entry.get(f) for f in CONFLICT_FIELDS)


def read_state_entries(path):
    """Re-read state.json and return (root, entries). Raises on any shape this
    sweep cannot mirror into — the caller treats that as a conflict."""
    with open(path) as handle:
        data = json.load(handle)
    if isinstance(data, list):
        return data, data
    if isinstance(data, dict) and isinstance(data.get("jobs"), list):
        return data, data["jobs"]
    if isinstance(data, dict) and not data:
        return data, []
    raise ValueError("state.json schema changed under the sweep")


def state_conflicts(entries, ids, baseline):
    return [e.get("id") for e in entries
            if isinstance(e, dict) and e.get("id") in ids
            and entry_identity(e) != baseline.get(e.get("id"))]


def note_rollback(to_reap, stamp):
    """Every rollback path appends the correction, not just the conflict one.
    A log that says "marked failed" for a record that was put back is a false
    trail, and the log is what somebody reads months later when the job record
    itself is long gone."""
    for _p, (j, _why, _was) in to_reap.items():
        log = j.get("logFile")
        if not log:
            continue
        try:
            with open(log, "a") as handle:
                handle.write(f"[{stamp}] crew-codex reap: ROLLED BACK — the record above does not apply.\n")
        except OSError:
            pass


def write_job_atomic(path, blob):
    """Stage in the same directory and rename over. ⚠️ `open(path, "w")`
    TRUNCATES before the first byte is written, so a write that then fails —
    ENOSPC, EIO, a short write — leaves the record empty AND absent from the
    written-bytes map, which makes it unrestorable by a rollback that
    (correctly) refuses to write over bytes it did not produce. rename(2)
    within one directory is atomic: the record is either the old one or the new
    one, never a truncated one."""
    directory = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(prefix=".crew-j.", dir=directory)
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as handle:
            handle.write(blob)
        os.replace(tmp, path)
    except BaseException:
        try:
            os.unlink(tmp)
        except OSError:
            pass
        raise


def restore_originals(originals, written):
    """Undo the jobs/*.json writes from the exact bytes read before them. A
    re-serialization would not be byte-identical, and the point of a rollback
    is that the workspace is indistinguishable from untouched.

    Three states, and only one of them is a problem:
      current == the pre-image  → already pristine. The mutation loop aborted
        before touching it (or an atomic write failed cleanly). Nothing to undo.
      current == what we wrote  → ours. Restore it.
      anything else             → ⚠️ somebody rewrote it after we did. A
        phase-(b) rollback fires precisely BECAUSE another session is active, so
        writing a pre-image over their fresher record is the exact harm the
        rollback exists to prevent. Leave it and say so: "stale but theirs"
        beats "clobbered by us".
    Collapsing the first case into the third reported pristine, never-touched
    files as unresolved and told the user a clean workspace needed a look.

    ⚠️ WHAT THIS DOES NOT PROMISE. The comparison and the write are separate
    operations, so a writer landing between them is still overwritten, and no
    ordering of these two statements fixes that — it needs a lock shared with
    the vendor companion, which does not take one. This sweep therefore does not
    claim rollback safety under a concurrent writer. It claims that it detects
    and reports rather than silently clobbering, that an abort touches nothing,
    that a partially-restored workspace is reported as UNRESOLVED rather than
    counted clean, and that no record is ever left truncated."""
    restored, conflicted = [], []
    for path, blob in originals.items():
        try:
            with open(path, "rb") as handle:
                current = handle.read()
        except OSError:
            conflicted.append(path)
            continue
        if current == blob:
            restored.append(path)          # already as this sweep found it
            continue
        if current != written.get(path):
            conflicted.append(path)
            continue
        try:
            # Atomic, like the forward write: a rollback interrupted halfway
            # through `open(..., "wb")` would leave a truncated record, which is
            # strictly worse than either version.
            write_job_atomic(path, blob.decode("utf-8"))
            restored.append(path)
        except (OSError, UnicodeDecodeError):
            conflicted.append(path)
    return restored, conflicted


stamp = time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
# ⚠️ Attempt the operation, classify the exception — NEVER guard with
# os.path.isdir/isfile/exists. All three return False for permission-denied,
# for a dangling symlink and for an untraversable parent, which makes
# "unreadable" indistinguishable from "absent". Absent is safe; unreadable is
# not, because the state root is shared with every other Claude Code session on
# this machine. FileNotFoundError/NotADirectoryError mean absent; every other
# OSError means "we cannot see it" and stops us touching that workspace.
try:
    state_dirs = sorted(os.listdir(root))
except (FileNotFoundError, NotADirectoryError):
    print(f"reap: no state dir at {root}")
    raise SystemExit(0)
except OSError as exc:
    # Not a clean sweep: nothing was swept and we cannot say what is in there.
    print(f"reap: cannot list {root} ({exc.__class__.__name__}) — nothing swept")
    raise SystemExit(3)
for state_dir in state_dirs:
    ws = os.path.join(root, state_dir)
    jobs_dir = os.path.join(ws, "jobs")
    try:
        job_names = sorted(os.listdir(jobs_dir))
    except (FileNotFoundError, NotADirectoryError):
        # NO `continue` here: state.json below is the AUTHORITATIVE registry —
        # the companion serves status/result/cancel from it — and a workspace
        # can carry a live job there with no per-job file (partial cleanup, or
        # a record written before jobs/ existed). Skipping such a workspace is
        # exactly how a state.json-only running job walked past this sweep
        # while it still reported exit 0. --brokers' survey already refuses to.
        job_names = []
    except OSError as exc:
        # Pre-existing bug, found by a permission-denied test: an unreadable
        # jobs dir raised PermissionError out of the sweep and killed plain
        # `reap` outright. Skip it loudly instead — and skip it whole, because
        # an unreadable record may be another session's live job.
        print(f"skipped: {state_dir}/jobs unreadable ({exc.__class__.__name__}) — not touching this workspace")
        skipped += 1
        continue
    jobs = {}
    pre_images = {}
    unreadable = []
    for name in job_names:
        if not name.endswith(".json"):
            continue
        path = os.path.join(jobs_dir, name)
        try:
            # ⚠️ Read the BYTES once and parse from them, so the pre-image the
            # rollback would restore is byte-for-byte the record this sweep
            # actually classified. Capturing it later — after the registry
            # checks — meant a writer landing in between was captured AS the
            # pre-image: the sweep then classified from one version, wrote over
            # a second, and would have "restored" the second while believing it
            # had restored the first. One read also removes a whole class of
            # "readable at classification, unreadable at capture" races.
            with open(path, "rb") as f:
                blob = f.read()
            record = json.loads(blob.decode("utf-8"))
        except (FileNotFoundError, NotADirectoryError):
            continue                     # vanished between listdir and open
        except (OSError, ValueError) as exc:
            unreadable.append(f"{name}({exc.__class__.__name__})")
            continue
        if not isinstance(record, dict):
            unreadable.append(f"{name}(not a job object)")
            continue
        pre_images[path] = blob
        jobs[path] = record
    if unreadable:
        # A record we cannot read is NOT a record that says "terminal". Another
        # session's companion may be mid-write in this very workspace.
        print(f"skipped: {state_dir} — unreadable job record(s) {unreadable}, not touching this workspace")
        skipped += 1
        continue
    stuck = {p: j for p, j in jobs.items()
             if j.get("status") in ("running", "queued")}
    stuck_ids = {j.get("id") for j in stuck.values()}
    # Read the workspace registry BEFORE any classification, for EVERY
    # workspace — including ones with no jobs/ dir at all. The companion serves
    # status/result/cancel from state.json, so (a) a jobs/*.json rewrite we
    # cannot mirror leaves a split brain that keeps lying, and (b) a job
    # recorded ONLY there is a job this sweep must not walk past. An unreadable
    # or unrecognized registry is exactly the case where another session may
    # own this workspace. Absent is fine (nothing to mirror into, nothing to
    # reconcile); anything else skips the workspace whole, dry and real alike.
    state_path = os.path.join(ws, "state.json")
    state = None
    state_entries = []
    try:
        with open(state_path) as f:
            state = json.load(f)
    except (FileNotFoundError, NotADirectoryError):
        state = None
    except (OSError, ValueError) as exc:
        print(f"skipped: {state_dir} — state.json unreadable ({exc.__class__.__name__}), not touching this workspace")
        skipped += 1
        continue
    else:
        # Only two shapes are understood: a bare list, or {"jobs": [...]}. An
        # empty object is genuinely empty. Anything else we cannot mirror into.
        if isinstance(state, list):
            state_entries = state
        elif isinstance(state, dict) and isinstance(state.get("jobs"), list):
            state_entries = state["jobs"]
        elif isinstance(state, dict) and not state:
            state_entries = []
        else:
            print(f"skipped: {state_dir} — state.json has an unrecognized schema, not touching this workspace")
            skipped += 1
            continue
    # ---- reconcile the UNION of jobs/*.json and state.json -------------------
    # A registry entry this sweep cannot pair with a stuck per-job record is an
    # entry it cannot act on: there is no jobs/<id>.json to mark failed, no log
    # to age, and the disagreement itself is the signature of a companion
    # mid-write in a state root shared with every other Claude Code session on
    # this machine. Report it and leave the WHOLE workspace alone — the same
    # answer an unreadable record already gets — and count it, so the sweep
    # exits 3 instead of claiming it classified everything.
    # NOT-TERMINAL is the test, not `in ("running", "queued")`: a status this
    # sweep has never heard of must fail closed too.
    unreconciled = []
    for e in state_entries:
        if not isinstance(e, dict):
            unreconciled.append("state.json(non-dict entry)")
        elif e.get("status") not in TERMINAL and e.get("id") not in stuck_ids:
            unreconciled.append(f"{e.get('id', '?')}({e.get('status')})")
    if unreconciled:
        for entry in unreconciled:
            print(f"skipped: {state_dir}/{entry} — recorded in state.json with no matching stuck jobs/*.json record, not touching this workspace")
            skipped += 1
        continue
    if not stuck:
        continue
    # A workspace with ANY live-pid running job may have a live companion
    # session — very often a DIFFERENT Claude Code session on this machine —
    # that rewrites state.json at will. Never race it.
    live = [j.get("id") for j in stuck.values() if pid_alive(j.get("pid"))]
    if live:
        for p, j in stuck.items():
            why = stuck_reason(j)
            if why and j.get("id") not in live:
                print(f"skipped: {state_dir}/{j.get('id')} ({why}) — workspace has live job(s) {live}, not touching its state")
                skipped += 1
            else:
                print(f"kept: {state_dir}/{j.get('id')} (pid alive)")
                kept += 1
        continue
    # ⚠️ The status is captured HERE, before anything mutates `j`. The reap
    # claim is printed after the commit, and `j.update(status="failed", ...)`
    # runs in between — so printing `j.get("status")` at that point reported
    # every real reap as "(failed, ...)" while --dry-run reported the same
    # record as "(running, ...)". A terminal status is by definition never
    # stuck, so the line stated something impossible, and the two modes
    # disagreed about the same record.
    to_reap = {p: (j, stuck_reason(j), j.get("status")) for p, j in stuck.items()}
    to_reap = {p: (j, why, was_status) for p, (j, why, was_status) in to_reap.items() if why}
    planned_ids = {j.get("id") for _, (j, _why, _w) in to_reap.items()}
    # The snapshot every conflict check below is measured against.
    baseline = {e.get("id"): entry_identity(e)
                for e in state_entries if isinstance(e, dict)}

    # Two jobs/*.json carrying the SAME id is a registry this sweep cannot
    # reason about: the per-file accounting and the id-keyed registry mirror
    # disagree by construction, and one `id` in state.json cannot describe two
    # records. Corrupt input, and the honest answer is to touch nothing.
    # ⚠️ Counted across EVERY parsed record in the workspace, not just the ones
    # this sweep would reap. Scoping it to the reap subset missed the case that
    # actually splits the brain: two files sharing an id where only ONE looks
    # stuck. The sweep marks that one and the single registry entry failed while
    # the other record is still running, and no duplicate was ever detected.
    # A non-string or empty id is the same class of corrupt input.
    id_counts = {}
    bad_ids = []
    for _p, _j in jobs.items():
        _id = _j.get("id")
        if not isinstance(_id, str) or not _id:
            # ⚠️ Only NON-TERMINAL records block. A completed/failed record with
            # no usable id is inert junk this sweep would never act on, and
            # blocking on it turned a one-file annoyance into a workspace that
            # exits 3 on every run until somebody cleans it by hand. A
            # non-terminal one is different: it may be a live job, and an id is
            # how this sweep would reason about it.
            if _j.get("status") not in TERMINAL:
                bad_ids.append(os.path.basename(_p))
            continue
        id_counts[_id] = id_counts.get(_id, 0) + 1
    dup_ids = sorted(i for i, n in id_counts.items() if n > 1)
    if dup_ids or bad_ids:
        detail = f"{dup_ids} appear in more than one jobs/*.json record" if dup_ids else ""
        if bad_ids:
            detail = (detail + " and " if detail else "") + f"{bad_ids} carry no usable id"
        print(f"skipped: {state_dir} — {detail}, not touching this workspace")
        skipped += 1
        continue

    # ---- PHASE (a): validate BEFORE the first mutation ----------------------
    # The old order wrote every jobs/*.json first and only THEN discovered a
    # concurrent writer — and an abort at that point was unrecoverable: per-job
    # records saying "failed" beside a registry the companion still served as
    # running. A split brain is worse than doing nothing, so the check moves
    # ahead of the first write and an abort here touches nothing at all.
    if not dry and to_reap and state is not None:
        try:
            _pre_root, pre_entries = read_state_entries(state_path)
        except (OSError, ValueError) as exc:
            print(f"skipped: {state_dir} — state.json became unusable while this sweep ran ({exc.__class__.__name__}), nothing touched")
            skipped += 1
            continue
        pre_conflicts = state_conflicts(pre_entries, planned_ids, baseline)
        if pre_conflicts:
            print(f"skipped: {state_dir} — {pre_conflicts} changed while this sweep ran, not touching this workspace")
            skipped += 1
            continue

    if dry or not to_reap:
        for p, (j, why, was_status) in to_reap.items():
            print(f"would reap: {state_dir}/{j.get('id')} ({was_status}, {why})")
            reaped += 1
        for p, j in stuck.items():
            if p not in to_reap:
                print(f"kept: {state_dir}/{j.get('id')} (no stuck signal)")
                kept += 1
        continue

    # The pre-images were captured at classification time, above. Everything the
    # rollback can promise rests on them being the exact bytes this sweep read
    # and reasoned about.
    originals = {p: pre_images[p] for p in to_reap if p in pre_images}
    if len(originals) != len(to_reap):
        missing = sorted(os.path.basename(p) for p in to_reap if p not in pre_images)
        print(f"skipped: {state_dir} — {missing} have no captured pre-image, not touching this workspace")
        skipped += 1
        continue

    # ⚠️ Re-verify immediately before the write loop. This covers the whole
    # window from classification to mutation — which is where the registry reads
    # and every other check live, so it is the window a concurrent writer is
    # most likely to land in. The rollback on its own can only tell "ours" from
    # "theirs" for a writer that arrives AFTER our write; without this check one
    # that arrived earlier would be silently overwritten and then "restored" to
    # a version it had already replaced.
    #
    # It does not CLOSE the race — the gap between this loop and the next is
    # still real, and closing it needs a lock shared with the vendor companion,
    # which does not take one. So this sweep does not claim rollback safety
    # under a concurrent writer; it claims that it detects and reports rather
    # than silently clobbers, and that an abort touches nothing.
    moved = []
    for p, blob in originals.items():
        try:
            with open(p, "rb") as f:
                if f.read() != blob:
                    moved.append(os.path.basename(p))
        except OSError as exc:
            moved.append(f"{os.path.basename(p)}({exc.__class__.__name__})")
    if moved:
        print(f"skipped: {state_dir} — {moved} changed between capture and write, not touching this workspace")
        skipped += 1
        continue

    # `kept:` is a statement about classification, not about mutation, so it can
    # be reported now. ⚠️ `reaped:` CANNOT: it is a claim about what is on disk,
    # and it is therefore printed and counted only after the forward writes AND
    # the registry mirror have both committed, at the bottom of this block.
    # Printing it up front and decrementing on rollback produced three separate
    # lies in one run — a standing `reaped:` line for a record never mutated,
    # a non-zero count for a pristine workspace, and an "inconsistent" warning
    # about files that were never touched.
    for p, j in stuck.items():
        if p not in to_reap:
            print(f"kept: {state_dir}/{j.get('id')} (no stuck signal)")
            kept += 1

    written = {}
    reaped_ids = set()
    # ⚠️ GUARDED. The forward writes used to sit outside every try block, so a
    # second file that turned read-only after phase (a) raised PermissionError
    # straight out of the sweep: Python exited 1 with the FIRST file already
    # marked failed, no mirror, no rollback, and no summary — the exact split
    # brain the two-phase design advertises it cannot produce. A partial
    # mutation now unwinds through the same path a late conflict does.
    try:
        for p, (j, why, _was) in to_reap.items():
            j.update(status="failed", phase="reaped", reapedAt=stamp, reapReason=why)
            j["pid"] = None
            blob = json.dumps(j, indent=2)
            write_job_atomic(p, blob)
            # What we wrote, byte for byte — the rollback compares against this
            # to tell "still ours" from "somebody rewrote it after us".
            written[p] = blob.encode("utf-8")
            reaped_ids.add(j.get("id"))
    except OSError as exc:
        restored, conflicted = restore_originals(originals, written)
        note_rollback(to_reap, stamp)
        print(f"skipped: {state_dir} — a jobs/*.json write failed ({exc.__class__.__name__}), rolling back")
        print(f"rolled back: {state_dir} — {len(restored)} record(s) restored or already pristine")
        if conflicted:
            print(f"NOT restored: {state_dir} — {[os.path.basename(c) for c in conflicted]}; these still hold this sweep's bytes and need a look")
            unresolved += len(conflicted)
        skipped += 1
        continue
    # Logged only after every forward write committed, so a rolled-back sweep
    # never leaves "marked failed" in a log for a record that still says running.
    for p, (j, why, _was) in to_reap.items():
        log = j.get("logFile")
        if log:
            try:
                with open(log, "a") as f:
                    f.write(f"[{stamp}] crew-codex reap: marked failed ({why}).\n")
            except OSError:
                pass            # a missing/unwritable log must not abort the sweep
    # Mirror into the workspace's state.json — the authoritative registry the
    # companion serves status/result/cancel from. Already read and shape-checked
    # above; only the reaped entries are touched and everything else round-trips
    # untouched.
    mirrored = True
    if state is not None and reaped_ids:
        mirrored = False
        try:
            # ⚠️ MERGE INTO A FRESH READ. Never write back the snapshot the
            # classification above ran on. state.json is the shared registry
            # every other Claude Code session on this machine writes to, and a
            # snapshot writeback DELETES whatever they recorded while this
            # sweep was busy — a job queued after the read simply vanishes,
            # await then reports it missing, and a duplicate dispatch follows.
            # Re-reading here means a concurrently added job survives, because
            # it is present in what we are about to write.
            #
            # This read is ALSO the second half of the two-phase check: phase
            # (a) proved nobody had moved these entries before we started, and
            # the per-job rewrite above opened a fresh window. Same full
            # identity test, and this time an abort ROLLS BACK.
            _fresh_root, fresh_entries = read_state_entries(state_path)
            fresh = _fresh_root
            conflicts = state_conflicts(fresh_entries, reaped_ids, baseline)
            if conflicts:
                restored, conflicted = restore_originals(originals, written)
                note_rollback(to_reap, stamp)
                print(f"skipped: {state_dir} — {conflicts} changed status while this sweep ran, not overwriting another session's update")
                print(f"rolled back: {state_dir} — {len(restored)} jobs/*.json record(s) restored or already pristine")
                if conflicted:
                    print(f"NOT restored: {state_dir} — {[os.path.basename(c) for c in conflicted]}; these still hold this sweep's bytes. Left alone deliberately: a stale pre-image written over somebody's newer record is worse than an unrolled-back one.")
                    unresolved += len(conflicted)
                skipped += 1
            else:
                # ⚠️ EVERY reaped id must have EXACTLY ONE entry to update.
                # `state_conflicts` only inspects entries that exist, so an id
                # whose registry entry is absent — a stale jobs/*.json with an
                # empty registry, or an entry another writer removed after our
                # forward writes — produced no conflict, updated nothing, and
                # still set `mirrored`. The sweep then claimed a reap while the
                # registry the companion actually serves had no failed entry for
                # it: precisely the split brain the two-record commit is for.
                # Two entries sharing the id is the same class of unmirrorable.
                entry_counts = {}
                for e in fresh_entries:
                    if isinstance(e, dict) and e.get("id") in reaped_ids:
                        entry_counts[e.get("id")] = entry_counts.get(e.get("id"), 0) + 1
                unmirrorable = sorted(i for i in reaped_ids if entry_counts.get(i, 0) != 1)
                if unmirrorable:
                    restored, conflicted = restore_originals(originals, written)
                    note_rollback(to_reap, stamp)
                    print(f"skipped: {state_dir} — {unmirrorable} have no single matching state.json entry to mirror into, rolling back")
                    print(f"rolled back: {state_dir} — {len(restored)} jobs/*.json record(s) restored or already pristine")
                    if conflicted:
                        print(f"NOT restored: {state_dir} — {[os.path.basename(c) for c in conflicted]}; these still hold this sweep's bytes and need a look")
                        unresolved += len(conflicted)
                    skipped += 1
                    continue
                changed = False
                for e in fresh_entries:
                    if isinstance(e, dict) and e.get("id") in reaped_ids:
                        e.update(status="failed", phase="reaped",
                                 reapedAt=stamp, updatedAt=stamp)
                        e["pid"] = None
                        changed = True
                if changed:
                    # Residual, irreducible from outside: another writer can
                    # still land between the read above and this replace. That
                    # window is one in-memory read-modify-write with no I/O in
                    # it, where the old one spanned the whole classification
                    # and per-job rewrite phase. Closing it entirely needs a
                    # lock the vendor companion does not take.
                    tmp = state_path + ".reap-tmp"
                    with open(tmp, "w") as f:
                        json.dump(fresh, f, indent=2)
                    os.replace(tmp, state_path)
                mirrored = True
        except (OSError, ValueError) as exc:
            # Same split brain as a late conflict — the per-job files say
            # "failed" and the registry the companion actually serves does not
            # — so it gets the same answer: undo the per-job writes and leave
            # the workspace exactly as this sweep found it. Still unfinished
            # work, so it still counts toward the non-zero exit below.
            restored, conflicted = restore_originals(originals, written)
            note_rollback(to_reap, stamp)
            print(f"warning: could not update {state_path}: {exc}")
            print(f"rolled back: {state_dir} — {len(restored)} jobs/*.json record(s) restored or already pristine")
            if conflicted:
                print(f"NOT restored: {state_dir} — {[os.path.basename(c) for c in conflicted]}; these still hold this sweep's bytes and need a look")
                unresolved += len(conflicted)
            skipped += 1
    # ⚠️ THE ONLY PLACE A REAP IS CLAIMED. Both the per-job records and the
    # registry the companion actually serves are now committed, so this line and
    # this counter describe disk. Every abort above reaches `continue` without
    # passing through here.
    if mirrored:
        for p, (j, why, was_status) in to_reap.items():
            print(f"reaped: {state_dir}/{j.get('id')} ({was_status}, {why})")
            reaped += 1
# ⚠️ `unresolved` is reported separately from `skipped` on purpose. A skipped
# workspace is untouched; an unresolved record still holds THIS SWEEP's bytes
# after a rollback could not put the original back. Folding it into "skipped"
# would let "0 reaped" read as "nothing was changed", which is the one thing it
# must never mean.
summary = (f"reap summary: {reaped} {'flagged' if dry else 'reaped'}, {kept} kept, "
           f"{skipped} skipped (unreadable, unreconciled, live workspace or unwritable)")
if unresolved:
    summary += (f", {unresolved} UNRESOLVED — record(s) still carry this sweep's "
                f"'failed' bytes with no matching registry entry; see the "
                f"'NOT restored' lines above")
print(summary)
raise SystemExit(3 if (skipped or unresolved) else 0)
PY
  reap_record_exit "$rc"

  # ---- --brokers: REPORT ONLY. This sweep kills NOTHING. --------------------
  # A broker outlives the worktree it was spawned for: delete the worktree and
  # its `node app-server-broker.mjs serve --cwd <gone>` process stays resident
  # forever, holding a /tmp/cxc-* socket dir. Finding those is useful. KILLING
  # them from here is not, and this section no longer does.
  #
  # ⚠️⚠️ WHY THERE IS NO KILL HERE — read this before "restoring" one.
  # The kill failed OPEN five distinct times across five review rounds, each
  # time inside the fix for the previous one:
  #   1. the safety gate read only jobs/*.json while --state took a pessimistic
  #      union, so a job recorded only in state.json opened the gate;
  #   2. the union was then added AFTER a `continue` that skipped workspaces
  #      with no jobs/ dir — bypassing it in exactly the split-brain case it
  #      was written for;
  #   3. os.path.isdir/isfile return False for permission-denied, so an
  #      UNREADABLE registry was indistinguishable from an ABSENT one and read
  #      as "no live jobs" — the gate opened on a workspace we could not see;
  #   4. the fix for (3) swapped those for os.path.exists, which carries the
  #      IDENTICAL EACCES ambiguity one directory level up. Reproduced live: a
  #      mode-000 state/<ws>/ holding a running job made both guards return
  #      False, the live list came back empty, and the sweep proceeded;
  #   5. irreducible TOCTOU — the registry scan finishes before brokers are
  #      classified, so a job can start between the scan and the kill. No
  #      amount of scanning closes that; the process being killed is the only
  #      thing that knows whether it is idle.
  # On top of all five: $CLAUDE_PLUGIN_DATA/state, the /tmp/cxc-* namespace and
  # the broker processes themselves are SHARED BY EVERY CLAUDE CODE SESSION
  # RUNNING ON THIS MACHINE. A broker with a dead --cwd may still be serving
  # another session's in-flight review. Doing this safely needs broker-owned
  # idle-lease / shutdown coordination, and that lives in vendor code we do not
  # own — so the decision is a human's, with the evidence printed for them.
  #
  # RULES FOR ANYONE EDITING THIS BLOCK:
  #   * Never kill, never rm. Print a command; let a human run it.
  #   * Never a global or pattern operation — no `pkill -f`, no `rm /tmp/cxc-*`,
  #     no "everything older than N". Brokers are per-workspace, so a pattern
  #     kill takes out every other session's healthy runtime with it. Every
  #     line below names one specific PID the caller has already been shown.
  #   * Never guard with os.path.exists/isdir/isfile. Attempt the operation and
  #     classify the exception: FileNotFoundError/NotADirectoryError mean
  #     ABSENT (safe); every other OSError means UNREADABLE (not safe).
  if [[ "$SWEEP_BROKERS" -eq 1 ]]; then
    echo
    # Two different populations, and the difference is ownership — say so before
    # the REPORT ONLY line, or it reads as though nothing was retired at all.
    # crew-OWNED brokers (recorded in a sidecar carrying pid AND start time) are
