import json, os, sys
root = sys.argv[1]
TERMINAL = {"completed", "failed", "cancelled", "gone"}
live = []
try:
    names = sorted(os.listdir(root))
except (FileNotFoundError, NotADirectoryError):
    names = []
except OSError as exc:
    names = []
    live.append(f"state-root(unlistable: {exc.__class__.__name__})")
for name in names:
    jobs_dir = os.path.join(root, name, "jobs")
    # NO `continue` when jobs/ is missing: state.json below is the
    # authoritative registry and a workspace can carry a job there with no
    # per-job file (partial cleanup, or a record written before jobs/ existed).
    try:
        entries = sorted(os.listdir(jobs_dir))
    except (FileNotFoundError, NotADirectoryError):
        entries = []                      # genuinely absent — nothing to read
    except OSError as exc:
        live.append(f"{name}/jobs(unreadable: {exc.__class__.__name__})")
        entries = []
    for entry in entries:
        if not entry.endswith(".json"):
            continue
        try:
            with open(os.path.join(jobs_dir, entry)) as f:
                job = json.load(f)
        except (FileNotFoundError, NotADirectoryError):
            continue                      # vanished between listdir and open
        except (OSError, ValueError) as exc:
            live.append(f"{name}/{entry}(unreadable: {exc.__class__.__name__})")
            continue
        if not isinstance(job, dict):
            live.append(f"{name}/{entry}(not a job object)")
        elif job.get("status") not in TERMINAL:
            live.append(f"{name}/{job.get('id', entry)}({job.get('status')})")
    state_path = os.path.join(root, name, "state.json")
    try:
        with open(state_path) as f:
            data = json.load(f)
    except (FileNotFoundError, NotADirectoryError):
        continue                          # no registry here
    except (OSError, ValueError) as exc:
        live.append(f"{name}/state.json(unreadable: {exc.__class__.__name__})")
        continue
    # Only two shapes are understood: a bare list, or {"jobs": [...]}. An empty
    # object is genuinely empty. Anything else is reported, never assumed empty.
    if isinstance(data, list):
        state_entries = data
    elif isinstance(data, dict) and isinstance(data.get("jobs"), list):
        state_entries = data["jobs"]
    elif isinstance(data, dict) and not data:
        state_entries = []
    else:
        live.append(f"{name}/state.json(unrecognized schema)")
        state_entries = []
    for e in state_entries:
        if not isinstance(e, dict):
            live.append(f"{name}/state.json(non-dict entry)")
        elif e.get("status") not in TERMINAL:
            live.append(f"{name}/{e.get('id', '?')}({e.get('status')})")
print(" ".join(sorted(set(live))))
